post-extract {
    set ext ${worksrcpath}/src/external
    foreach {dir repo rev} ${submodules} {
        set src ${workpath}/[file tail ${repo}]-${rev}
        if {${dir} eq "upscale"} {
            set dest ${worksrcpath}/src/emu/drivers/resources/upscale
        } else {
            set dest ${ext}/${dir}
        }
        file delete -force ${dest}
        move ${src} ${dest}
    }
}

# Use the system libraries in place of most submodules, and let the bundled FFmpeg take the
# compiler flags (from tatsh-overlay).
patchfiles          patch-system-libs.diff

post-patch {
    # The bundled mbedcrypto target is gone, so the bare name would link the wrong library.
    reinplace -E {s/^([[:space:]]*)mbedcrypto\)$/\1mbedtls)/} ${worksrcpath}/src/emu/services/CMakeLists.txt
    # The cubeb port predates the input_params member; zero-initialising the struct gives its
    # default (CUBEB_INPUT_PROCESSING_PARAM_NONE) on newer cubeb.
    reinplace {s/^\( *\)cubeb_stream_params params;$/\1cubeb_stream_params params{};/} \
        ${worksrcpath}/src/emu/drivers/src/audio/backend/cubeb/stream_cubeb.cpp
    reinplace {/params.input_params = CUBEB_INPUT_PROCESSING_PARAM_NONE;/d} \
        ${worksrcpath}/src/emu/drivers/src/audio/backend/cubeb/stream_cubeb.cpp
    reinplace "s|/usr/include/stb|${prefix}/include/stb|" ${worksrcpath}/src/external/CMakeLists.txt
    # The bundle links the libraries in ${prefix}; do not copy them in.
    reinplace {/dolphin_postprocess_bundle(eka2l1_qt)/d} ${worksrcpath}/src/emu/qt/CMakeLists.txt
}

# The bundled Zydis (in dynarmic) has pointers in packed data, which Xcode 15's linker cannot
# express as chained fixups.
configure.ldflags-append -Wl,-no_fixup_chains

configure.args-append \
                    -DBUILD_SHARED_LIBS=OFF \
                    -DCCACHE_PROGRAM=CCACHE_PROGRAM-NOTFOUND \
                    -DEKA2L1_BUILD_TESTS=OFF \
                    -DEKA2L1_BUILD_TOOLS=OFF \
                    -DEKA2L1_ENABLE_QT_CAMERA=ON \
                    -DEKA2L1_FFMPEG_CACHE_DIR=${workpath}/ffmpeg-cache \
                    -DEKA2L1_FFMPEG_JOBS=${build.jobs} \
                    -Dfmt_DIR=${prefix}/lib/libfmt12/cmake/fmt

# The Qt front end seeds the user's data directory from these, next to the executable.
destroot {
    set bin ${build.dir}/bin
    copy ${bin}/EKA2L1.app ${destroot}${applications_dir}/EKA2L1.app
    set macos ${destroot}${applications_dir}/EKA2L1.app/Contents/MacOS
    foreach d {compat resources scripts} {
        if {[file exists ${bin}/${d}] && ![file exists ${macos}/${d}]} {
            copy ${bin}/${d} ${macos}/
        }
    }
    ln -s ${applications_dir}/EKA2L1.app/Contents/MacOS/EKA2L1 ${destroot}${prefix}/bin/eka2l1
}

livecheck.type      none
