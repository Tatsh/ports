post-extract {
    set ext ${worksrcpath}/externals
    foreach {dir repo rev} ${submodules} {
        file delete -force ${ext}/${dir}
        move ${workpath}/[file tail ${repo}]-${rev} ${ext}/${dir}
    }
    file delete -force ${ext}/soundtouch
    move ${workpath}/soundtouch ${ext}/soundtouch
}

# From tatsh-overlay: system libraries, fixes for newer Boost, Vulkan headers, Teakra and Qt.
patchfiles          patch-0001-system-libraries.diff \
                    patch-0002-inih-fix.diff \
                    patch-0003-boost-fix.diff \
                    patch-0004-boost-1.87.diff \
                    patch-0005-azahar-vulkan-1.4.304.diff \
                    patch-0006-azahar-mcl-fix.diff \
                    patch-0007-update-teakra-usage.diff \
                    patch-0008-fix-find-cryptopp.diff \
                    patch-0010-missing-cstring.diff \
                    patch-ffmpeg-7-chlayout.diff
# Always the standard macOS paths, never leftover XDG directories.
patchfiles-append   patch-macos-user-paths.diff

post-patch {
    # Everything comes from the distfiles or MacPorts: make the build's own downloads (bundled Qt
    # and MoltenVK, the compatibility list, clang-format) fail instead of reaching the network.
    reinplace {s|file(DOWNLOAD|message(FATAL_ERROR "download attempted" |} \
        ${worksrcpath}/CMakeLists.txt ${worksrcpath}/CMakeModules/DownloadExternals.cmake
    # Imported targets add -isystem ${prefix}/include, which has the headers of the default boost
    # and ffmpeg ports and a newer cpp-httplib; put this Boost, FFmpeg 7 and the bundled
    # cpp-httplib in front of it for every target.
    set fd [open ${workpath}/include-first.cmake w]
    puts ${fd} "include_directories(BEFORE SYSTEM ${prefix}/libexec/boost/${boost.version}/include\
        ${ffmpeg_prefix}/include ${worksrcpath}/externals/httplib)"
    close ${fd}
    # FFmpeg and the Vulkan loader (or MoltenVK) are opened with dlopen by bare file name, which
    # dyld looks up only in /usr/local/lib and /usr/lib; look them up through the rpaths below.
    reinplace -E {s|return fmt::format\("(\{\}\{\}[^"]*\.dylib)", prefix|return fmt::format("@rpath/\1", prefix|} \
        ${worksrcpath}/src/common/dynamic_library/dynamic_library.cpp
    # The compatibility list is read from the build tree.
    file mkdir ${build.dir}/dist/compatibility_list
    copy ${distpath}/gamedb ${build.dir}/dist/compatibility_list/compatibility_list.json
}

# The video dumper uses AVCodec fields that FFmpeg 8 removed.
set ffmpeg_prefix   ${prefix}/libexec/ffmpeg7
configure.pkg_config_path-prepend ${ffmpeg_prefix}/lib/pkgconfig
# FFmpeg 7 first: its libraries have the major versions this build asks for.
configure.ldflags-append -Wl,-rpath,${ffmpeg_prefix}/lib -Wl,-rpath,${prefix}/lib

compiler.cxx_standard 2020
configure.cflags-append -fPIC
configure.cxxflags-append -fPIC

