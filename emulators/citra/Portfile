destroot {
    set bin ${build.dir}/bin/${cmake.build_type}
    copy ${bin}/citra-qt.app ${destroot}${applications_dir}/Citra.app
    foreach b {citra citra-room} {
        if {[file exists ${bin}/${b}]} {
            xinstall -m 0755 ${bin}/${b} ${destroot}${prefix}/bin/
        }
    }
    ln -s ${applications_dir}/Citra.app/Contents/MacOS/citra-qt ${destroot}${prefix}/bin/citra-qt
}

livecheck.type      none

# citra-room, the dedicated multiplayer room server, as a launchd service under its own user.
# Its settings are in ${prefix}/etc/citra-room.conf.
set room_data       ${prefix}/var/db/citra-room

add_users           _citraroom group=_citraroom realname=Citra\ room home=${room_data}

post-destroot {
    xinstall -m 0640 -g _citraroom ${filespath}/citra-room.conf ${destroot}${prefix}/etc/citra-room.conf.sample
    xinstall -d ${destroot}${prefix}/libexec/citra
    xinstall -m 0755 ${filespath}/citra-room-service.sh ${destroot}${prefix}/libexec/citra/room-service
    reinplace "s|@PREFIX@|${prefix}|g; s|@ROOM@|citra-room|g; s|@DATADIR@|${room_data}|g" \
        ${destroot}${prefix}/libexec/citra/room-service
}

# The room's data directory is owned by the service user, so it is made at activation rather than in the
# destroot: deactivation cannot delete a registered directory owned by another user ("not
# owner"), and the data in it should outlive the port anyway.
post-activate {
    if {![file isdirectory ${room_data}]} {
        xinstall -d -m 0750 -o _citraroom -g _citraroom ${room_data}
    }
    if {![file exists ${prefix}/etc/citra-room.conf]} {
        file copy ${prefix}/etc/citra-room.conf.sample ${prefix}/etc/citra-room.conf
        file attributes ${prefix}/etc/citra-room.conf -group _citraroom -permissions 0640
    }
}

startupitem.create  yes
startupitem.name    citra-room
startupitem.user    _citraroom
startupitem.group   _citraroom
startupitem.logfile ${prefix}/var/log/citra-room.log
startupitem.executable \
                    ${prefix}/libexec/citra/room-service

notes "
To host a multiplayer room, set ROOM_NAME and PREFERRED_GAME in ${prefix}/etc/citra-room.conf\
 and load the service with: sudo port load citra. The room listens on all interfaces (citra-room has no bind option). Bans\
 made while it runs are saved only when it quits from its console, not when launchd stops it.
"
