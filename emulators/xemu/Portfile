# Build the DSP emulator's C interface, and describe it to meson with a pkg-config file, which
# takes the place of the prebuilt download.
pre-configure {
    set dsp ${workpath}/dsp56300-${dsp_version}
    system -W ${dsp} "env CARGO_HOME=${cargo.home} ${prefix}/bin/cargo build --release --offline \
        -p dsp56300-emu-ffi"
    file mkdir ${workpath}/pkgconfig
    set fd [open ${workpath}/pkgconfig/dsp56300-emu-ffi.pc w]
    puts ${fd} "Name: dsp56300-emu-ffi
Description: DSP56300 emulator C interface
Version: ${dsp_version}
Libs: ${dsp}/target/release/libdsp56300_emu_ffi.a -lpthread -lm -framework Security
Cflags: -I${dsp}/crates/emu-ffi/include"
    close ${fd}
}

configure.env-append \
                    PKG_CONFIG_PATH=${workpath}/pkgconfig
configure.pre_args  --prefix=${prefix}
configure.args      --python=${prefix}/bin/python3.13 \
                    --cc=${configure.cc} \
                    --cxx=${configure.cxx} \
                    --objcc=${configure.objc} \
                    --target-list=i386-softmmu \
                    --extra-cflags=-DXBOX=1 \
                    --extra-ldflags=-headerpad_max_install_names \
                    --disable-cocoa \
                    --disable-docs \
                    --disable-download \
                    --disable-strip \
                    --disable-werror
# The configure script is QEMU's, which rejects the options autoconf scripts take.
configure.universal_args
configure.cflags
configure.cxxflags
configure.ldflags

build.target        qemu-system-i386

destroot {
    set contents ${destroot}${applications_dir}/xemu.app/Contents
    xinstall -d ${contents}/MacOS ${contents}/Resources
    xinstall -m 0755 ${worksrcpath}/build/qemu-system-i386 ${contents}/MacOS/xemu
    xinstall -m 0644 ${worksrcpath}/Info.plist ${contents}/
    system "/usr/bin/plutil -replace CFBundleShortVersionString -string ${version} ${contents}/Info.plist"
    system "/usr/bin/plutil -replace CFBundleVersion -string ${version} ${contents}/Info.plist"
    set iconset ${workpath}/xemu.iconset
    file mkdir ${iconset}
    foreach r {16 32 128 256 512} {
        file copy ${worksrcpath}/ui/icons/xemu_${r}x${r}.png ${iconset}/icon_${r}x${r}.png
    }
    system "/usr/bin/iconutil --convert icns --output ${contents}/Resources/xemu.icns ${iconset}"
    ln -s ${applications_dir}/xemu.app/Contents/MacOS/xemu ${destroot}${prefix}/bin/xemu
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE ${destroot}${prefix}/share/doc/${name}/
}

livecheck.type      none
