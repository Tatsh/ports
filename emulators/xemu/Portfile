post-extract {
    set sp ${worksrcpath}/subprojects
    foreach {dir src} [list keycodemapdb keycodemapdb-${keycodemapdb_rev} \
            nv2a_vsh_cpu nv2a_vsh_cpu-${nv2a_vsh_cpu_rev} imgui imgui-${imgui_rev} \
            implot implot-${implot_rev} tomlplusplus tomlplusplus-${tomlplusplus_rev} \
            genconfig genconfig-${genconfig_rev} \
            berkeley-softfloat-3 berkeley-softfloat-3-${softfloat_rev} \
            berkeley-testfloat-3 berkeley-testfloat-3-${testfloat_rev}] {
        file delete -force ${sp}/${dir}
        move ${workpath}/${src} ${sp}/${dir}
    }
    # imgui would otherwise take Mesa's (X11) libGL through pkg-config when the mesa port is
    # installed; the system method gives the OpenGL framework.
    reinplace {s/dependency('gl', required:/dependency('gl', method: 'system', required:/} \
        ${sp}/imgui/meson.build
    # meson applies these overlays only to subprojects it fetches itself.
    foreach dir {berkeley-softfloat-3 berkeley-testfloat-3} {
        copy {*}[glob ${sp}/packagefiles/${dir}/*] ${sp}/${dir}/
    }
    # The version otherwise comes from git.
    foreach {f v} [list XEMU_VERSION ${version} XEMU_BRANCH master XEMU_COMMIT ""] {
        set fd [open ${worksrcpath}/${f} w]
        puts ${fd} ${v}
        close ${fd}
    }
}

