destroot {
    copy ${build.dir}/bin/Vita3K.app ${destroot}${applications_dir}/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/COPYING.txt ${destroot}${prefix}/share/doc/${name}/
}

