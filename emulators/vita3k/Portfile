set i 0
foreach {path repo rev} ${submodules} {
    incr i
    master_sites-append https://github.com/${repo}/archive/${rev}.tar.gz?dummy=:s${i}
    distfiles-append    [file tail ${repo}]-${rev}.tar.gz:s${i}
}

depends_build-append \
                    port:pkgconfig \
                    port:qt67-qttools \
                    port:stb
depends_lib-append  port:boost188 \
                    port:capstone \
                    port:cubeb \
                    path:lib/libcurl.dylib:curl \
                    port:ffmpeg7 \
                    port:libfmt12 \
                    port:nativefiledialog-extended \
                    path:lib/libssl.dylib:openssl \
                    port:pugixml \
                    port:qt67-qtbase \
                    port:qt67-qtmultimedia \
                    port:qt67-qtsvg \
                    port:SDL3 \
                    port:spdlog \
                    port:vulkan-loader \
                    port:xxhash \
                    port:yaml-cpp \
                    port:zlib
depends_run-append  port:MoltenVK

post-extract {
    foreach {path repo rev} ${submodules} {
        file delete -force ${worksrcpath}/${path}
        # GitHub names the directory after the repository's own capitalisation.
        set dir [glob -directory ${workpath} -nocomplain -types d "[file tail ${repo}]-${rev}"]
        if {${dir} eq ""} {
            set dir [lindex [glob -directory ${workpath} -types d "*-${rev}"] 0]
        }
        file rename ${dir} ${worksrcpath}/${path}
    }
}

