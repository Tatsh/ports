# Capstone through pkg-config, the MacPorts MoltenVK instead of a downloaded one, no copying of
# Qt and the libraries into the app, and Qt before 6.10 in the trophy filter.
patchfiles-append   patch-macports.diff

post-patch {
    # The Qt 6.11 minimum only follows upstream's CI; Qt 6.7 has everything else that is used.
    reinplace {s/set(VITA3K_QT_MIN_VER 6.11.0)/set(VITA3K_QT_MIN_VER 6.7.0)/} ${worksrcpath}/cmake/qt6.cmake
    # Tracy is only used outside Release builds; skip its empty-submodule check.
    reinplace {/path = external\/tracy$/d} ${worksrcpath}/.gitmodules
    # The Vulkan loader and MoltenVK in MacPorts, which dlopen does not find by bare name.
    reinplace "s|\"/usr/local/lib/libvulkan.dylib\"|\"${prefix}/lib/libvulkan.1.dylib\"|; s|dlopen( \"libMoltenVK.dylib\"|dlopen( \"${prefix}/lib/libMoltenVK.dylib\"|" \
        ${worksrcpath}/external/VulkanMemoryAllocator-Hpp/Vulkan-Headers/include/vulkan/vulkan.hpp
}

# C++23 library features (std::ranges::contains, std::ranges::to, std::atomic_ref) need libc++ 19
# headers; libc++'s availability markup keeps the code to what macOS 13's libc++ provides.
compiler.whitelist  macports-clang-20

cmake.build_type    Release
# dynarmic finds ccache by itself.
build.env-append    CCACHE_DISABLE=1
cmake.generator     Ninja
configure.pkg_config_path-append ${prefix}/libexec/ffmpeg7/lib/pkgconfig
configure.args-append \
                    -Wno-dev \
                    "-DCMAKE_PREFIX_PATH=\"${prefix}/libexec/qt6\;${prefix}/libexec/boost/1.88\;${prefix}/libexec/ffmpeg7\;${prefix}\"" \
                    -Dfmt_DIR=${prefix}/lib/libfmt12/cmake/fmt \
                    -DCCACHE_PROGRAM=CCACHE_PROGRAM-NOTFOUND \
                    -DUSE_LTO=NEVER \
                    -DBUILD_SHARED_LIBS=OFF \
                    -DUSE_DISCORD_RICH_PRESENCE=OFF \
                    -DUSE_VITA3K_UPDATE=OFF \
                    -DVITA3K_FORCE_SYSTEM_BOOST=ON \
                    -DVITA3K_SKIP_MACDEPLOYQT=ON \
                    -DUSE_SYSTEM_CAPSTONE=ON \
                    -DUSE_SYSTEM_CUBEB=ON \
                    -DUSE_SYSTEM_FFMPEG=ON \
                    -DUSE_SYSTEM_FMT=ON \
                    -DUSE_SYSTEM_MOLTENVK=ON \
                    -DUSE_SYSTEM_NFDE=ON \
