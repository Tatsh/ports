# The I/O handlers use REG8 where the IOOUT/IOINP typedefs say UINT (ABI-compatible); clang
# makes the mismatch an error (from tatsh-overlay, where GCC 14 does).
configure.cflags-append -Wno-incompatible-pointer-types -Wno-incompatible-function-pointer-types

libretro.build_dir  ${worksrcpath}/sdl
