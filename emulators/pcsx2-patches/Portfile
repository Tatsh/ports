# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

# Upstream only publishes a constantly replaced "latest" patches.zip, so this packages a snapshot.
github.setup        PCSX2 pcsx2_patches b919d7fb5849feeb30b2da07d02f6dc662f28ba5
github.tarball_from archive
name                pcsx2-patches
version             20261109
revision            0
categories          emulators games
platforms           any
supported_archs     noarch
# Normally distributed with PCSX2, which is GPL-3+.
license             GPL-3+
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Game patches for PCSX2, such as widescreen and no-interlacing hacks.
long_description    The PCSX2 game patch collection (patches.zip), shared by the pcsx2, \
                    pcsx2-reliquary and pcsx2x6 ports. PCSX2 reads it from its resources \
                    folder, and each app bundle links to the copy installed here.
homepage            https://github.com/PCSX2/pcsx2_patches

checksums           rmd160  557423560b32584c9cd50446f8349b54ad206bcb \
                    sha256  a8eea448a62878c3ac86e8846117265bd6c29f759b4792cc45df0f4503d68c83 \
                    size    848659

use_configure       no

# PCSX2 expects the .pnach files at the top level of the archive.
build {
    system -W ${worksrcpath}/patches "/usr/bin/zip -q -9 -X ../patches.zip *.pnach"
}

destroot {
    xinstall -d ${destroot}${prefix}/share/pcsx2
    xinstall -m 0644 ${worksrcpath}/patches.zip ${destroot}${prefix}/share/pcsx2/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}

livecheck.type      none
