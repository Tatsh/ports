PortSystem          1.0
PortGroup           github 1.0

github.setup        DerKoun bsnes-hd f46b6d6368ea93943a30b5d4e79e8ed51c2da5e8
github.tarball_from archive
version             10.6
revision            1
categories          emulators games aqua
platforms           darwin
license             GPL-3
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Fork of the bsnes Super Nintendo emulator that adds HD video features.
long_description    ${description} Adds HD Mode 7, widescreen and true colour rendering.
dist_subdir         ${name}/${version}

checksums           rmd160  058398445b6c7b95ceba46f3e4d1ed4258e2abef \
                    sha256  d46ee8fdf68d971536ee3edc6f48917a83dc9c919583e58ec0abe78724401e8f \
                    size    6993461

compiler.cxx_standard 2017
use_configure       no

# The macOS target builds an app bundle with the Cocoa toolkit and native audio and video drivers.
build.dir           ${worksrcpath}/bsnes
build.target
build.args          platform=macos \
                    compiler=${configure.cxx} \
                    local=false

destroot {
    set app ${destroot}${applications_dir}/bsnes-hd.app
    copy ${build.dir}/out/bsnes.app ${app}
    # The bundle ships with plain bsnes's name and identifier. Give it its own so it does not clash
    # with bsnes.
    set plist ${app}/Contents/Info.plist
    set pb /usr/libexec/PlistBuddy
    system "${pb} -c 'Set :CFBundleIdentifier io.github.derkoun.bsnes-hd' -c 'Set :CFBundleDisplayName bsnes-hd' ${plist}"
    system "${pb} -c 'Add :CFBundleName string bsnes-hd' -c 'Add :CFBundlePackageType string APPL' -c 'Add :CFBundleShortVersionString string ${version}' -c 'Add :CFBundleVersion string ${version}' ${plist}"
}
