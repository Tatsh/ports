# Packages that MacPorts does not have (or, for QuaZip, has only for Qt 5), unpacked where
# CPMUtil's <name>_CUSTOM_DIR points. The rest come from MacPorts.
set bundled [list \
    xbyak       herumi/xbyak                v7.40.1 \
    enet        lsalzman/enet               v1.3.18 \
    SimpleIni   brofield/simpleini          v4.25 \
    sirit       eden-emulator/sirit         v1.0.5 \
    gamemode    FeralInteractive/gamemode   ce6fe122f3864cb29d9a6a2ec68b6d78239074b1 \
    QuaZip-Qt6  stachenov/quazip            2e95c9001bf1ad0177c54923029ed8f4c53b70e0 \
    reshade     crosire/reshade             v6.8.0 \
    zbic        kinnay/zbic                 11b08f2712264bbed731545085cbd9702096ceb7 \
    zstd        facebook/zstd               33618c89e511637f8a6ef955b3501766d71feb53]
set i 0
foreach {pkg repo rev} ${bundled} {
    master_sites-append https://github.com/${repo}/archive/${rev}.tar.gz?dummy=:b${i}
    distfiles-append    [file tail ${repo}]-${rev}.tar.gz:b${i}
    incr i
}
