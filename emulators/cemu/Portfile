wxWidgets.use       wxWidgets-3.2

depends_build-append port:glm \
                    port:pkgconfig \
                    port:rapidjson \
                    port:vulkan-headers

# Boost 1.76 does not mark its container iterators contiguous, so its small_vector cannot be
# viewed as a std::span. The default Boost's headers in ${prefix}/include come first among the
# system include directories, and an -I naming one of those is dropped, so the newer headers are
# reached through a directory of their own.
boost.version       1.87
configure.cppflags-prepend -I${workpath}/boost-include

post-extract {
    file mkdir ${workpath}/boost-include
    ln -s ${prefix}/libexec/boost/${boost.version}/include/boost ${workpath}/boost-include/boost
}

depends_lib-append  port:cubeb \
                    path:lib/libcurl.dylib:curl \
                    port:hidapi \
                    port:libfmt12 \
                    port:libsdl2 \
                    port:libzip \
                    path:lib/libssl.dylib:openssl \
                    port:MoltenVK \
                    port:pugixml \
                    port:${wxWidgets.port} \
                    port:zarchive \
                    port:zstd \
                    port:zlib

# Build against wxWidgets 3.2.
patchfiles          patch-wxwidgets-3.2-compat.diff

post-extract {
    file rename ${workpath}/glslang-${glslang_commit} ${worksrcpath}/glslang
    file delete -force ${worksrcpath}/dependencies/imgui
    file rename ${workpath}/imgui-${imgui_version} ${worksrcpath}/dependencies/imgui
    file delete -force ${worksrcpath}/dependencies/metal-cpp
    file rename ${workpath}/metal-cpp-${metalcpp_commit} ${worksrcpath}/dependencies/metal-cpp
}

post-patch {
    reinplace -E {s/find_package\(glslang.*/add_subdirectory(glslang)/} ${worksrcpath}/CMakeLists.txt
}

compiler.cxx_standard 2020

# Cemu hashes std::filesystem::path, which needs libc++ 17 or newer.
configure.cxxflags-append -include ${filespath}/fs-path-hash.h

# Link Apple's OpenGL framework rather than Mesa's libGL (a GLX implementation for X11).
configure.pre_args-replace -DCMAKE_FIND_FRAMEWORK=LAST -DCMAKE_FIND_FRAMEWORK=FIRST

configure.args-append \
                    -DBUILD_SHARED_LIBS=OFF \
                    -DENABLE_CUBEB=ON \
                    -DENABLE_DISCORD_RPC=OFF \
                    -DENABLE_OPENGL=ON \
                    -DENABLE_SDL=ON \
                    -DENABLE_VCPKG=OFF \
                    -DENABLE_VULKAN=ON \
                    -DENABLE_WXWIDGETS=ON \
                    -DwxWidgets_CONFIG_EXECUTABLE=${wxWidgets.wxconfig} \
                    -DALLOW_EXTERNAL_SPIRV_TOOLS=ON \
                    -Dfmt_DIR=${prefix}/lib/libfmt12/cmake/fmt

# Upstream's bundle step copies MoltenVK from Homebrew's or /usr/local's lib directory, so the
# bundle is put together here instead. Cemu reads its resources and game profiles from the bundle's
# SharedSupport directory.
destroot {
    set contents ${destroot}${applications_dir}/Cemu.app/Contents
    xinstall -d ${contents}/MacOS ${contents}/Resources ${contents}/SharedSupport
    xinstall -m 0755 ${worksrcpath}/bin/Cemu_macports ${contents}/MacOS/Cemu
    # The executable links @rpath/libMoltenVK.dylib, and its run paths name only Homebrew's and
    # /usr/local's library directories.
    system "install_name_tool -add_rpath ${prefix}/lib ${contents}/MacOS/Cemu"
    copy ${worksrcpath}/bin/gameProfiles ${worksrcpath}/bin/resources ${contents}/SharedSupport/
    xinstall -m 0644 ${worksrcpath}/src/resource/cemu.icns ${contents}/Resources/
    set fd [open ${worksrcpath}/src/resource/MacOSXBundleInfo.plist.in r]
    set plist [read ${fd}]
    close ${fd}
    set plist [string map [list \
        \${MACOSX_BUNDLE_BUNDLE_NAME} Cemu \
        \${MACOSX_BUNDLE_BUNDLE_VERSION} ${version} \
        \${MACOSX_BUNDLE_CATEGORY} public.app-category.games \
        \${MACOSX_BUNDLE_COPYRIGHT} "Copyright © Cemu Project" \
        \${MACOSX_BUNDLE_EXECUTABLE_NAME} Cemu \
        \${MACOSX_BUNDLE_GUI_IDENTIFIER} info.cemu.Cemu \
        \${MACOSX_BUNDLE_ICON_FILE} cemu.icns \
        \${MACOSX_BUNDLE_SHORT_VERSION_STRING} ${version} \
        \${MACOSX_BUNDLE_TYPE_EXTENSION} wua \
        \${MACOSX_MINIMUM_SYSTEM_VERSION} ${macosx_deployment_target}] ${plist}]
    set fd [open ${contents}/Info.plist w]
    puts -nonewline ${fd} ${plist}
    close ${fd}
    xinstall -d ${destroot}${prefix}/bin
    ln -s ${applications_dir}/Cemu.app/Contents/MacOS/Cemu ${destroot}${prefix}/bin/cemu
}
