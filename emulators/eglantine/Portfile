patchfiles          patch-rename-binaries.diff \
                    patch-vulkan-library-prefix.diff
# The standard macOS directories (Application Support and Caches) instead of the XDG ones.
patchfiles-append   patch-macos-user-paths.diff

post-patch {
    reinplace "s|@PREFIX@|${prefix}|g" ${worksrcpath}/src/video_core/vulkan_common/vulkan_library.cpp
    # MoltenVK is loaded from ${prefix}/lib (see patch-vulkan-library-prefix.diff), not copied in.
    reinplace {/target_sources(yuzu PRIVATE ${MOLTENVK_LIBRARY})/d} \
        ${worksrcpath}/src/yuzu/CMakeLists.txt
    # CPMUtil applies its own patches only to packages it downloads itself.
    foreach p [glob ${worksrcpath}/.patch/reshade/*.patch] {
        system -W ${workpath}/reshade-6.8.0 "patch -p1 < [shellescape ${p}]"
    }
    # Read by GetSCMRev in place of git.
    foreach {f v} [list GIT-TAG v${version} GIT-RELEASE v${version} GIT-COMMIT ${git_commit} \
                       GIT-REFSPEC nx2] {
        set fd [open ${worksrcpath}/${f} w]
        puts ${fd} ${v}
        close ${fd}
    }
    # Everything comes from the distfiles or MacPorts: make any download fail instead of reaching
    # the network.
    foreach f [list ${worksrcpath}/CMakeModules/CPMUtil.cmake ${worksrcpath}/CMakeModules/CPM.cmake] {
        reinplace -q {s|file(DOWNLOAD|message(FATAL_ERROR "download attempted" |} ${f}
    }
    # Imported targets add -isystem ${prefix}/include, which has the headers of the default boost
    # port; put this Boost in front of it for every target.
    set fd [open ${workpath}/include-first.cmake w]
    puts ${fd} "include_directories(BEFORE SYSTEM ${prefix}/libexec/boost/${boost.version}/include)"
    close ${fd}
}

compiler.cxx_standard 2020
# dynarmic's decoder (and more of Eden) emplaces aggregates, which needs C++20 parenthesized
# aggregate initialisation: clang 16 or later. Clang 16's libc++ headers are the same version as
# the system libc++ it links, which newer MacPorts clangs' are not.
compiler.whitelist  macports-clang-16
# -I${prefix}/include (and CPATH, which acts like -I) would be searched before every -isystem
# directory, so the default boost headers there would win over the one above.
configure.cppflags-delete -I${prefix}/include
compiler.cpath

# The libc++ this builds against has no std::jthread, std::stop_token or the stop_token overloads
# of std::condition_variable_any (which Eden uses throughout), std::array's operator<=> or
# std::atomic_ref; force-include a polyfill for them (the jthread part from yuzu's) into every C++
# file, and give <stop_token> a header.
configure.cxxflags-append -include ${filespath}/libcxx-polyfill.h -isystem ${workpath}/polyfill-include
configure.objcxxflags-append -include ${filespath}/libcxx-polyfill.h -isystem ${workpath}/polyfill-include
# Clang 16's libc++ headers mark std::format (and <chrono>'s formatters) unavailable for this
# deployment target, though the system libc++ (16) on macOS 13.6 has everything they need.
configure.cxxflags-append -D_LIBCPP_DISABLE_AVAILABILITY
configure.objcxxflags-append -D_LIBCPP_DISABLE_AVAILABILITY
post-extract {
    file mkdir ${workpath}/polyfill-include
    copy ${filespath}/stop_token ${workpath}/polyfill-include/stop_token
}

# The bundled Zydis (in dynarmic) has pointers in packed data, which Xcode 15's linker cannot
# express as chained fixups.
configure.ldflags-append -Wl,-no_fixup_chains

# glslang writes the SPIR-V headers into this directory, which only another (parallel) generator
# step creates.
pre-build {
    file mkdir ${build.dir}/src/video_core/host_shaders/include/video_core/host_shaders
}

configure.args-append \
                    -DBUILD_TESTING=OFF \
                    -DCMAKE_PROJECT_INCLUDE=${workpath}/include-first.cmake \
                    -DCPMUTIL_FORCE_SYSTEM=ON \
                    -DDYNARMIC_USE_LLVM=OFF \
                    -DENABLE_CUBEB=ON \
                    -DENABLE_LIBUSB=ON \
                    -DENABLE_QT=ON \
                    -DENABLE_UPDATE_CHECKER=OFF \
                    -DENABLE_WEB_SERVICE=OFF \
                    -DENABLE_WERROR=OFF \
                    -DUSE_DISCORD_PRESENCE=OFF \
                    -DYUZU_CMD=ON \
                    -DYUZU_DISABLE_LLVM=ON \
                    -DYUZU_ROOM=ON \
                    -DYUZU_TESTS=OFF \
                    -DYUZU_TZDB_PATH=${workpath}/nx-tzdb-${tzdb_ver} \
                    -DYUZU_USE_BUNDLED_MOLTENVK=OFF \
                    -DYUZU_USE_QT_MULTIMEDIA=OFF \
                    -DYUZU_USE_QT_WEB_ENGINE=OFF \
                    -Dfmt_DIR=${prefix}/lib/libfmt12/cmake/fmt \
                    -Wno-dev
foreach {pkg repo rev} ${bundled} {
    set dir [file tail ${repo}]-[string trimleft ${rev} v]
    configure.args-append -D${pkg}_FORCE_BUNDLED=ON -D${pkg}_CUSTOM_DIR=${workpath}/${dir}
}

destroot {
    set bin ${build.dir}/bin/${cmake.build_type}
    if {![file exists ${bin}]} {
        set bin ${build.dir}/bin
    }
    copy ${bin}/eglantine.app ${destroot}${applications_dir}/Eglantine.app
    foreach b {eglantine-cli eglantine-room} {
        if {[file exists ${bin}/${b}]} {
            xinstall -m 0755 ${bin}/${b} ${destroot}${prefix}/bin/
        }
    }
    ln -s ${applications_dir}/Eglantine.app/Contents/MacOS/eglantine ${destroot}${prefix}/bin/eglantine
}

github.livecheck.regex {([0-9.]+(?:-rc[0-9]+)?)}

# eglantine-room, the dedicated multiplayer room server, as a launchd service under its own user.
# Its settings are in ${prefix}/etc/eglantine-room.conf.
set room_data       ${prefix}/var/db/eglantine-room

add_users           _eglantineroom group=_eglantineroom realname=Eglantine\ room home=${room_data}

post-destroot {
    xinstall -m 0640 -g _eglantineroom ${filespath}/eglantine-room.conf ${destroot}${prefix}/etc/eglantine-room.conf.sample
    xinstall -d ${destroot}${prefix}/libexec/eglantine
    xinstall -m 0755 ${filespath}/eglantine-room-service.sh ${destroot}${prefix}/libexec/eglantine/room-service
    reinplace "s|@PREFIX@|${prefix}|g; s|@ROOM@|eglantine-room|g; s|@DATADIR@|${room_data}|g" \
        ${destroot}${prefix}/libexec/eglantine/room-service
}

# The room's data directory is owned by its user, so it is made here rather than in the destroot:
# deactivation cannot delete a registered directory owned by another user ("not owner"), and the
# ban list in it should outlive the port anyway.
post-activate {
    if {![file isdirectory ${room_data}]} {
        xinstall -d -m 0750 -o _eglantineroom -g _eglantineroom ${room_data}
    }
    if {![file exists ${prefix}/etc/eglantine-room.conf]} {
        file copy ${prefix}/etc/eglantine-room.conf.sample ${prefix}/etc/eglantine-room.conf
        file attributes ${prefix}/etc/eglantine-room.conf -group _eglantineroom -permissions 0640
    }
}

startupitem.create  yes
startupitem.name    eglantine-room
startupitem.user    _eglantineroom
startupitem.group   _eglantineroom
startupitem.logfile ${prefix}/var/log/eglantine-room.log
startupitem.executable \
                    ${prefix}/libexec/eglantine/room-service

notes "
To host a multiplayer room, set ROOM_NAME and PREFERRED_GAME in ${prefix}/etc/eglantine-room.conf\
 and load the service with: sudo port load eglantine. The room listens on 127.0.0.1 unless BIND_ADDRESS is changed. Bans\
 made while it runs are saved only when it quits from its console, not when launchd stops it.
"
