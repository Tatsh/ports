 // Make the process own the guest ranges before any runtime initialization.
+#if defined(KYTY_GROW_GUEST_SEGMENTS)
+// One-page placeholders; kyty_macho_grow_segments sets the real sizes after linking.
+asm(".zerofill SYSTEM_MANAGED,SYSTEM_MANAGED,__kyty_system_managed,0x4000");
+asm(".zerofill SYSTEM_RESERVED,SYSTEM_RESERVED,__kyty_system_reserved,0x4000");
+asm(".zerofill USER_AREA,USER_AREA,__kyty_user_area,0x4000");
+#else
 asm(".zerofill SYSTEM_MANAGED,SYSTEM_MANAGED,__kyty_system_managed,0x7fffbc000");
 asm(".zerofill SYSTEM_RESERVED,SYSTEM_RESERVED,__kyty_system_reserved,0x7c0004000");
 asm(".zerofill USER_AREA,USER_AREA,__kyty_user_area,0x8c00000000");
+#endif
 
 #endif
diff --git src/tools/machoGrowSegments.cpp src/tools/machoGrowSegments.cpp
new file mode 100644
index 0000000..9768b9f
--- /dev/null
+++ src/tools/machoGrowSegments.cpp
@@ -0,0 +1,76 @@
+// Sets the size of zero-fill segments in a linked x86_64 Mach-O executable.
+//
+// Usage: kyty_macho_grow_segments FILE SEGMENT SIZE [SEGMENT SIZE]...
+//
+// The linker is given one-page placeholders for the guest address space segments: ld64 before
+// version 954 has no -no_huge, and its huge pass moves zero-fill sections above 2 GB into
+// __DATA,__huge, away from their fixed addresses. Zero-fill segments take no file space, so
+// growing them afterwards only changes their load commands.
+
+#include <mach-o/loader.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <vector>
+
+int main(int argc, char* argv[]) {
+	if (argc < 4 || (argc - 2) % 2 != 0) {
+		std::fprintf(stderr, "usage: %s FILE SEGMENT SIZE [SEGMENT SIZE]...\n", argv[0]);
+		return 2;
+	}
+	std::vector<char> data;
+	{
+		std::ifstream in(argv[1], std::ios::binary);
+		data.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+	}
+	if (data.size() < sizeof(mach_header_64)) {
+		std::fprintf(stderr, "%s: too small\n", argv[1]);
+		return 1;
+	}
+	mach_header_64 header {};
+	std::memcpy(&header, data.data(), sizeof(header));
+	if (header.magic != MH_MAGIC_64) {
+		std::fprintf(stderr, "%s: not a thin 64-bit Mach-O file\n", argv[1]);
+		return 1;
+	}
+	int    remaining = (argc - 2) / 2;
+	size_t offset    = sizeof(mach_header_64);
+	for (uint32_t i = 0; i < header.ncmds && offset + sizeof(load_command) <= data.size(); i++) {
+		load_command lc {};
+		std::memcpy(&lc, data.data() + offset, sizeof(lc));
+		if (lc.cmd == LC_SEGMENT_64) {
+			segment_command_64 seg {};
+			std::memcpy(&seg, data.data() + offset, sizeof(seg));
+			for (int arg = 2; arg + 1 < argc; arg += 2) {
+				if (std::strncmp(seg.segname, argv[arg], sizeof(seg.segname)) != 0) {
+					continue;
+				}
+				if (seg.filesize != 0 || seg.nsects != 1) {
+					std::fprintf(stderr, "%s: segment %s is not a single zero-fill section\n", argv[1],
+					             argv[arg]);
+					return 1;
+				}
+				const uint64_t size = std::strtoull(argv[arg + 1], nullptr, 0);
+				seg.vmsize          = size;
+				std::memcpy(data.data() + offset, &seg, sizeof(seg));
+				section_64 sect {};
+				std::memcpy(&sect, data.data() + offset + sizeof(seg), sizeof(sect));
+				sect.size = size;
+				std::memcpy(data.data() + offset + sizeof(seg), &sect, sizeof(sect));
+				remaining--;
+			}
+		}
+		offset += lc.cmdsize;
+	}
+	if (remaining != 0) {
+		std::fprintf(stderr, "%s: not all segments were found\n", argv[1]);
+		return 1;
+	}
+	std::ofstream out(argv[1], std::ios::binary | std::ios::trunc);
+	out.write(data.data(), static_cast<std::streamsize>(data.size()));
+	return out ? 0 : 1;
+}
