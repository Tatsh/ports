@@ -0,0 +1,27 @@
+#ifndef KYTY_COMMON_USER_DATA_DIR_H_
+#define KYTY_COMMON_USER_DATA_DIR_H_
+
+#include <cstdlib>
+#include <filesystem>
+#include <system_error>
+
+namespace Common {
+
+// Settings, saves, patches and logs are written relative to the working
+// directory. An installed application bundle is read-only, so work from
+// ~/Library/Application Support/KytyPS5 instead.
+inline bool EnterUserDataDirectory() {
+	const char* home = std::getenv("HOME");
+	if (home == nullptr || *home == '\0') {
+		return false;
+	}
+	const auto      dir = std::filesystem::path(home) / "Library" / "Application Support" / "KytyPS5";
+	std::error_code ec;
+	std::filesystem::create_directories(dir, ec);
+	std::filesystem::current_path(dir, ec);
+	return !ec;
+}
+
+} // namespace Common
+
+#endif /* KYTY_COMMON_USER_DATA_DIR_H_ */
