post-extract {
    foreach {path repo rev} ${bundled} {
        file delete -force ${worksrcpath}/3rdparty/${path}
        set dir [lindex [glob -directory ${workpath} -types d "*-${rev}"] 0]
        file rename ${dir} ${worksrcpath}/3rdparty/${path}
    }
    xinstall -d ${worksrcpath}/3rdparty/noto-sans
    foreach f ${noto_fonts} {
        copy ${distpath}/${f} ${worksrcpath}/3rdparty/noto-sans/
    }
    copy ${distpath}/noto-sans-LICENSE ${worksrcpath}/3rdparty/noto-sans/LICENSE
}

# Libraries from MacPorts instead of fetched or submodule copies (after tatsh-overlay).
patchfiles          patch-system-libs.diff
# The working directory in ~/Library/Application Support/KytyPS5, MoltenVK from ${prefix}/lib, no
# macdeployqt or updater in the app bundle, an app icon, and Qt 6.7 in find_package().
patchfiles-append   patch-macports.diff
# Qt 6.7: QStyleHints::setColorScheme() is from Qt 6.8.
patchfiles-append   patch-qt67.diff
# Xcode 15 and macOS 13: ld64 951 has no -no_huge, so the guest address space segments are linked
# as placeholders and grown afterwards; no quick_exit() in the macOS 13 SDK; nlohmann::json cannot
# parse std::byte ranges with libc++ 19.
patchfiles-append   patch-xcode15.diff

post-patch {
    # KytyPS5's reader hardening patch for ZArchive, whose sources are CRLF.
    reinplace -E {s/\r$//} ${worksrcpath}/3rdparty/ZArchive/src/zarchivereader.cpp \
        ${worksrcpath}/3rdparty/ZArchive/include/zarchive/zarchivecommon.h
    system -W ${worksrcpath}/3rdparty/ZArchive \
        "patch -p1 < ${worksrcpath}/3rdparty/patches/zarchive-reader.patch"
    reinplace "s|@PREFIX@|${prefix}|g" \
        ${worksrcpath}/src/graphics/presentation/window/window.cpp \
        ${worksrcpath}/src/launcher/src/configurationEditDialog.cpp
    reinplace -E "s|set\\(KYTY_GIT_VERSION \"unknown\"\\)|set(KYTY_GIT_VERSION \"${tag}\")|" \
        ${worksrcpath}/src/generate_version.cmake
    reinplace -E "s|set\\(KYTY_GIT_HASH \"unknown\"\\)|set(KYTY_GIT_HASH \"dfec14a\")|" \
        ${worksrcpath}/src/generate_version.cmake
}

# C++20 with newer library features than Xcode 15's libc++; libc++'s availability markup keeps the
# code to what macOS 13's libc++ provides.
compiler.whitelist  macports-clang-20

cmake.build_type    Release
cmake.generator     Ninja
configure.pkg_config_path-append ${prefix}/libexec/ffmpeg8/lib/pkgconfig
configure.args-append \
                    -Wno-dev \
                    -DCMAKE_C_COMPILER_LAUNCHER= \
                    -DCMAKE_CXX_COMPILER_LAUNCHER= \
                    -DBUILD_TESTING=OFF \
                    -Dfmt_DIR=${prefix}/lib/libfmt12/cmake/fmt

post-destroot {
    set app ${destroot}${applications_dir}/KytyPS5.app
    xinstall -d ${destroot}${applications_dir}
    move ${destroot}${prefix}/KytyPS5.app ${app}
    set iconset ${workpath}/KytyPS5.iconset
    set svg ${worksrcpath}/src/launcher/icons/kyty.svg
    file mkdir ${iconset}
    foreach s {16 32 128 256 512} {
        set d [expr {${s} * 2}]
        system "rsvg-convert -w ${s} -h ${s} ${svg} -o ${iconset}/icon_${s}x${s}.png"
        system "rsvg-convert -w ${d} -h ${d} ${svg} -o ${iconset}/icon_${s}x${s}@2x.png"
    }
    system "iconutil -c icns ${iconset} -o ${app}/Contents/Resources/KytyPS5.icns"
    # The emulator needs the JIT entitlements again after installation changed the binary.
    system "codesign -s - --force --options runtime\
        --entitlements ${worksrcpath}/src/macos_jit.entitlements\
        ${app}/Contents/MacOS/kyty_emulator"
    system "codesign -s - --force ${app}"
    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    move ${destroot}${prefix}/licenses ${docdir}/licenses
    xinstall -d ${docdir}/licenses/noto-sans
    xinstall -m 0644 ${worksrcpath}/3rdparty/noto-sans/LICENSE ${docdir}/licenses/noto-sans/
    xinstall -m 0644 -W ${worksrcpath} README.md LICENSE ${docdir}
    foreach f {kyty_emulator assets} {
        delete ${destroot}${prefix}/${f}
    }
}

livecheck.type      none
