set tag             KytyPS5-2026-11-02-dfec14a
github.setup        KytyPS5 KytyPS5 ${tag}
github.tarball_from archive
name                kytyps5
version             20261102
revision            0
categories          emulators games
license             GPL-2 MIT MIT-0 BSD OFL-1.1
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         PlayStation 5 translation layer based on Kyty.
long_description    KytyPS5 runs PlayStation 5 games by translating the system calls of their \
                    x86-64 code, with a Vulkan renderer (through MoltenVK on macOS). macOS support \
                    is experimental. This installs KytyPS5.app, a Qt launcher with the emulator \
                    as a helper executable.
homepage            https://kytyps5.github.io
# The guest code is x86-64 and runs natively; it is built for x86-64-v3 (AVX2).
supported_archs     x86_64
platforms           {darwin >= 22}

distname            ${github.project}-${tag}

# Bundled sources as directory under 3rdparty, owner/repo and commit; MacPorts has none of these
# (or, for imgui, LibAtrac9 and ZArchive, upstream needs a particular revision or fork).
set bundled {
    imgui           ocornut/imgui                   f1cc2ae15e53a861a874c3034aae6798fde194ab
    LibAtrac9       shadps4-emu/ext-LibAtrac9       ec8899dadf393f655f2871a94e0fe4b3d6220c9a
    ZArchive        Exzap/ZArchive                  d2c717730092c7bf8cbb033b12fd4001b7c4d932
    tracy           wolfpld/tracy                   30997d5ca6bb632cc10807a1da8a6d3de0aeeb3c
    xbyak           herumi/xbyak                    44a72f369268f7d552650891b296693e91db86bb
    zydis           zyantific/zydis                 120e0e705f8e3b507dc49377ac2879979f0d545c
    zydis/dependencies/zycore zyantific/zycore-c    38d4f0285e6157ee840ea82a9b90aba71c8a705d
    openxr          KhronosGroup/OpenXR-SDK         f2448a8797c85814aa892efc1ab8707900fbcc78
}
set i 0
foreach {path repo rev} ${bundled} {
    incr i
    master_sites-append https://github.com/${repo}/archive/${rev}.tar.gz?dummy=:s${i}
    distfiles-append    [file tail ${repo}]-${rev}.tar.gz:s${i}
}
# Noto Sans, libFont's fallback font, which upstream downloads at configure time.
set noto_commit     42af67ccd12bc0e31ed85384bf73e39248265374
set noto_base       https://raw.githubusercontent.com/notofonts/notofonts.github.io/${noto_commit}
append noto_base     /fonts
set noto_fonts      {NotoSans-Regular.ttf NotoSans-Bold.ttf NotoSans-Italic.ttf
                     NotoSans-BoldItalic.ttf}
master_sites-append ${noto_base}/NotoSans/hinted/ttf:noto \
                    ${noto_base}/LICENSE?dummy=:notolicense
foreach f ${noto_fonts} {
    distfiles-append ${f}:noto
}
distfiles-append    noto-sans-LICENSE:notolicense
extract.only
foreach d ${distfiles} {
    set d [lindex [split ${d} :] 0]
    if {[string match *.tar.gz ${d}]} {
        extract.only-append ${d}
    }
}

