name                yuzu
# The last mainline release. The yuzu-emu/yuzu-mainline repository is gone; the tag tarball
# survives in the Wayback Machine.
set tag             mainline-0-1734
version             0.1734
categories          emulators games
license             GPL-2+ GPL-3+ LGPL-2.1+ BSD MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Nintendo Switch emulator.
long_description    yuzu is an emulator for the Nintendo Switch. This is its last mainline \
                    release. On macOS it renders through MoltenVK.
homepage            https://web.archive.org/web/20240304190805/https://yuzu-emu.org/
dist_subdir         ${name}/${version}

# The Wayback Machine keys captures on the whole URL, so the tag is the distfile name.
master_sites        https://web.archive.org/web/20240304181657if_/https://codeload.github.com/yuzu-emu/yuzu-mainline/tar.gz/refs/tags/:main
distfiles           ${tag}:main
worksrcdir          ${name}-mainline-${tag}

boost.version       1.88

# Submodules the MacPorts libraries do not replace: {directory under externals} repository commit.
set submodules [list \
    dynarmic    yuzu-mirror/dynarmic    a41c380246d3d9f9874f0f792d234dc0cc17c180 \
    enet        lsalzman/enet           2662c0de09e36f2a2030ccc2c528a3e4c9e8138a \
    mbedtls     yuzu-mirror/mbedtls     8c88150ca139e06aa2aae8349df8292a88148ea1 \
    simpleini   brofield/simpleini      382ddbb4b92c0b26aa1b32cefba2002119a5b1f2 \
    sirit       yuzu-mirror/sirit       ab75463999f4f3291976b079d42d52ee91eebf3f \
    xbyak       herumi/xbyak            a1ac3750f9a639b5a6c6d6c7da4259b8d6790989]
set i 0
foreach {dir repo rev} ${submodules} {
    master_sites-append https://github.com/${repo}/archive/${rev}.tar.gz?dummy=:s${i}
    distfiles-append    [file tail ${repo}]-${rev}.tar.gz:s${i}
    incr i
}
