post-extract {
    set ext ${worksrcpath}/externals
    foreach {dir repo rev} ${submodules} {
        file delete -force ${ext}/${dir}
        move ${workpath}/[file tail ${repo}]-${rev} ${ext}/${dir}
    }
    file mkdir ${workpath}/nx_tzdb
    system -W ${workpath}/nx_tzdb "/usr/bin/unzip -q [shellescape ${distpath}/${tzdb_ver}.zip]"
}

# From tatsh-overlay: system libraries, fixes for newer Boost, fmt, Qt and compilers.
patchfiles          patch-0001-system-libs.diff \
                    patch-0002-boost-fix.diff \
                    patch-0003-fmt-10-fixes.diff \
                    patch-0004-header-fixes.diff \
                    patch-0005-boost-1.87.diff \
                    patch-0006-boost-1.88.diff \
                    patch-0006-fix-use-of-nullptr-with-std.diff \
                    patch-0007-fix-for-qt-6.10-qpa-change.diff \
                    patch-0008-gcc-16-const-member-init.diff \
                    patch-0009-missing-cstring.diff \
                    patch-vulkan-library-prefix.diff
patch.pre_args-replace -p0 -p1

# The video and audio code uses AVCodec fields that FFmpeg 8 removed.
set ffmpeg_prefix   ${prefix}/libexec/ffmpeg7
configure.pkg_config_path-prepend ${ffmpeg_prefix}/lib/pkgconfig
configure.ldflags-append -Wl,-rpath,${ffmpeg_prefix}/lib
# FindFFmpeg runs find_library before pkg-config, which would pick the default ffmpeg port's
# libraries from ${prefix}/lib; name FFmpeg 7's for every component.
foreach c {avcodec avdevice avfilter avformat avutil swresample swscale} {
    configure.args-append -DFFmpeg_INCLUDE_${c}=${ffmpeg_prefix}/include \
                          -DFFmpeg_LIBRARY_${c}=${ffmpeg_prefix}/lib/lib${c}.dylib
}
# The bundled Zydis (in dynarmic) has pointers in packed data, which Xcode 15's linker cannot
# express as chained fixups.
configure.ldflags-append -Wl,-no_fixup_chains

post-patch {
    reinplace "s|@PREFIX@|${prefix}|g" ${worksrcpath}/src/video_core/vulkan_common/vulkan_library.cpp
    # Everything comes from the distfiles or MacPorts: make the build's own downloads (bundled
    # MoltenVK, time zone data, compatibility list) fail instead of reaching the network.
    reinplace {s|file(DOWNLOAD|message(FATAL_ERROR "download attempted" |} \
        ${worksrcpath}/CMakeLists.txt ${worksrcpath}/CMakeModules/DownloadExternals.cmake \
        ${worksrcpath}/externals/nx_tzdb/CMakeLists.txt
    # MoltenVK is loaded from ${prefix}/lib (see patch-vulkan-library-prefix.diff), not copied in.
    reinplace {/target_sources(yuzu PRIVATE ${MOLTENVK_LIBRARY})/d} ${worksrcpath}/src/yuzu/CMakeLists.txt
    # From tatsh-overlay.
    reinplace -E {/enable_testing.*/d} ${worksrcpath}/externals/sirit/CMakeLists.txt
    reinplace -E {s/add_subdirectory\(externals\/SPIRV-Headers.*/find_package(SPIRV-Headers REQUIRED)/} \
        ${worksrcpath}/externals/sirit/CMakeLists.txt
    reinplace {s/-Werror)/)/} ${worksrcpath}/externals/sirit/CMakeLists.txt
    foreach f [exec find ${worksrcpath}/src -name CMakeLists.txt] {
        reinplace -q {s/-Werror=/-W/g} ${f}
    }
    reinplace {s/VulkanMemoryAllocator/VulkanMemoryAllocator REQUIRED/} ${worksrcpath}/CMakeLists.txt
    reinplace -E {s/set\(CAN_BUILD_NX_TZDB .*/set(CAN_BUILD_NX_TZDB false)/} \
        ${worksrcpath}/externals/nx_tzdb/CMakeLists.txt

    # Imported targets add -isystem ${prefix}/include, which has the headers of the default boost
    # and ffmpeg ports; put this Boost and FFmpeg 7 in front of it for every target.
    set fd [open ${workpath}/include-first.cmake w]
    puts ${fd} "include_directories(BEFORE SYSTEM ${prefix}/libexec/boost/${boost.version}/include\
        ${ffmpeg_prefix}/include)"
    close ${fd}
}

pre-configure {
    # Prebuilt time zone data and the compatibility list, in the build tree where CMake looks.
    set tz ${build.dir}/externals/nx_tzdb
    file mkdir ${tz}
    file delete -force ${tz}/nx_tzdb
    copy ${workpath}/nx_tzdb ${tz}/nx_tzdb
    file mkdir ${build.dir}/dist/compatibility_list
    system "gunzip -c ${filespath}/fallback-compat.json.gz >\
        ${build.dir}/dist/compatibility_list/compatibility_list.json"
}

# -I${prefix}/include (and CPATH, which acts like -I) would be searched before every -isystem
# directory, so the default boost and ffmpeg headers there would win over the ones above.
configure.cppflags-delete -I${prefix}/include
compiler.cpath

compiler.cxx_standard 2020
# From tatsh-overlay: keeps the VkResult switch in vulkan_wrapper.cpp building with newer headers.
configure.cxxflags-append -Wno-switch

configure.args-append \
                    -DBUILD_FULLNAME=${tag} \
                    -DBUILD_SHARED_LIBS=OFF \
                    -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON \
                    -DCMAKE_PROJECT_INCLUDE=${workpath}/include-first.cmake \
                    -DENABLE_COMPATIBILITY_LIST_DOWNLOAD=OFF \
                    -DENABLE_CUBEB=ON \
                    -DENABLE_QT6=ON \
                    -DENABLE_QT_TRANSLATION=OFF \
                    -DENABLE_WEB_SERVICE=OFF \
                    -DGIT_BRANCH=${name} \
                    -DGIT_DESC=${version} \
                    -DGIT_REV=${version} \
                    -DSIRIT_USE_SYSTEM_SPIRV_HEADERS=ON \
                    -DUSE_DISCORD_PRESENCE=OFF \
                    -DUSE_SYSTEM_MOLTENVK=ON \
                    -DYUZU_CHECK_SUBMODULES=OFF \
                    -DYUZU_DOWNLOAD_TIME_ZONE_DATA=OFF \
                    -DYUZU_ENABLE_COMPATIBILITY_REPORTING=OFF \
                    -DYUZU_TESTS=OFF \
                    -DYUZU_USE_BUNDLED_FFMPEG=OFF \
                    -DYUZU_USE_BUNDLED_QT=OFF \
                    -DYUZU_USE_EXTERNAL_SDL2=OFF \
                    -DYUZU_USE_EXTERNAL_VULKAN_HEADERS=OFF \
                    -DYUZU_USE_EXTERNAL_VULKAN_UTILITY_LIBRARIES=OFF \
                    -DYUZU_USE_FASTER_LD=OFF \
                    -DYUZU_USE_PRECOMPILED_HEADERS=OFF \
                    -DYUZU_USE_QT_MULTIMEDIA=ON \
                    -DYUZU_USE_QT_WEB_ENGINE=OFF \
                    -Dfmt_DIR=${prefix}/lib/libfmt10/cmake/fmt \
                    -Wno-dev

destroot {
    set bin ${build.dir}/bin/${cmake.build_type}
    if {![file exists ${bin}]} {
        set bin ${build.dir}/bin
    }
    copy ${bin}/yuzu.app ${destroot}${applications_dir}/yuzu.app
    xinstall -m 0755 ${bin}/yuzu-cmd ${destroot}${prefix}/bin/
    ln -s ${applications_dir}/yuzu.app/Contents/MacOS/yuzu ${destroot}${prefix}/bin/yuzu
}

livecheck.type      none
