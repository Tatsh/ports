diff --git common/DynamicLibrary.cpp common/DynamicLibrary.cpp
index 6b69dcd..4682e4e 100644
--- common/DynamicLibrary.cpp
+++ common/DynamicLibrary.cpp
@@ -114,6 +114,16 @@ bool DynamicLibrary::Open(const char* filename, Error* error)
 					}
 				}
 			}
+
+			// MoltenVK, shaderc and the like are installed in the MacPorts prefix, which dlopen
+			// does not search for bare names.
+			const std::string prefix_path = fmt::format("@PREFIX@/lib/{}", filename);
+			m_handle = dlopen(prefix_path.c_str(), RTLD_NOW);
+			if (m_handle)
+			{
+				Error::Clear(error);
+				return true;
+			}
 		}
 #endif
 
