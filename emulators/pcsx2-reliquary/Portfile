PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           qt6 1.0

github.setup        DiscoStarslayer pcsx2-reliquary 1.10.0-reliquary v
github.tarball_from archive
version             1.10.0
revision            0
categories          emulators games
# Upstream's own GPL-3+ plus the licences of what is built from 3rdparty/ (CC0 as public-domain).
license             GPL-3+ Apache-2 BSD Boost-1 GPL-2+ ISC LGPL-2.1+ LGPL-3+ MIT OFL-1.1 \
                    zlib public-domain
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         PCSX2 fork with speedrun and practice tooling.
long_description    PCSX2 Reliquary is a fork of the PCSX2 PlayStation 2 emulator that adds \
                    tooling for speedrunning and practice. This installs PCSX2 Reliquary.app, \
                    with the Metal and Vulkan (through MoltenVK) renderers.
homepage            https://github.com/DiscoStarslayer/pcsx2-reliquary
supported_archs     x86_64
platforms           {darwin >= 22}

checksums           rmd160  4860d15f0a86c409e77b4ad0511254a890559d71 \
                    sha256  783272719f9745bffe6ad22ebb6fa86b0515221b32ecf2dcfb7957ca5aed8eae \
                    size    27762379

depends_build-append \
                    port:pkgconfig
depends_lib-append  path:lib/libcurl.dylib:curl \
                    port:ffmpeg \
                    port:freetype \
                    port:kddockwidgets \
                    port:libjpeg-turbo \
                    port:libpcap \
                    port:libpng \
                    port:libusb \
                    port:lz4 \
                    port:plutosvg \
                    port:plutovg \
                    port:rapidyaml \
                    port:SDL3 \
                    port:shaderc \
                    port:webp \
                    port:zlib \
                    port:zstd
depends_run-append  port:MoltenVK

qt6.depends_lib-append qtsvg
qt6.depends_build-append qttools

# Qt 6.7: the filter change notifications from Qt 6.10, QStyleHints::setColorScheme() from 6.8 and
# QString::arg() taking a std::string.
patchfiles          patch-qt67.diff
# Look for MoltenVK and shaderc in ${prefix}/lib instead of copying them into the app bundle, and
# no in-app updater (MacPorts updates the app).
patchfiles-append   patch-macports.diff

post-extract {
    # paraLLEl-GS is an empty submodule in the archive; everything using it is behind
    # if(TARGET parallel-gs) (from tatsh-overlay).
    delete ${worksrcpath}/pcsx2/GS/parallel-gs
}

post-patch {
    reinplace "s|@PREFIX@|${prefix}|g" ${worksrcpath}/common/DynamicLibrary.cpp
    # The tag v1.10.0-reliquary is not a plain vX.Y.Z, so the version shown comes from GIT_REV.
    reinplace -E "/set\\(PCSX2_GIT_(TAG|REV) \"\"\\)/s/\"\"/\"v${github.version}\"/" \
        ${worksrcpath}/cmake/Pcsx2Utils.cmake
    # Own data directory and bundle identifier, so this does not share settings with PCSX2.
    reinplace {/MAC_DATA_DIR\[\] = /s|Support/PCSX2"|Support/PCSX2 Reliquary"|} \
        ${worksrcpath}/pcsx2/Pcsx2Config.cpp
    reinplace {s|net.pcsx2.pcsx2|net.pcsx2.reliquary|} ${worksrcpath}/pcsx2/Resources/Info.plist.in
}

# std::lexicographical_compare_three_way and other C++20 library features that Xcode 15's libc++
# lacks; libc++'s availability markup keeps the code to what macOS 13's libc++ provides.
compiler.whitelist  macports-clang-20

# The Metal shaders are compiled with xcrun metal, which only Xcode has.
use_xcode           yes

cmake.build_type    Release
cmake.generator     Ninja
configure.args-append \
                    -Wno-dev \
                    -DBUILD_SHARED_LIBS=OFF \
                    -DENABLE_TESTS=OFF \
                    -DUSE_LINKED_FFMPEG=ON \
                    -DUSE_VTUNE=OFF \
                    -DUSE_VULKAN=ON \
                    -DSKIP_POSTPROCESS_BUNDLE=ON \
                    -DOSX_USE_DEFAULT_SEARCH_PATH=ON \
                    -DDISABLE_ADVANCE_SIMD=ON

destroot {
    copy ${build.dir}/pcsx2-qt/PCSX2.app "${destroot}${applications_dir}/PCSX2 Reliquary.app"
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/COPYING.GPLv3 \
        ${destroot}${prefix}/share/doc/${name}/
}

livecheck.type      none
