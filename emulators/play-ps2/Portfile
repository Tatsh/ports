foreach {dir repo rev unpacked} ${submodules} {
    master_sites-append https://github.com/${repo}/archive/${rev}.tar.gz?dummy=:s${i}
    distfiles-append    ${unpacked}-${rev}.tar.gz:s${i}
    incr i
}

