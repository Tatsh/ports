post-extract {
    # In order: a nested submodule moves into a parent that is already in place.
    foreach {dir repo rev unpacked} ${submodules} {
        set dest ${worksrcpath}/deps/${dir}
        file delete -force ${dest}
        move ${workpath}/${unpacked}-${rev} ${dest}
    }
}

# From tatsh-overlay: use the system libraries.
patchfiles          patch-source-system-deps.diff \
                    patch-framework-system-deps.diff

post-patch {
    reinplace {/^set(PROJECT_Version/d} ${worksrcpath}/CMakeLists.txt
    # Only zstd's zlibWrapper stays (a zlib-API shim that the zstd port does not install); the
    # library comes from the zstd port (from tatsh-overlay).
    foreach f [glob -directory ${worksrcpath}/deps/Dependencies/zstd *] {
        if {[file tail ${f}] ne "zlibWrapper"} {
            delete ${f}
        }
    }
    set fd [open ${worksrcpath}/deps/Dependencies/build_cmake/zstd_zlibwrapper/CMakeLists.txt w]
    puts ${fd} {project(libzstdwapper C)
find_package(ZLIB REQUIRED)
find_package(PkgConfig REQUIRED)
pkg_check_modules(ZSTD REQUIRED IMPORTED_TARGET libzstd)
file(GLOB zstd_zlibwrapperSource ${CMAKE_CURRENT_SOURCE_DIR}/../../zstd/zlibWrapper/*.c)
add_library(libzstd_zlibwrapper_static STATIC ${zstd_zlibwrapperSource})
target_link_libraries(libzstd_zlibwrapper_static PRIVATE PkgConfig::ZSTD PUBLIC ZLIB::ZLIB)
target_include_directories(libzstd_zlibwrapper_static PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/../../zstd/zlibWrapper/)
target_compile_definitions(libzstd_zlibwrapper_static PUBLIC ZWRAP_USE_ZSTD)}
    close ${fd}
}

# The macOS front end uses CAMetalLayer, but QuartzCore is only linked for the Vulkan renderer.
configure.ldflags-append -framework QuartzCore
# https://github.com/jpd002/Play-/issues/911
configure.cppflags-append -DNDEBUG
# The OpenGL renderer; the Vulkan one copies a MoltenVK into the app bundle.
# macOS's OpenGL, not Mesa's libGL from ${prefix}/lib, which needs X11 (the cmake portgroup makes
# FindOpenGL look at frameworks last).
configure.args-append \
                    -DOPENGL_gl_LIBRARY=${configure.sdkroot}/System/Library/Frameworks/OpenGL.framework \
                    -DOPENGL_opengl_LIBRARY=${configure.sdkroot}/System/Library/Frameworks/OpenGL.framework \
                    -DOPENGL_INCLUDE_DIR=${configure.sdkroot}/System/Library/Frameworks/OpenGL.framework \
                    -DBUILD_LIBRETRO_CORE=OFF \
                    -DBUILD_SHARED_LIBS=OFF \
                    -DBUILD_TESTS=OFF \
                    -DPROJECT_Version=${version} \
                    -DUSE_GSH_VULKAN=OFF \
                    -Wno-dev

destroot {
    copy ${build.dir}/Source/ui_qt/Play.app ${destroot}${applications_dir}/Play.app
}
