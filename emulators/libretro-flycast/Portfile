post-extract {
    foreach {dir repo rev} ${submodules} {
        set dest ${worksrcpath}/core/${dir}
        file delete -force ${dest}
        move ${workpath}/[file tail ${repo}]-${rev} ${dest}
    }
}

configure.args-append \
                    -DCCACHE_PROGRAM=CCACHE_PROGRAM-NOTFOUND \
                    -DLIBRETRO=ON \
                    -DUSE_OPENMP=OFF

# Do not let the build's ccache launcher write outside the build tree.
build.env-append    CCACHE_DISABLE=1

destroot {
    xinstall -d ${destroot}${prefix}/lib/libretro
    xinstall -m 0755 ${build.dir}/flycast_libretro.dylib ${destroot}${prefix}/lib/libretro/
}

livecheck.type      none
