# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        kcrawford dockutil 3.1.3
# Use archive URL so fetch works (release tarball can return 403)
github.tarball_from archive
master_sites        ${github.homepage}/archive/
distfiles           3.1.3.tar.gz
distname            dockutil-3.1.3

license             Apache-2
maintainers         {gmail.com:audvare @Tatsh}
categories          aqua sysutils
description         dockutil is a command line utility for managing macOS \
                    dock items.
long_description    ${description}
platforms           macosx

depends_lib-append  port:swift-argument-parser

checksums           rmd160  af69c69c7e1e14407c32548865385654012f2b1e \
                    sha256  622bbb5c97f09b3f46ebea9a612f7470dd7fb6a7daaed12b87dee5af7a0177f6 \
                    size    17474

use_configure       no

# 3.x is SwiftPM-only. SwiftPM would fetch swift-argument-parser itself, so compile
# with swiftc directly against the MacPorts swift-argument-parser instead.
build {
    system -W ${worksrcpath} "/usr/bin/xcrun swiftc -O -parse-as-library \
        -module-name ${name} \
        [join [glob -directory ${worksrcpath} Sources/DockUtil/*.swift]] \
        -I ${prefix}/lib/swift/macosx -L${prefix}/lib -lArgumentParser \
        -Xlinker -rpath -Xlinker ${prefix}/lib \
        -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist \
        -Xlinker Sources/Resources/Info.plist \
        -o ${name}"
}

destroot {
    xinstall -m 0755 ${worksrcpath}/${name} ${destroot}${prefix}/bin/${name}
}
