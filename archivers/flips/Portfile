                    sha256  5745b0bad8cd8d99b76ef8c9c77988266cb0c75450c74a42bce5bf83f17caeed \
                    size    44533257

use_configure       no
build.args          TARGET=cli \
                    CXX="${configure.cxx} [get_canonical_archflags cxx]" \
                    CFLAGS="${configure.cxxflags}" \
                    LFLAGS="${configure.ldflags}"

destroot {
    xinstall -m 0755 ${worksrcpath}/flips ${destroot}${prefix}/bin/
}
