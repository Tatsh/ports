github.setup        Tatsh tnfoview 0.2.0 v
github.tarball_from archive
categories          textproc aqua
platforms           darwin
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         A simple NFO viewer.
long_description    ${description} It renders the CP437 text art of NFO files.
homepage            https://tatsh.github.io/tnfoview/

checksums           rmd160  be30eca0f2e8527e06de4349f9d4f080db8348ed \
                    sha256  984db7487d97f42dd51c7eee1c55f68f8c92f4ec2ce88466e8124bfc9cc3f9bc \
                    size    1931962


# Upstream's install rules run macdeployqt to bundle Qt into the app; use MacPorts' Qt instead.
destroot {
    copy "${build.dir}/src/Tatsh NFO Viewer.app" ${destroot}${applications_dir}/
    set res "${destroot}${applications_dir}/Tatsh NFO Viewer.app/Contents/Resources"
    xinstall -d ${res}
    foreach f [glob -nocomplain ${build.dir}/src/*.icns] {
        xinstall -m 0644 ${f} ${res}/
    }
    ln -s "${applications_dir}/Tatsh NFO Viewer.app/Contents/MacOS/Tatsh NFO Viewer" ${destroot}${prefix}/bin/tnfoview
}

test.run            yes
test.env-append     QT_QPA_PLATFORM=offscreen
test {
    system -W ${build.dir} "${configure.cmd} -DBUILD_TESTS=ON ."
    system -W ${build.dir} "${build.cmd} ${build.pre_args}"
    system -W ${build.dir} "[join ${test.env}] ${prefix}/bin/ctest --output-on-failure"
}
