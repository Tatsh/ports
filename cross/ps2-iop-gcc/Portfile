# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                ps2-iop-gcc
version             15.2.0
categories          cross devel games
platforms           darwin
license             GPL-3+ LGPL-3+
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         GCC for the PlayStation 2 I/O processor (mipsel-none-elf).
long_description    ${description} Part of the ps2dev toolchain.
homepage            https://gcc.gnu.org/
master_sites        gnu:gcc/gcc-${version}
distname            gcc-${version}
use_xz              yes
dist_subdir         ${name}/${version}

checksums           rmd160  b16e24d6caab2f7be54edc500b99ef08d436d300 \
                    sha256  438fd996826b0c82485a29da03a72d71d6e3541a83ec702df4271f6fe025d24e \
                    size    101056276

depends_build-append port:flex \
                    port:texinfo
depends_lib-append  port:gmp \
                    port:libmpc \
                    port:mpfr \
                    port:ps2-iop-binutils \
                    port:zlib

set target          mipsel-none-elf
configure.dir       ${workpath}/build
configure.cmd       ${worksrcpath}/configure
build.dir           ${workpath}/build
build.target        all
destroot.target     install-strip
pre-configure {
    file mkdir ${workpath}/build
}
configure.cxxflags-append -fno-char8_t
configure.env-append CFLAGS_FOR_TARGET=-O2 CXXFLAGS_FOR_TARGET=-O2
build.env-append    CFLAGS_FOR_TARGET=-O2 CXXFLAGS_FOR_TARGET=-O2

# No --with-as/--with-ld: they make GCC assume GNU ld, which defaults MIPS to -msplit-addresses.
configure.args      --target=${target} \
                    --enable-languages=c,c++ \
                    --with-float=soft \
                    --with-headers=no \
                    --with-system-zlib \
                    --with-gmp=${prefix} \
                    --with-mpfr=${prefix} \
                    --with-mpc=${prefix} \
                    --without-isl \
                    --without-newlib \
                    --without-zstd \
                    --disable-decimal-float \
                    --disable-libada \
                    --disable-libatomic \
                    --disable-libcc1 \
                    --disable-libffi \
                    --disable-libgomp \
                    --disable-libquadmath \
                    --disable-libssp \
                    --disable-libstdcxx \
                    --disable-libstdcxx-pch \
                    --disable-multilib \
                    --disable-nls \
                    --disable-shared \
                    --disable-target-libiberty \
                    --disable-target-zlib \
                    --disable-threads \
                    --disable-tls

# Unprefixed files that would collide with the host GCC.
post-destroot {
    file delete -force ${destroot}${prefix}/share/info ${destroot}${prefix}/share/man/man7
    fs-traverse f [list ${destroot}${prefix}/libexec] {
        if {[file extension ${f}] eq ".la"} {
            file delete ${f}
        }
    }
}
