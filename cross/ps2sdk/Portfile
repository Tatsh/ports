# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        ps2dev ps2sdk cf9557d3c931544c6940c0f5e1ad24fe7d2ac596
github.tarball_from archive
version             2.0.0.20261117
categories          cross devel games
platforms           darwin
license             AFL-2 BSD Permissive
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Open source SDK for the PlayStation 2.
long_description    ${description} Installed to ${prefix}/share/ps2dev/ps2sdk (set PS2DEV and \
                    PS2SDK accordingly).
dist_subdir         ${name}/${version}

set lwip_tag        STABLE-2_2_1_RELEASE
set fatfs_commit    18cc3d9e07473a6aa3d783a66224b243a7b4974c
master_sites-append https://github.com/lwip-tcpip/lwip/archive/refs/tags/${lwip_tag}.tar.gz?dummy=:lwip \
                    https://github.com/fjtrujy/FatFs/archive/${fatfs_commit}.tar.gz?dummy=:fatfs
distfiles-append    lwip-${lwip_tag}.tar.gz:lwip \
                    FatFs-${fatfs_commit}.tar.gz:fatfs

checksums           ps2sdk-cf9557d3c931544c6940c0f5e1ad24fe7d2ac596.tar.gz \
                    rmd160  c1c20a25cdaa4543a66b9989194d0a2bdc8870f8 \
                    sha256  0b6b3b108eb4769022141cf5a4f1b5fd00f5391ebb6272207d4a7c972ba14524 \
                    size    2561885 \
                    lwip-STABLE-2_2_1_RELEASE.tar.gz \
                    rmd160  3368022b5430f610a7c9db99b60818bf4e688248 \
                    sha256  ce0b7461c0ad9602c376f0bf07c5eb7253b48c7bf66f011c6bf3e2a96731c539 \
                    size    1598662 \
                    FatFs-18cc3d9e07473a6aa3d783a66224b243a7b4974c.tar.gz \
                    rmd160  c6c6243467b4c00a91c572fa0487261e95023390 \
                    sha256  ef0ce9710869f1932c328c5c4b07a707fdf08fa72e203f1fb1fa9ef67e288b81 \
                    size    2311582

depends_lib-append  port:ps2-ee-gcc \
                    port:ps2-iop-gcc

set ps2dev          ${prefix}/share/ps2dev

post-extract {
    file delete -force ${worksrcpath}/common/external_deps/lwip ${worksrcpath}/common/external_deps/fatfs
    file rename ${workpath}/lwip-${lwip_tag} ${worksrcpath}/common/external_deps/lwip
    file rename ${workpath}/FatFs-${fatfs_commit} ${worksrcpath}/common/external_deps/fatfs
}

post-patch {
    foreach f {ee/Rules.make iop/Rules.make tools/Rules.make} {
        reinplace -E {s/ -Werror([[:space:]]|$)/\1/g} ${worksrcpath}/${f}
    }
    reinplace {/download_dependencies\.sh/d} ${worksrcpath}/common/external_deps/Makefile
    foreach f {ee/startup/Makefile iop/startup/Makefile} {
        reinplace -E {s#\$\(PS2DEV\)/(ee|iop)/#$(SYSROOT_PREFIX)/#} ${worksrcpath}/${f}
    }
}

use_configure       no
use_parallel_build  no

build.env-append    PS2DEV=${ps2dev} PS2SDK=${ps2dev}/ps2sdk
build.target        all

destroot {
    foreach t {mips64r5900el-ps2-elf mipsel-none-elf} {
        xinstall -d ${destroot}${prefix}/${t}/lib
    }
    system -W ${worksrcpath} "env PS2DEV=${destroot}${ps2dev} PS2SDK=${destroot}${ps2dev}/ps2sdk \
        ${build.cmd} SYSROOT_PREFIX=${destroot}${prefix} install"
    set samples ${destroot}${ps2dev}/ps2sdk/samples
    foreach f [glob -nocomplain -directory ${samples} *] {
        if {[file isdirectory ${f}] || [file tail ${f}] eq "Makefile"} {
            file delete -force ${f}
        }
    }
    foreach lib {cdvd cglue kernel pthreadglue profglue} {
        ln -s ${ps2dev}/ps2sdk/ee/lib/lib${lib}.a \
            ${destroot}${prefix}/mips64r5900el-ps2-elf/lib/lib${lib}.a
    }
}

notes "
To build PlayStation 2 homebrew, set
    PS2DEV=${ps2dev}
    PS2SDK=${ps2dev}/ps2sdk
and add \${PS2SDK}/bin to PATH.
"

livecheck.type      none
