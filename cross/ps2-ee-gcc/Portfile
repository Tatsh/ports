set newlib_commit   58fb6406408a541e0c826f47487315b485d4db56
set pthread_commit  b1746fd2b52d5aeafc1173761eb50e0958e8994b
master_sites-append https://github.com/ps2dev/newlib/archive/${newlib_commit}.tar.gz?dummy=:newlib \
