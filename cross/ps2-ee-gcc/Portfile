depends_build-append port:flex \
                    port:gsed \
                    port:texinfo
depends_lib-append  port:gmp \
                    port:libmpc \
                    port:mpfr \
                    port:ps2-ee-binutils \
                    port:zlib

set target          mips64r5900el-ps2-elf
set stage           ${workpath}/stage
set newlib          ${workpath}/newlib-${newlib_commit}
set pthread         ${workpath}/pthread-embedded-${pthread_commit}

post-patch {
    reinplace -E {s/ -Werror([[:space:]]|$)/\1/g} ${pthread}/platform/ps2/Makefile
}

configure.cxxflags-append -fno-char8_t

proc ps2ee_configure {src dir args} {
    global workpath target prefix configure.env
    file mkdir ${workpath}/${dir}
    system -W ${workpath}/${dir} "env [join ${configure.env}] \
        CFLAGS_FOR_TARGET='-O2 -gdwarf-2' CXXFLAGS_FOR_TARGET='-O2 -gdwarf-2' \
        ${src}/configure --target=${target} [join ${args}]"
}

set gcc_common      {--with-float=hard --with-system-zlib --without-isl --without-zstd \
                     --disable-libcc1 --disable-libssp --disable-multilib --disable-nls --disable-tls}

# libgcc's t-hardfp splits function names with GNU sed alternation (\|).
configure {}

# Upstream's ps2toolchain-ee order: a C-only GCC, newlib (and newlib-nano), pthread-embedded, then
# the full C/C++ GCC against that sysroot.
build {
    set path "${stage}${prefix}/bin:${prefix}/libexec/gnubin:$env(PATH)"
    set env_path "env PATH=${path}"
    ps2ee_configure ${worksrcpath} build-stage1 --prefix=${prefix} --with-gmp=${prefix} \
        --with-mpfr=${prefix} --with-mpc=${prefix} {*}${gcc_common} --enable-languages=c \
        --without-headers --without-newlib --disable-libatomic --disable-libgcc \
        --disable-libgomp --disable-libquadmath --disable-shared --disable-threads
    system -W ${workpath}/build-stage1 "${build.cmd} ${build.pre_args} all-gcc"
    system -W ${workpath}/build-stage1 "${build.cmd} DESTDIR=${stage} install-gcc"
    file mkdir ${stage}${prefix}/${target}
    file delete -force ${stage}${prefix}/${target}/bin
    ln -s ${prefix}/${target}/bin ${stage}${prefix}/${target}/bin

    set env(PATH) ${path}
    ps2ee_configure ${newlib} build-newlib --prefix=${prefix} --with-sysroot=${prefix}/${target} \
        --enable-newlib-io-c99-formats --enable-newlib-multithread \
        --enable-newlib-retargetable-locking
    system -W ${workpath}/build-newlib "${build.cmd} ${build.pre_args}"
    system -W ${workpath}/build-newlib "${build.cmd} DESTDIR=${stage} install-strip"

    ps2ee_configure ${newlib} build-newlib-nano --prefix=${prefix} --with-sysroot=${prefix}/${target} \
        --disable-newlib-fseek-optimization --disable-newlib-fvwrite-in-streamio \
        --disable-newlib-supplied-syscalls --disable-newlib-unbuf-stream-opt \
        --disable-newlib-wide-orient --disable-nls --enable-lite-exit \
        --enable-newlib-global-atexit --enable-newlib-multithread \
        --enable-newlib-nano-formatted-io --enable-newlib-nano-malloc \
        --enable-newlib-reent-small --enable-newlib-retargetable-locking
    system -W ${workpath}/build-newlib-nano "${build.cmd} ${build.pre_args}"
    system -W ${workpath}/build-newlib-nano "${build.cmd} DESTDIR=${workpath}/nano install-strip"

    system -W ${pthread}/platform/ps2 "${build.cmd} DESTDIR=${stage}${prefix}/${target} all install"

    ps2ee_configure ${worksrcpath} build-stage2 --prefix=${prefix} --with-gmp=${prefix} \
        --with-mpfr=${prefix} --with-mpc=${prefix} {*}${gcc_common} --enable-languages=c,c++ \
        --with-sysroot=${prefix}/${target} --with-build-sysroot=${stage}${prefix}/${target} \
        --with-native-system-header-dir=/include --with-newlib --disable-libquadmath \
        --enable-cxx-flags=-G0 --enable-threads=posix --with-python-dir=share/${target}/python
    system -W ${workpath}/build-stage2 "${build.cmd} ${build.pre_args} all"
}

destroot {
    set sysroot ${destroot}${prefix}/${target}
    system -W ${workpath}/build-newlib "${build.cmd} DESTDIR=${destroot} install-strip"
    foreach lib {c g m} {
        file copy ${workpath}/nano${prefix}/${target}/lib/lib${lib}.a ${sysroot}/lib/lib${lib}_nano.a
    }
    system -W ${pthread}/platform/ps2 "${build.cmd} DESTDIR=${sysroot} install"
    system -W ${workpath}/build-stage2 "env PATH=${stage}${prefix}/bin:$env(PATH) \
        ${build.cmd} DESTDIR=${destroot} install-strip"
    file delete -force ${sysroot}/lib/crt0.o ${destroot}${prefix}/share/info \
        ${destroot}${prefix}/share/man/man7
    fs-traverse f [list ${destroot}${prefix}/libexec] {
        if {[file extension ${f}] eq ".la"} {
            file delete ${f}
        }
    }
}

livecheck.type      none
