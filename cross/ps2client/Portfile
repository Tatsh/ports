PortSystem          1.0
PortGroup           github 1.0

github.setup        ps2dev ps2client 2.0.0 v
github.tarball_from archive
categories          cross games net
license             BSD
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Host client for ps2link and ps2netfs on a networked PlayStation 2.
long_description    ps2client sends programs to and controls a PlayStation 2 running ps2link, and \
                    fsclient browses its file systems through ps2netfs.

checksums           rmd160  f2ca4a56287d09820b96ab5c8c31e067c8bef816 \
                    sha256  6adf57f1aecef4edd49685c904e2d0891776b0e7a37eaaa95ee81a938bad6c41 \
                    size    20147

use_configure       no

build.args          CC=${configure.cc} \
                    CFLAGS="-std=gnu99 ${configure.cflags} [get_canonical_archflags cc] ${configure.ldflags}"

destroot {
    xinstall -m 0755 ${worksrcpath}/bin/fsclient ${worksrcpath}/bin/ps2client ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 {*}[glob ${worksrcpath}/doc/*.txt] ${worksrcpath}/README.md \
        ${destroot}${prefix}/share/doc/${name}/
}
