# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                ps2-iop-binutils
version             2.45.1
homepage            https://www.gnu.org/software/binutils/
master_sites        gnu:binutils
distname            binutils-${version}
use_xz              yes
dist_subdir         ${name}/${version}
categories          cross devel games
platforms           darwin
license             GPL-3+ LGPL-3+
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         GNU binutils for the PlayStation 2 I/O processor (mipsel-none-elf).
long_description    ${description} Part of the ps2dev toolchain.

checksums           rmd160  65f4fb2a4726a4bf598db81101fb565747386a18 \
                    sha256  5fe101e6fe9d18fdec95962d81ed670fdee5f37e3f48f0bef87bddf862513aa5 \
                    size    27962312

depends_build-append port:bison \
                    port:flex \
                    port:texinfo
depends_lib-append  port:zlib

set target          mipsel-none-elf
configure.dir       ${workpath}/build
configure.cmd       ${worksrcpath}/configure
build.dir           ${workpath}/build
pre-configure {
    file mkdir ${workpath}/build
}
configure.args      --target=${target} \
                    --disable-gdb \
                    --disable-gdbserver \
                    --disable-gprofng \
                    --disable-nls \
                    --disable-separate-code \
                    --disable-sim \
                    --disable-werror \
                    --with-python=no \
                    --with-system-zlib \
                    --without-debuginfod \
                    --without-expat \
                    --without-zstd
destroot.target     install-strip

# Do not link MacPorts' libfl. Its yylex reference is resolved through the flat namespace from the
# executable, and install-strip removes that symbol, so the stripped ar aborts at launch.
build.args-append   LEXLIB=
destroot.args-append LEXLIB=

# Unprefixed files that would collide with the host toolchain and other cross binutils.
post-destroot {
    file delete -force ${destroot}${prefix}/share/info ${destroot}${prefix}/lib/bfd-plugins \
        ${destroot}${prefix}/share/locale
}
