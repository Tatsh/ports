set vendor_dir      ${prefix}/libexec/${name}/vendor

post-patch {
    set f ${worksrcpath}/src/snowflake/cli/__init__.py
    set fd [open ${f} r]
    set text [read ${fd}]
    close ${fd}
    set fd [open ${f} w]
    puts ${fd} "import sys; sys.path.insert(0, '${vendor_dir}')  # MacPorts: pinned Typer, Click and protobuf"
    puts -nonewline ${fd} ${text}
    close ${fd}
}

post-destroot {
    xinstall -d ${destroot}${vendor_dir}
    foreach whl [list typer-${typer_version} click-${click_version} protobuf-${protobuf_version}] {
        system -W ${destroot}${vendor_dir} "/usr/bin/unzip -q ${distpath}/${whl}-py3-none-any.whl"
    }
    system "${python.bin} -m compileall -q ${destroot}${vendor_dir}"
}

test.run            yes
test.args-append    -p no:cacheprovider
depends_test-append \
    port:py${python.version}-pytest-httpserver \
    port:py${python.version}-pytest-xdist
