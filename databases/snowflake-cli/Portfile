PortSystem          1.0
PortGroup           python 1.0

name                snowflake-cli
version             3.34.0
revision            1
platforms           darwin linux freebsd
license             Apache-2
supported_archs     noarch
categories          databases python
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Snowflake CLI.
long_description    ${description}
homepage            https://pypi.org/project/snowflake-cli/
master_sites        pypi:[string index ${python.rootname} 0]/${python.rootname}

distname            snowflake_cli-${version}

# snow pins Typer and Click to versions the commands are written against. Newer Typer removed the
# click_type parameter it uses, so those two are installed for snow alone. So is a pure-Python
# protobuf 5, which its generated modules need (MacPorts' py-protobuf3 is 4.21).
set typer_version   0.17.3
set click_version   8.1.8
set protobuf_version 5.29.6
master_sites-append https://files.pythonhosted.org/packages/py3/t/typer/:typer \
                    https://files.pythonhosted.org/packages/py3/c/click/:click \
                    https://files.pythonhosted.org/packages/py3/p/protobuf/:protobuf
distfiles           ${distname}${extract.suffix} \
                    typer-${typer_version}-py3-none-any.whl:typer \
                    click-${click_version}-py3-none-any.whl:click \
                    protobuf-${protobuf_version}-py3-none-any.whl:protobuf
extract.only        ${distname}${extract.suffix}

checksums           snowflake_cli-3.34.0.tar.gz \
                    rmd160  2efdddda45d1826157a0823906778f5879ed3ab5 \
                    sha256  2d70e8e5e5be05f59fb95fd12753986e865ac7c37868a0a7c4d0123ab5830d0c \
                    size    3458296 \
                    typer-0.17.3-py3-none-any.whl \
                    rmd160  f8d4aae3c1d4420d25d7a238738b6b7edfe10396 \
                    sha256  643919a79182ab7ac7581056d93c6a2b865b026adf2872c4d02c72758e6f095b \
