# Dependencies from cmake/deps.txt that MacPorts lacks, as FetchContent name, extracted directory,
# GitHub repository and archive path. The rest come from MacPorts.
set bundled {
    date            date-3.0.1          HowardHinnant/date  refs/tags/v3.0.1
    mp11            mp11-boost-1.82.0   boostorg/mp11       refs/tags/boost-1.82.0
    pytorch_cpuinfo cpuinfo-4628dc060ce4e82345dc166bbac875609db4ff69 \
                                        pytorch/cpuinfo     4628dc060ce4e82345dc166bbac875609db4ff69
    gsl             GSL-4.2.1           microsoft/GSL       refs/tags/v4.2.1
    safeint         SafeInt-3.0.28      dcleblanc/SafeInt   refs/tags/3.0.28
    onnx            onnx-1.22.0         onnx/onnx           refs/tags/v1.22.0
    psimd           psimd-072586a71b55b7f8c584153d223e95687148a900 \
                                        Maratyszcza/psimd   072586a71b55b7f8c584153d223e95687148a900
    fp16            FP16-0a92994d729ff76a58f692d3028ca1b64b145d91 \
                                        Maratyszcza/FP16    0a92994d729ff76a58f692d3028ca1b64b145d91
    coremltools     coremltools-7.1     apple/coremltools   refs/tags/7.1
}
set i 0
foreach {fc dir repo ref} ${bundled} {
    incr i
    master_sites-append https://github.com/${repo}/archive/${ref}.tar.gz?dummy=:s${i}
    distfiles-append    ${dir}.tar.gz:s${i}
}

depends_build-append \
                    port:python313
depends_lib-append  port:abseil \
                    port:eigen3 \
                    port:flatbuffers \
                    port:nlohmann-json \
                    port:protobuf3-cpp \
                    port:re2

# Eigen comes from MacPorts; upstream always fetches a snapshot of its master branch.
patchfiles          patch-system-eigen.diff

post-patch {
    # ORT's own fixes for the bundled dependencies, which FetchContent does not apply to a
    # source directory given with FETCHCONTENT_SOURCE_DIR_<name>.
    foreach {dir p} {date-3.0.1 date/date.patch onnx-1.22.0 onnx/onnx.patch
                     coremltools-7.1 coremltools/crossplatformbuild.patch} {
        system -W ${workpath}/${dir} \
            "patch -p1 --binary --ignore-whitespace < ${worksrcpath}/cmake/patches/${p}"
    }
    # Abseil's config only accepts the exact version asked for; any recent one works.
    reinplace "s|FIND_PACKAGE_ARGS 20250814 NAMES absl|FIND_PACKAGE_ARGS NAMES absl|" \
        ${worksrcpath}/cmake/external/abseil-cpp.cmake
    # Regenerate the flatbuffers headers with the MacPorts flatc; the shipped ones only accept
    # flatbuffers 23.5.26.
    foreach fbs {onnxruntime/core/flatbuffers/schema/ort.fbs
                 onnxruntime/core/flatbuffers/schema/ort_training_checkpoint.fbs
                 onnxruntime/lora/adapter_format/adapter_schema.fbs} {
        system -W ${worksrcpath}/[file dirname ${fbs}] \
            "${prefix}/bin/flatc --cpp --scoped-enums --filename-suffix .fbs [file tail ${fbs}]"
    }
    # std::make_unique_for_overwrite needs libc++ 16; Xcode 15 has libc++ 15.
    reinplace "s|make_unique_for_overwrite<int8_t\\\[\\\]>(lut_buffer_size)|unique_ptr<int8_t\[\]>(new int8_t\[lut_buffer_size\])|" \
        ${worksrcpath}/onnxruntime/core/mlas/lib/qlutgemm.cpp
    # Install the library with an absolute install name rather than @rpath.
    reinplace "s|INSTALL_NAME_DIR @rpath)|INSTALL_NAME_DIR ${prefix}/lib)|" \
        ${worksrcpath}/cmake/onnxruntime.cmake
    # Fail instead of downloading anything that was missed.
    reinplace -E "s|;https://\[^;\]*;|;${workpath}/no-download;|" ${worksrcpath}/cmake/deps.txt
}

cmake.source_dir    ${worksrcpath}/cmake
cmake.build_type    Release

configure.args-append \
                    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
                    -DPython_EXECUTABLE=${prefix}/bin/python3.13 \
                    -DPython3_EXECUTABLE=${prefix}/bin/python3.13 \
                    -DONNX_CUSTOM_PROTOC_EXECUTABLE=${prefix}/bin/protoc \
                    -Donnxruntime_BUILD_SHARED_LIB=ON \
                    -Donnxruntime_BUILD_UNIT_TESTS=OFF \
                    -Donnxruntime_ENABLE_PYTHON=OFF \
                    -Donnxruntime_ENABLE_LTO=OFF \
                    -Donnxruntime_USE_FULL_PROTOBUF=ON \
                    -Donnxruntime_USE_COREML=ON \
                    -Donnxruntime_USE_VCPKG=OFF \
                    -Dsafeint_SOURCE_DIR=${workpath}/SafeInt-3.0.28
foreach {fc dir repo ref} ${bundled} {
    if {${fc} eq "safeint"} {
        continue
    }
    configure.args-append -DFETCHCONTENT_SOURCE_DIR_[string toupper ${fc}]=${workpath}/${dir}
}
