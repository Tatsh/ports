PortSystem          1.0
PortGroup           github 1.0

github.setup        udalov kotlin-vim 53fe045906df8eeb07cb77b078fc93acda6c90b8
github.tarball_from archive
version             20221230
categories          editors
license             Apache-2
platforms           any
supported_archs     noarch
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Kotlin syntax, indent and filetype detection for Vim.
long_description    ${description}

checksums           rmd160  ec8aa8a3da2b1c776260f4f4f0c5b890418eeed5 \
                    sha256  7270fd6a881d323b8ec1a016e8fe6495b49f28c6be63eebe0e9931bcc6784ca1 \
                    size    11764

depends_run-append  path:bin/vim:vim

use_configure       no
build {}

destroot {
    set vimfiles ${destroot}${prefix}/share/vim/vimfiles
    foreach d {ftdetect ftplugin indent syntax syntax_checkers} {
        if {[file isdirectory ${worksrcpath}/${d}]} {
            xinstall -d ${vimfiles}
            copy ${worksrcpath}/${d} ${vimfiles}/
        }
    }
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}

livecheck.type      none
