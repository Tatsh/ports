    livecheck.type none
    # Upstream pins uv_build <0.13; MacPorts has 0.13.x.
    post-patch {
        reinplace -E {s|uv_build *>= *([0-9.]+), *< *0\.13|uv_build >= \1|} ${worksrcpath}/pyproject.toml
    }
    depends_run-append \
        port:py${python.version}-niquests \
        port:py${python.version}-orjson
