# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                snowflake-connector-python
version             1.0
categories          python databases
platforms           any
supported_archs     noarch
license             Apache-2
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         snowflake-connector-python commands for the newest supported Python
long_description    Installs the commands from py315-snowflake-connector-python without a Python version suffix.
homepage            https://github.com/snowflakedb/snowflake-connector-python

distfiles

# Newest Python version in the python.versions of py-snowflake-connector-python.
set py_ver          315
set py_branch       3.15

depends_lib         port:py${py_ver}-snowflake-connector-python

use_configure       no

build {}

set commands {
    snowflake-dump-certs
    snowflake-dump-ocsp-response
    snowflake-dump-ocsp-response-cache
}

destroot {
    xinstall -d ${destroot}${prefix}/bin
    foreach cmd ${commands} {
        ln -s ${frameworks_dir}/Python.framework/Versions/${py_branch}/bin/${cmd} \
            ${destroot}${prefix}/bin/${cmd}
    }
}

livecheck.type      none
