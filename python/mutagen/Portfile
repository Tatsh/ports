# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                mutagen
version             1.0
categories          python audio devel
platforms           any
supported_archs     noarch
license             GPL-2+
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         mutagen commands for the newest supported Python
long_description    Installs the commands from py315-mutagen without a Python version suffix.
homepage            https://mutagen.readthedocs.io

distfiles

# Newest Python version in the python.versions of py-mutagen.
set py_ver          315
set py_branch       3.15

depends_lib         port:py${py_ver}-mutagen

use_configure       no

build {}

set commands {
    mid3cp
    mid3iconv
    mid3v2
    moggsplit
    mutagen-inspect
    mutagen-pony
}

destroot {
    xinstall -d ${destroot}${prefix}/bin
    foreach cmd ${commands} {
        ln -s ${frameworks_dir}/Python.framework/Versions/${py_branch}/bin/${cmd} \
            ${destroot}${prefix}/bin/${cmd}
    }
}

livecheck.type      none
