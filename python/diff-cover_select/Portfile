PortSystem          1.0
PortGroup           stub 1.0
PortGroup           select 1.0

name                diff-cover_select
version             0.1
categories          python
platforms           any
supported_archs     noarch
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         common files for selecting default diff-cover version
long_description    This port installs files that allow 'port select' to be used to create \
                    links to the preferred default version of diff-cover.

post-destroot {
    select::install diff-cover ${filespath}/base
    select::install diff-cover ${filespath}/none
}

livecheck.type      none
