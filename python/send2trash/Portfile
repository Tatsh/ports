# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                send2trash
version             1.0
categories          python devel
platforms           any
supported_archs     noarch
license             BSD
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         send2trash commands for the newest supported Python
long_description    Installs the commands from py315-send2trash without a Python version suffix.
homepage            https://github.com/arsenetar/send2trash

distfiles

# Newest Python version in the python.versions of py-send2trash.
set py_ver          315
set py_branch       3.15

depends_lib         port:py${py_ver}-send2trash

use_configure       no

build {}

set commands {
    send2trash
}

destroot {
    xinstall -d ${destroot}${prefix}/bin
    foreach cmd ${commands} {
        ln -s ${frameworks_dir}/Python.framework/Versions/${py_branch}/bin/${cmd} \
            ${destroot}${prefix}/bin/${cmd}
    }
}

livecheck.type      none
