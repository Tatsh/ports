PortSystem          1.0
PortGroup           python 1.0

name                py-vsjetpack
version             3.0.0
categories-append   multimedia
license             MIT
supported_archs     noarch
platforms           {darwin any}
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Full suite of filters, wrappers and helper functions for filtering video with \
                    VapourSynth.
long_description    ${description} vs-jetpack bundles vstools, vskernels, vsexprtools, vsrgtools, \
                    vsmasktools, vsaa, vsscale, vsdenoise, vsdehalo, vsdeband, vsdeinterlace and \
                    vssource. Individual functions need further VapourSynth plugins, which are \
                    not all dependencies of this port.
homepage            https://github.com/Jaded-Encoding-Thaumaturgy/vs-jetpack

checksums           rmd160  30bf900c4a2c26d9b7f59ef7459378e02a093a38 \
                    sha256  7b06c85c39ba1b13d2cfdb74d4190dfdeb2c3d74f4034ab3a6636414f6951aa9 \
                    size    602544

# Only for the Python that the vapoursynth port is built for.
python.versions     314
python.pep517_backend hatch

if {${name} ne ${subport}} {
    depends_build-append port:py${python.version}-versioningit
    depends_run-append  port:vapoursynth \
                        port:vapoursynth-akarin \
                        port:vapoursynth-vszip \
                        port:py${python.version}-jetpytools \
                        port:py${python.version}-numpy \
                        port:py${python.version}-psutil \
                        port:py${python.version}-rich \
                        port:py${python.version}-typing_extensions

    # The vsscale command downloads vs-mlrt models. It needs the "scale" extra (cyclopts 5 and
    # more) and the vs-mlrt plugins, none of which are packaged.
    post-destroot {
        delete ${destroot}${python.prefix}/bin/vsscale \
            ${destroot}${prefix}/bin/vsscale-${python.branch}
    }
}
