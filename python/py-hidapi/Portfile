PortSystem          1.0
PortGroup           python 1.0

name                py-hidapi
version             0.15.0
revision            0
license             {BSD GPL-3}
categories          python devel
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Python bindings for hidapi, a library for talking to USB and Bluetooth HID devices.
long_description    ${description} This builds the hid module against the hidapi port.
homepage            https://github.com/trezor/cython-hidapi
master_sites        pypi:[string index ${python.rootname} 0]/${python.rootname}

distname            ${python.rootname}-${version}

checksums           rmd160  41dc21645d649379b1db097c7c5cb385e95a1e51 \
                    sha256  ecbc265cbe8b7b88755f421e0ba25f084091ec550c2b90ff9e8ddd4fcd540311 \
                    size    184995

python.versions     310 311 312 313 314 315

if {${name} ne ${subport}} {
    depends_build-append \
                    port:pkgconfig \
                    port:py${python.version}-cython
    depends_lib-append \
                    port:hidapi

    # Link the hidapi port instead of the copy of hidapi in the source distribution.
    build.env-append    HIDAPI_SYSTEM_HIDAPI=1
    destroot.env-append HIDAPI_SYSTEM_HIDAPI=1

    # The upstream tests need real devices; check that the module loads and can enumerate.
    test.run        yes
    test {
        system -W ${worksrcpath} "${python.bin} -I -c 'import hid; print(hid.__version__); hid.enumerate()'"
    }
}
