# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           python 1.0

name                py-libyaz0
version             0.5
revision            0
license             GPL-3+
supported_archs     noarch
platforms           {darwin any}
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Yaz0 and Yaz1 compression and decompression library
long_description    libyaz0 compresses and decompresses the Yaz0 and Yaz1 formats used by \
                    Nintendo games, in pure Python.
homepage            https://github.com/aboood40091/libyaz0

# Upstream publishes the sdist as a zip.
extract.suffix      .zip
use_zip             yes

checksums           rmd160  ebeab498187fc5f8a795012e1779dbb215f7e92e \
                    sha256  b7212309c14479c27ef3a4945d1e8d9b1bfc4ca21734d4e45e546911b9faa6d4 \
                    size    53507

python.versions     313 314
python.pep517_backend setuptools

if {${name} ne ${subport}} {
    post-extract {
        # A prebuilt Windows extension module; the package falls back to pure Python without it.
        delete ${worksrcpath}/libyaz0/yaz0_pyd.pyd
    }

    # Without the Windows module, the package compiles its Cython source with pyximport on first
    # import, into ~/.pyxbld, and that source does not compile with current Cython anyway. Use the
    # pure Python implementation directly.
    patchfiles      patch-no-pyximport.diff

    test.run        yes
    test.cmd        ${python.bin} -I -c {import libyaz0; assert libyaz0.decompress(libyaz0.compress(b"abcabcabc" * 50)) == b"abcabcabc" * 50}
    test.target
}
