# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           python 1.0

name                py-rife-ncnn-vulkan-python
version             1.2.1
revision            0
categories-append   graphics
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Python binding of rife-ncnn-vulkan, made with SWIG.
long_description    A Python module that interpolates video frames (PIL images) with the RIFE \
                    models through ncnn, on the GPU through Vulkan (MoltenVK on macOS). It is a \
                    library for Video2X and similar programs.
homepage            https://github.com/media2x/rife-ncnn-vulkan-python
supported_archs     x86_64 arm64

# The sdist leaves out the models, which are in nihui's repository.
set models_commit   c806e66490679aebc1b4a6832985e004fd552f46
master_sites-append https://github.com/nihui/rife-ncnn-vulkan/archive/:models
distfiles-append    ${models_commit}.tar.gz:models

checksums           rife-ncnn-vulkan-python-1.2.1.tar.gz \
                    rmd160  e8a446b53a1b34e43e22b17a5097c1c91ebf1e9c \
                    sha256  2e350dbc9eaefb547efeedd97227e4579dffd75db278323f8fdc77e3931b112b \
                    size    22776769 \
                    c806e66490679aebc1b4a6832985e004fd552f46.tar.gz \
                    rmd160  5df2a8677687c264c65b08cd1a72ff84ed227218 \
                    sha256  cd9ea750a64ad656ddf1c029e275e19440b23f70841fa9a174ef4632176f6c10 \
                    size    419476051

python.versions     313 314 315

if {${name} ne ${subport}} {
    PortGroup       cmake 1.1

    set pkgname     rife_ncnn_vulkan_python

    # Find the system glslang through its CMake package, and fail rather than fall back to the
    # bundled ncnn (which the sdist leaves out) when the system one is missing.
    patchfiles      patch-system-glslang.diff

    post-extract {
        file mkdir ${worksrcpath}/${pkgname}/rife-ncnn-vulkan
        move ${workpath}/rife-ncnn-vulkan-${models_commit}/models \
            ${worksrcpath}/${pkgname}/rife-ncnn-vulkan/models
    }

    post-patch {
        # ncnn has dropped the pack8 shader option; the pack8 pipeline is never used on the GPU.
        reinplace "s|if (opt.use_shader_pack8)|if (false)|" \
            ${worksrcpath}/${pkgname}/rife-ncnn-vulkan/src/warp.cpp
    }

    depends_build-append \
                    port:swig-python \
                    port:vulkan-headers
    depends_lib-append \
                    port:ncnn \
                    port:vulkan-loader
    depends_run-append \
                    port:py${python.version}-pillow

    # Built with CMake directly, as Gentoo does: setup.py needs cmake-build-extension, which
    # only drives this same CMake build.
    use_configure   yes
    cmake.source_dir ${worksrcpath}/${pkgname}
    build.cmd       make
    build.target    all
    destroot.cmd    make
    destroot.target install
    destroot.destdir DESTDIR=${destroot}

    configure.args-append \
                    -DCMAKE_INSTALL_PREFIX=${python.pkgd}/${pkgname} \
                    -DPython_EXECUTABLE=${python.bin} \
                    -DPY_VERSION=${python.branch} \
                    -DBUILD_SHARED_LIBS=OFF \
                    -DCALL_FROM_SETUP_PY=ON \
                    -DUSE_SYSTEM_NCNN=ON

    post-destroot {
        set pkgdir ${destroot}${python.pkgd}/${pkgname}
        # What setup.py writes as the package's __init__.py.
        set fp [open ${pkgdir}/__init__.py w]
        puts ${fp} "from .rife_ncnn_vulkan import Rife, RIFE, wrapped"
        close ${fp}
        set docdir ${destroot}${prefix}/share/doc/${subport}
        xinstall -d ${docdir}
        foreach f {README.md LICENSE} {
            if {[file exists ${pkgdir}/${f}]} {
                file delete ${pkgdir}/${f}
            }
            xinstall -m 0644 ${worksrcpath}/${f} ${docdir}/
        }
        # Package metadata, so that importlib.metadata and pip see the module.
        copy ${worksrcpath}/${pkgname}.egg-info \
            ${destroot}${python.pkgd}/${pkgname}-${version}-py${python.branch}.egg-info
        system "${python.bin} -m compileall -q -d ${python.pkgd}/${pkgname} ${pkgdir}"
    }
}
