# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                openapi-spec-validator
version             1.0
categories          python
platforms           any
supported_archs     noarch
license             Apache-2
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         openapi-spec-validator commands for the newest supported Python
long_description    Installs the commands from py314-openapi-spec-validator without a Python version suffix.
homepage            https://github.com/python-openapi/openapi-spec-validator

distfiles

# Newest Python version in the python.versions of py-openapi-spec-validator.
set py_ver          314
set py_branch       3.14

depends_lib         port:py${py_ver}-openapi-spec-validator

use_configure       no

build {}

set commands {
    openapi-spec-validator
}

destroot {
    xinstall -d ${destroot}${prefix}/bin
    foreach cmd ${commands} {
        ln -s ${frameworks_dir}/Python.framework/Versions/${py_branch}/bin/${cmd} \
            ${destroot}${prefix}/bin/${cmd}
    }
}

livecheck.type      none
