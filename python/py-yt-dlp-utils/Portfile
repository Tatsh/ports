python.versions         313 314
python.pep517_backend   hatch

if {$subport ne $name} {
    livecheck.type none
    depends_run-append \
        port:py${python.version}-niquests \
        port:py${python.version}-requests \
        port:py${python.version}-urllib3-future \
        port:py${python.version}-typing_extensions \
        port:yt-dlp
    # yt-dlp is a single port with python3xx variants; its module must match this subport.
    require_active_variants yt-dlp python${python.version}
}

if {${name} ne ${subport}} {
    test.run            yes
    depends_test-append \
        port:py${python.version}-pytest-mock \
        port:py${python.version}-pytest-asyncio
}
