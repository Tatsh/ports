PortSystem          1.0
PortGroup           github 1.0
PortGroup           python 1.0

github.setup        bethington ghidra-mcp 7.0.0 v
github.tarball_from archive
name                ghidra-mcp-bridge
revision            0
license             Apache-2
supported_archs     noarch
platforms           {darwin any}
categories          python devel
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         MCP bridge exposing Ghidra's reverse engineering tools to MCP clients.
long_description    bridge-mcp-ghidra is a thin MCP-to-HTTP multiplexer: it connects MCP clients \
                    (AI assistants) to the HTTP server of the GhidraMCP extension in the \
                    ghidra-mcp port, and registers that server's analysis tools as its own.

set mcp_ver         1.28.1

# The bridge needs mcp 1.x (it uses mcp.server.fastmcp and its internals, which mcp 2 removed),
# while MacPorts has mcp 2. It gets its own copy of mcp 1.x, a pure Python wheel.
master_sites-append https://files.pythonhosted.org/packages/py3/m/mcp/:mcp
distfiles-append    mcp-${mcp_ver}-py3-none-any.whl:mcp
extract.only        ${distname}${extract.suffix}

checksums           ghidra-mcp-7.0.0.tar.gz \
                    rmd160  79b8548b2ff9646999acf462cbc868c64e81ba98 \
                    sha256  7d5446d8b89e83f85ee6f3767288eef3d5bf098e0920da15df6fe1dc2b5eeaa0 \
                    size    2395245 \
                    mcp-1.28.1-py3-none-any.whl \
                    rmd160  ea701f89e0ed3f85abfbce13487e70a0d03d8683 \
                    sha256  2726bca5e7193f61c5dde8b12500a6de2d9acf6d1a1c0be9e8c2e706437991df \
                    size    222620

python.versions         313
python.default_version  313
python.pep517_backend   hatch

depends_run-append  port:ghidra-mcp \
                    port:py${python.version}-anyio \
                    port:py${python.version}-httpx \
                    port:py${python.version}-httpx-sse \
                    port:py${python.version}-jsonschema \
