                    port:py${python.version}-starlette \
                    port:py${python.version}-typing_extensions \
                    port:py${python.version}-typing-inspection \
                    port:py${python.version}-uvicorn

set mcp_dir         ${prefix}/libexec/${name}

post-patch {
    # Put the private mcp ahead of the system one before anything imports it.
    set f ${worksrcpath}/python/bridge_mcp_ghidra/__init__.py
    set fd [open ${f} r]
    set text [read ${fd}]
    close ${fd}
    set fd [open ${f} w]
    puts -nonewline ${fd} "import sys as _sys\n_sys.path.insert(0, '${mcp_dir}')\ndel _sys\n\n${text}"
    close ${fd}
}

post-destroot {
    xinstall -d ${destroot}${mcp_dir}
    system -W ${destroot}${mcp_dir} "/usr/bin/unzip -q ${distpath}/mcp-${mcp_ver}-py3-none-any.whl"
    system "${python.bin} -m compileall -q -d ${mcp_dir} ${destroot}${mcp_dir}"
}

test.run            yes
test {
    system -W ${workpath} "env PYTHONPATH=${destroot}${python.pkgd}:${destroot}${mcp_dir} ${python.bin} -c \
        'import bridge_mcp_ghidra, mcp; print(mcp.__file__)'"
}

livecheck.type      none
