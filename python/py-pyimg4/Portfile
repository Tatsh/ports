distname            pyimg4-${version}

checksums           rmd160  c71c5fef2591d53a6dc523a5b3b359d41ee6f430 \
                    sha256  dd2d2a00573bdce3120d5d2a10a645727a1147930e45e67e40c79ad6061ce0dd \
                    size    174466

python.versions         313 314
python.pep517_backend   hatch

# The version comes from git through uv-dynamic-versioning; use the release version instead.
post-patch {
    reinplace {s/requires = \["hatchling", "uv-dynamic-versioning"\]/requires = ["hatchling"]/} \
        ${worksrcpath}/pyproject.toml
    reinplace "s/^dynamic = \\\[\"version\"\\\]/version = \"${version}\"/" ${worksrcpath}/pyproject.toml
    reinplace {/^\[tool.hatch.version\]/,/^source/d} ${worksrcpath}/pyproject.toml
}

if {$subport ne $name} {
    livecheck.type      none
    depends_run-append \
        port:py${python.version}-apple-compress \
        port:py${python.version}-python-asn1 \
        port:py${python.version}-click \
        port:py${python.version}-pycryptodome \
        port:py${python.version}-pylzss
}
