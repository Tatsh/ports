# The version comes from git through uv-dynamic-versioning; use the release version instead.
post-patch {
    reinplace -E {s/, *"uv-dynamic-versioning[^"]*"//} ${worksrcpath}/pyproject.toml
    reinplace "s/^dynamic = \\\[\"version\"\\\]/version = \"${version}\"/" ${worksrcpath}/pyproject.toml
    reinplace {/^\[tool.hatch.version\]/,/^source/d} ${worksrcpath}/pyproject.toml
}

