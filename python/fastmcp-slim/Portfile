# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                fastmcp-slim
version             1.0
categories          python
platforms           any
supported_archs     noarch
license             Apache-2
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         fastmcp-slim commands for the newest supported Python
long_description    Installs the commands from py314-fastmcp-slim without a Python version suffix.
homepage            https://gofastmcp.com

distfiles

# Newest Python version in the python.versions of py-fastmcp-slim.
set py_ver          314
set py_branch       3.14

depends_lib         port:py${py_ver}-fastmcp-slim

use_configure       no

build {}

set commands {
    fastmcp
}

destroot {
    xinstall -d ${destroot}${prefix}/bin
    foreach cmd ${commands} {
        ln -s ${frameworks_dir}/Python.framework/Versions/${py_branch}/bin/${cmd} \
            ${destroot}${prefix}/bin/${cmd}
    }
}

livecheck.type      none
