if {${name} ne ${subport}} {
    depends_run-append \
                    port:py${python.version}-joblib \
                    port:py${python.version}-matplotlib \
                    port:py${python.version}-numpy \
                    port:py${python.version}-scipy \
                    port:py${python.version}-tqdm

    # The source distribution has no tests; check that the module loads and runs.
    test.run        yes
    test {
        system -W ${workpath} "${python.bin} -I -c 'import numpy, noisereduce;\
            print(noisereduce.reduce_noise(y=numpy.random.default_rng(0).normal(size=8000), sr=8000).shape)'"
    }
