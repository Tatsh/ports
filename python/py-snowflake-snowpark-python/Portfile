categories          python
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Snowflake Snowpark for Python.
long_description    ${description}
homepage            https://www.snowflake.com/
master_sites        pypi:[string index ${python.rootname} 0]/${python.rootname}

distname            snowflake_snowpark_python-${version}

checksums           rmd160  894be04ba93bac0e08b59554fffce804ecc80f13 \
                    sha256  8ab9cef7c51140deee98518c7c290cd7aa16e16983dc2f31d465e62d38a8c201 \
                    size    1879202

# Upstream pins its build backend versions.
post-patch {
    reinplace -E {/^requires *=/s/"([A-Za-z0-9_.-]+)(\[[a-z,]+\])?(==|>=|<|~=)[^"]*"/"\1"/g} ${worksrcpath}/pyproject.toml
}

python.versions         313 314 315
python.pep517_backend   setuptools

if {$subport ne $name} {
    livecheck.type      none
    # The sdist ships the generated protobuf modules, so protoc and protoc-gen-mypy are only needed
    # to regenerate them. Skip the checks and keep the shipped files newer than the source.
    post-patch {
        reinplace {s/^if protoc is None:$/if False:/; s/^if protoc_gen_mypy is None:$/if False:/} \
            ${worksrcpath}/setup.py
        # The protobuf code generators are needed only to regenerate the shipped modules.
        reinplace -E {/^    "(protoc-wheel-0|mypy-protobuf)/d} ${worksrcpath}/pyproject.toml
        foreach f [glob ${worksrcpath}/src/snowflake/snowpark/_internal/proto/generated/ast_pb2.*] {
            file mtime ${f} [clock seconds]
        }
    }
    depends_run-append \
        port:py${python.version}-setuptools \
        port:py${python.version}-wheel \
        port:py${python.version}-snowflake-connector-python \
        port:py${python.version}-typing_extensions \
        port:py${python.version}-yaml \
        port:py${python.version}-cloudpickle \
        port:py${python.version}-protobuf3 \
        port:py${python.version}-dateutil \
        port:py${python.version}-tzlocal
}
