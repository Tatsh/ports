PortSystem          1.0
PortGroup           github 1.0
PortGroup           python 1.0

github.setup        omnilib aiosqlite 0.22.1 v
github.tarball_from archive
name                py-${github.project}
revision            0
categories-append   devel

license             MIT
maintainers         nomaintainer
supported_archs     noarch
platforms           {darwin any}

description         asyncio bridge to the standard sqlite3 module
long_description    aiosqlite provides a friendly, async interface to \
                    sqlite databases. It replicates the standard \
                    sqlite3 module, but with async versions of all the \
                    standard connection and cursor methods, plus \
                    context managers for automatically closing \
                    connections and cursors.

checksums           rmd160  ce9fd030b168c30b6b4c19b1d060dd3c2e0fa897 \
                    sha256  f58e04673453a709e59a04e80f411c327c0555304c210e84272febbcff1de7fd \
                    size    22921

python.versions     310 311 312 313 314

python.pep517_backend   flit

if {${name} ne ${subport}} {
    depends_build-append \
                    port:py${python.version}-typing_extensions
    # Upstream pins flit_core <4 but MacPorts has flit_core 4.x; relax the pin.
    post-patch {
        reinplace "s|flit_core >=3.8,<4|flit_core >=3.8|" ${worksrcpath}/pyproject.toml
    }
}

if {${name} ne ${subport}} {
    test.run            yes
    python.test_framework unittest
    test.cmd            ${python.bin} -m unittest
    test.args           -v aiosqlite.tests
}
