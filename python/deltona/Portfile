PortSystem          1.0

name                deltona
version             1.0
categories          python sysutils
platforms           any
supported_archs     noarch
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         deltona commands for the newest supported Python
long_description    Installs the commands from py314-deltona without a Python version suffix.
homepage            https://github.com/Tatsh/deltona

distfiles

# Newest Python version in the python.versions of py-deltona.
set py_ver          314
set py_branch       3.14

depends_lib         port:py${py_ver}-deltona

use_configure       no

build {}

