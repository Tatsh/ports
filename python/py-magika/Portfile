python.versions         313 314
python.pep517_backend   hatch

if {${subport} ne ${name}} {
    depends_run-append \
                    port:py${python.version}-click \
                    port:py${python.version}-numpy \
                    port:py${python.version}-onnxruntime

    post-destroot {
        # The magika command only tells the user to install the Rust client, which is not
        # packaged; the Python client is installed as magika-python-client.
        delete ${destroot}${python.prefix}/bin/magika
        delete ${destroot}${prefix}/bin/magika-${python.branch}
    }

    livecheck.type  none
}
