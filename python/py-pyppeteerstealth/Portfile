PortSystem          1.0
PortGroup           python 1.0

name                py-pyppeteerstealth
version             0.0.5
platforms           darwin linux freebsd
license             MIT
supported_archs     noarch
categories          python
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         A general collection of robot-evading tweaks for pyppeteer-ng.
long_description    ${description}
homepage            https://github.com/dgtlmoon/pyppeteerstealth
master_sites        pypi:[string index ${python.rootname} 0]/${python.rootname}

distname            pyppeteerstealth-${version}

checksums           rmd160  67bcf80fbb9ad37e734f07c84093f0e66466786d \
                    sha256  4236a92742049aadf31eb6dd6900f93b98c3486a596676d2b1c7925457c9433b \
                    size    10057

python.versions         313 314
python.pep517_backend   poetry

# The old poetry.masonry backend is now poetry-core's.
post-patch {
    reinplace {s/build-backend = "poetry.masonry.api"/build-backend = "poetry.core.masonry.api"/} ${worksrcpath}/pyproject.toml
    reinplace -E {/^requires *=/s/"poetry[^"]*"/"poetry-core"/} ${worksrcpath}/pyproject.toml
}

if {$subport ne $name} {
    livecheck.type      none
    # Upstream declares no dependencies but imports pyppeteer, which pyppeteer-ng provides.
    depends_run-append \
        port:py${python.version}-pyppeteer-ng
    # pyppeteer-install is pyppeteer-ng's, which this package also declares.
    post-destroot {
        delete ${destroot}${python.prefix}/bin/pyppeteer-install \
            ${destroot}${prefix}/bin/pyppeteer-install-${python.branch}
    }
}
