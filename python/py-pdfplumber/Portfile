if {${subport} ne ${name}} {
    # pypdfium2, which bundles a prebuilt PDFium, is not packaged. It is only imported by
    # Page.to_image() (rendering pages to images); text and table extraction do not need it.
    post-patch {
        reinplace "/pypdfium2/d" ${worksrcpath}/requirements.txt
    }
    depends_run-append \
                    port:py${python.version}-pdfminer \
                    port:py${python.version}-Pillow

    livecheck.type  none
}
