if {$subport ne $name} {
    # setup.py imports version.py, which the sdist does not include.
    post-extract {
        set fd [open ${worksrcpath}/version.py w]
        puts ${fd} "def get_version():\n    return '${version}'"
        close ${fd}
    }
    livecheck.type      none
    depends_run-append \
        port:py${python.version}-numpy
}
