# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           python 1.0

name                py-vspyplugin
version             1.4.5
categories-append   multimedia
license             MIT
supported_archs     noarch
platforms           {darwin any}
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Package for writing VapourSynth "plugins" in Python.
long_description    ${description} Filters are written as Python classes processing frames \
                    with NumPy (the CuPy, CUDA and Cython backends need packages MacPorts does \
                    not have).
homepage            https://github.com/Jaded-Encoding-Thaumaturgy/vs-pyplugin
distname            vspyplugin-${version}

checksums           rmd160  50c8dcf99eb532b7ad9ec0c897b51c5648a606d5 \
                    sha256  f1b00d76d86f8df3f4a2b50dc2873ac1083079dbf97fb7aa52f854feb1559388 \
                    size    20924

# Only for the Python that the vapoursynth port is built for.
python.versions     314
python.pep517_backend setuptools

if {${name} ne ${subport}} {
    # vspyplugin 1.4.5 (upstream is archived) imports names that vs-jetpack 3 no longer has: the
    # F_VD, T and T0 type variables, HoldsVideoFormatT and InvalidSubsamplingError (now
    # UnsupportedSubsamplingError).
    patchfiles      patch-vstools-3.diff

    depends_run-append  port:vapoursynth \
                        port:py${python.version}-vsjetpack \
                        port:py${python.version}-numpy

    # setup.py reads requirements.txt, which the sdist does not include.
    post-extract {
        copy ${worksrcpath}/vspyplugin.egg-info/requires.txt ${worksrcpath}/requirements.txt
    }

    # The vspyplugin command only pip-installs the optional backends' packages.
    post-destroot {
        delete ${destroot}${python.prefix}/bin/vspyplugin \
            ${destroot}${prefix}/bin/vspyplugin-${python.branch}
    }
}
