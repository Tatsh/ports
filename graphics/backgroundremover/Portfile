# Use the models installed in ${prefix}/share/backgroundremover, and download any others into
# ~/Library/Application Support/backgroundremover instead of ~/.u2net.
patchfiles          patch-installed-models.diff

post-patch {
    reinplace "s|@PREFIX@|${prefix}|g" \
        ${worksrcpath}/backgroundremover/u2net/detect.py \
        ${worksrcpath}/backgroundremover/cmd/server.py
}

post-destroot {
    # The models are split into 50 MB parts in the repository.
    set models ${destroot}${prefix}/share/${name}
    xinstall -d ${models}
    foreach {model parts} {u2net {u2aa u2ab u2ac u2ad} u2net_human_seg {u2haa u2hab u2hac u2had}} {
        set out [open ${models}/${model}.pth w]
        fconfigure ${out} -translation binary
        foreach p ${parts} {
            set in [open ${worksrcpath}/models/${p} r]
            fconfigure ${in} -translation binary
            fcopy ${in} ${out}
            close ${in}
        }
        close ${out}
    }
    xinstall -m 0644 ${worksrcpath}/models/u2netp.pth ${models}/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE.txt ${worksrcpath}/models/license \
        ${destroot}${prefix}/share/doc/${name}/
}

livecheck.type      none
