PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

github.setup        sammycage plutosvg 0.0.8 v
github.tarball_from archive
revision            0
categories          graphics
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Tiny SVG rendering library in C.
long_description    PlutoSVG is a compact SVG rendering library in C built on PlutoVG. It can \
                    also act as a FreeType hook for rendering OpenType SVG colour fonts.
homepage            https://github.com/sammycage/plutosvg

checksums           rmd160  36e10fd2b9a1f017f6c2d00ae8e9a5e0be0e93ee \
                    sha256  49d5cfe772d3aa10cd4879f2f6e189f5083c08e4c8ea01bf3d5b87c97dfca7d2 \
                    size    116898

compiler.c_standard 2011

depends_build-append port:pkgconfig
depends_lib-append  port:freetype \
                    port:plutovg

post-patch {
    # Use the plutovg port instead of fetching it with FetchContent.
    reinplace {s|find_package(plutovg 1.0.0 QUIET)|find_package(plutovg 1.0.0 REQUIRED)|} \
        ${worksrcpath}/CMakeLists.txt
}

configure.args-append \
                    -DBUILD_SHARED_LIBS=ON \
                    -DPLUTOSVG_ENABLE_FREETYPE=ON \
                    -DPLUTOSVG_BUILD_EXAMPLES=OFF

post-destroot {
    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE README.md ${docdir}
}
