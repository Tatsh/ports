python.default_version  313
python.pep517_backend   hatch

# generate separates the audio into stems with demucs, which upstream lists as the optional stems
# extra (and leaves out on Intel Macs, where PyPI has no PyTorch wheels to go with it).
depends_run-append \
    port:py${python.version}-bascom \
    port:py${python.version}-demucs \
    port:py${python.version}-click \
    port:py${python.version}-librosa \
    port:py${python.version}-mutagen \
    port:py${python.version}-numpy \
    port:py${python.version}-pillow \
    port:py${python.version}-platformdirs \
    port:py${python.version}-pytorch \
    port:py${python.version}-scipy \
    port:py${python.version}-soundfile \
    port:py${python.version}-typing_extensions

# smlab searches the share/smlab directory under the Python prefix, and checks the files against
# the digests it ships.
post-destroot {
    xinstall -m 0644 ${worksrcpath}/man/${name}.1 ${destroot}${prefix}/share/man/man1/
    set weights ${destroot}${python.prefix}/share/${name}
    xinstall -d ${weights}
    foreach w {chart offset} {
        xinstall -m 0644 ${distpath}/${name}-${version}-${w}.pt ${weights}/${w}.pt
    }
}

notes "
Run 'smlab weights' to see every directory that is searched for the models, and what was found.
"

livecheck.type      pypi
