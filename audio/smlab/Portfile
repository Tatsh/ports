PortSystem          1.0
PortGroup           python 1.0

name                smlab
version             0.1.1
categories          audio games python
license             MIT
supported_archs     noarch
platforms           {darwin any}
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Generate StepMania dance-single charts from audio.
long_description    ${description} smlab uses machine learning models to place and select steps.
homepage            https://github.com/Tatsh/smlab

# The trained models are published with each release.
master_sites-append https://github.com/Tatsh/smlab/releases/download/v${version}/:weights
distfiles-append    ${name}-${version}-chart.pt:weights \
                    ${name}-${version}-offset.pt:weights
extract.only        ${distname}${extract.suffix}

checksums           smlab-0.1.1.tar.gz \
