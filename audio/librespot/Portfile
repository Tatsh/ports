PortSystem          1.0
PortGroup           cargo 1.0
PortGroup           github 1.0

github.setup        librespot-org librespot 0.8.0 v
revision            1
github.tarball_from archive
categories          audio net
platforms           darwin linux freebsd
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Open source Spotify client library and Spotify Connect receiver.
long_description    ${description} This installs the librespot speaker daemon with the rodio \
                    (CoreAudio) backend.

checksums           ${distname}${extract.suffix} \
                    rmd160  f78cc13bc3796e46d962dfd9eb953c3461778ace \
                    sha256  0e4922997e1c67d27b3f50dcc388ecb8a3c08eba23b764879071f6e9e8c07ec7 \
                    size    372045

destroot {
    xinstall -m 0755 ${worksrcpath}/target/[cargo.rust_platform]/release/librespot \
        ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}
# The cache directory is owned by the service user, so it is made at activation rather than in the
# destroot: deactivation cannot delete a registered directory owned by another user ("not
# owner"), and the data in it should outlive the port anyway.
post-activate {
    if {![file isdirectory ${prefix}/var/cache/${name}]} {
        xinstall -d -o _librespot -g _librespot ${prefix}/var/cache/${name}
    }
}

add_users           _librespot group=_librespot realname=librespot

startupitem.create  yes
startupitem.user    _librespot
startupitem.group   _librespot
startupitem.executable \
                    ${prefix}/bin/librespot --name MacPorts --cache ${prefix}/var/cache/${name} \
                    --bitrate 320 --enable-volume-normalisation --initial-volume 80 --device-type avr

notes "
Start the Spotify Connect speaker (named MacPorts) with:
    sudo port load ${name}
"

