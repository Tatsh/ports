# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           qt6 1.0

github.setup        dakrk manatools 0.3.0 v
github.tarball_from archive
categories          audio games aqua
platforms           darwin
license             GPL-3
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Tools for Sega Dreamcast AICA sound driver formats.
long_description    ${description} Includes editors for MLT, MPB, MDB and MSB files.

# The mio and sf2cute git submodules.
set mio_commit      8b6b7d878c89e81614d05edca7936de41ccdd2da
set sf2cute_commit  b42f23c75667d414ac024858f5303fb7dc17e0fd
master_sites-append https://github.com/vimpunk/mio/archive/${mio_commit}.tar.gz?dummy=:mio \
                    https://github.com/gocha/sf2cute/archive/${sf2cute_commit}.tar.gz?dummy=:sf2cute
distfiles-append    mio-${mio_commit}.tar.gz:mio \
                    sf2cute-${sf2cute_commit}.tar.gz:sf2cute

checksums           manatools-0.3.0.tar.gz \
                    rmd160  8a47b7724bdb0181d962ba4d8c1c56453273af4c \
                    sha256  2e12503120339d4291f5f7dc79e76ce42255e3f904aba2298e8f3d61cad0759e \
                    size    140684 \
                    mio-8b6b7d878c89e81614d05edca7936de41ccdd2da.tar.gz \
                    rmd160  0ef912d266a799801d6756a8c5f0167836f4f333 \
                    sha256  86248113bb2f1484f9cd44a260fe09beaa911307073c6f21fa9e765588d54b4b \
                    size    33312 \
                    sf2cute-b42f23c75667d414ac024858f5303fb7dc17e0fd.tar.gz \
                    rmd160  093a80a26aa179ab1b1d2da2e8fc96320a94949b \
                    sha256  8b434b9bc74ab0070b495f2d092099efc7fc12d3c2c1c4b673651ad48ce7e36d \
                    size    68402

depends_lib-append  port:libsndfile \
                    port:portaudio

post-extract {
    file delete -force ${worksrcpath}/third_party/mio ${worksrcpath}/third_party/sf2cute
    file rename ${workpath}/mio-${mio_commit} ${worksrcpath}/third_party/mio
    file rename ${workpath}/sf2cute-${sf2cute_commit} ${worksrcpath}/third_party/sf2cute
}

# Keep the vendored sf2cute out of the install set, and add an include it needs.
patchfiles          patch-sf2cute-no-install.diff \
                    patch-sf2cute-cstdint.diff

# yadpcm.cpp uses abs() without including <cstdlib>.
configure.cxxflags-append -include cstdlib

post-patch {
    # mpbgui alone is built as an app bundle, which the shared install rule has no destination
    # for. Install it as a plain executable like the other tools.
    reinplace {s/^	MACOSX_BUNDLE ON$/	MACOSX_BUNDLE OFF/} ${worksrcpath}/src/mpbgui/CMakeLists.txt
    # The section garbage collection and lld flags are for GNU-style linkers.
    reinplace {/add_link_options(-Wl,--gc-sections)/d; /add_link_options(-fuse-ld=lld -Wl,--icf=safe)/d} \
        ${worksrcpath}/cmake/CompilerFlags.cmake
}

compiler.cxx_standard 2020
# Aggregate class template argument deduction and parenthesized aggregate initialization need a
# newer clang than Xcode 15's.
compiler.blacklist-append {clang < 1600}

configure.args-append \
                    -DBUILD_SHARED_LIBS=OFF \
                    -Dmio.installation=OFF \
                    -DUSE_HOST_PORTAUDIO=ON \
                    -DUSE_HOST_SNDFILE=ON

# Internal static libraries linked into the tools; there is no public API.
post-destroot {
    foreach f [glob -nocomplain ${destroot}${prefix}/lib/libguicommon.a ${destroot}${prefix}/lib/libmanatools.a] {
        delete ${f}
    }
}

# Finder-launchable app bundles for the editors, which run the installed programs.
post-destroot {
    foreach {tool title} {fobgui "FOB Editor" mltgui "MLT Editor" mpbgui "MPB Editor" osbgui "OSB Editor"} {
        set app "${destroot}${applications_dir}/manatools/${title}.app/Contents"
        xinstall -d ${app}/MacOS
        ln -s ${prefix}/bin/${tool} ${app}/MacOS/${tool}
        set fd [open ${app}/Info.plist w]
        puts ${fd} "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
<plist version=\"1.0\">
<dict>
    <key>CFBundleExecutable</key><string>${tool}</string>
    <key>CFBundleIdentifier</key><string>org.macports.manatools.${tool}</string>
    <key>CFBundleName</key><string>${title}</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>${version}</string>
    <key>CFBundleVersion</key><string>${version}</string>
    <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>"
        close ${fd}
    }
}
