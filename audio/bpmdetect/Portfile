# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

github.setup        Tatsh bpmdetect 0.8.11 v
github.tarball_from archive

platforms           darwin linux freebsd
license             GPL-2
maintainers         {gmail.com:audvare @Tatsh}
description         Automatic BPM (beats per minute) detection utility.
long_description   Uses SoundTouch for BPM detection, ffmpeg for reading/writing tags, Qt for GUI.
categories          audio
supported_archs     x86_64 arm64

checksums           rmd160  2e10319dec85e6b02eccfc34076d4ceb47a0303c \
                    sha256  d79255c9a3bb11584401b2b7fbf9d4d6ab01a3a0c852b74f1b0aca465928b74a \
                    size    3811215

depends_build       port:cmake \
                    port:kde-extra-cmake-modules
depends_lib         port:qt67-qtbase \
                    port:qt67-qtmultimedia \
                    port:qt67-qttools \
                    port:ffmpeg7 \
                    port:soundtouch

patchfiles          patch-av_dict_get.diff \
                    patch-tests-sstream.diff

# MacPorts: use FHS layout; Qt6 via libexec, ffmpeg/soundtouch via pkg-config
# Install app bundle to Applications/MacPorts (not under prefix)
configure.args-append \
    -DCMAKE_PREFIX_PATH=${prefix}/libexec/qt6 \
    -DNON_PORTABLE_MACOS_BUNDLE=ON \
    -DBUNDLE_INSTALL_PREFIX=/Applications/MacPorts

# Upstream builds its Qt Test suite only with -DBUILD_TESTS=ON; enable it just for the test
# phase so normal installs do not build the tests.
test.run            yes
test.env-append     QT_QPA_PLATFORM=offscreen
test {
    system -W ${build.dir} "${configure.cmd} -DBUILD_TESTS=ON ."
    system -W ${build.dir} "${build.cmd} ${build.pre_args}"
    system -W ${build.dir} "[join ${test.env}] ${prefix}/bin/ctest --output-on-failure"
}
