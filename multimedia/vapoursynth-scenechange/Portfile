maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Scene change detection plugin for VapourSynth.
long_description    ${description} The native filter is built with meson as part of the \
                    Python package.
homepage            https://github.com/Tatsh/scenechange
master_sites        pypi:v/vapoursynth-scenechange
distname            vapoursynth_scenechange-${version}

checksums           rmd160  94e536190c15620d8a8a959acc1be0b09a187031 \
                    sha256  5d1d244e3c23f7d4aced41f45f9dc3c7305bf820bb9fa26bcc20542a93345ddb \
                    size    32922

# Only for the Python that the vapoursynth port is built for.
python.default_version 314
python.pep517_backend hatch

depends_build-append port:meson \
                    port:ninja \
                    port:pkgconfig \
                    port:py${python.version}-packaging
depends_lib-append  port:vapoursynth

# The PyPI meson and ninja packages only provide the commands, which come from the ports.
post-patch {
    reinplace -E {s/"(meson|ninja)>=[^"]*", ?//g} ${worksrcpath}/pyproject.toml
}
