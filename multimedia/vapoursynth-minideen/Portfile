PortGroup           vapoursynth_plugin 1.0

github.setup        dubhatervapoursynth vapoursynth-minideen 2 v
github.tarball_from archive
platforms           darwin linux freebsd
license             ISC
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         MiniDeen spatial denoising filter for VapourSynth.
long_description    MiniDeen replaces every pixel with the average of its neighbourhood, a port \
                    of the a2d method of the AviSynth plugin Deen.

checksums           rmd160  550dbb4ae0d831ae83e9e13902d252c275f9ee16 \
                    sha256  d32ef999894cabc7576e4a4e57d681ceaa229707174a486381435e1da8ab9195 \
                    size    5034

# Upstream is unmaintained and only has the VapourSynth API 3, which the vapoursynth port (R82)
# no longer loads. This ports it to API 4 (VapourSynth4.h), and replaces the
# _mm_extract_epi16/_mm_insert_epi16 loop with variable lane indices, which clang rejects.
patchfiles          patch-api4.diff

configure.args-append --libdir=${prefix}/lib/vapoursynth

post-destroot {
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/readme.rst ${destroot}${prefix}/share/doc/${name}/
}

vapoursynth.test_namespace minideen
