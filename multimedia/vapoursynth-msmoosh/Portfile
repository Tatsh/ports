PortSystem          1.0
PortGroup           github 1.0
PortGroup           vapoursynth_plugin 1.0

github.setup        dubhatervapoursynth vapoursynth-msmoosh 1.1 v
github.tarball_from archive
platforms           darwin linux freebsd
license             GPL-2
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         MSmooth and MSharpen filters for VapourSynth.
long_description    MSmooth is a spatial smoother that doesn't touch edges, MSharpen sharpens only \
                    the edges. Ports of the AviSynth plugins of the same names.

checksums           rmd160  716cbe941ecf30c294248131ee21e7f5be36ab6d \
                    sha256  f49b4a00f141b245040ce1ffce00c79880da0118078d5c8f26d9a654fb028ddc \
                    size    36586

depends_build-append port:autoconf \
                    port:automake \
                    port:libtool

# Upstream is unmaintained and only has the VapourSynth API 3, which the vapoursynth port (R82)
# no longer loads. This ports it to API 4 (VapourSynth4.h).
patchfiles          patch-api4.diff

use_autoreconf      yes
autoreconf.args     -fiv

configure.args-append --libdir=${prefix}/lib/vapoursynth

post-destroot {
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/readme.rst ${destroot}${prefix}/share/doc/${name}/
}

vapoursynth.test_namespace msmoosh
