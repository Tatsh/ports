# A module for other scripts, loaded from mpv's script-modules directory.
post-destroot {
    xinstall -d ${destroot}${prefix}/etc/mpv/script-modules
    xinstall -m 0644 ${worksrcpath}/scroll-list.lua ${destroot}${prefix}/etc/mpv/script-modules/
}
