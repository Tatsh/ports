PortSystem          1.0
PortGroup           github 1.0
PortGroup           meson 1.0
PortGroup           vapoursynth_plugin 1.0

# Selur's fork: the original Hinterwaeldlers/vapoursynth-hqdn3d is unmaintained and API 3 only.
github.setup        Selur vapoursynth-hqdn3d 1.1.2 v
github.tarball_from archive
name                vapoursynth-hqdn3d
platforms           darwin linux freebsd
license             GPL-2
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         hqdn3d (high quality 3D denoiser) filter for VapourSynth.
long_description    ${description} Port of the hqdn3d filter from MPlayer and AviSynth.

checksums           rmd160  d59705f2361b40c0a5f3594b68cd58869ee9ea9a \
                    sha256  79972619101d8034c9df173045f3371e807b79dcefb009689c21213e4693b431 \
                    size    32685

# With python_package off, the plugin goes into the libdir of vapoursynth.pc plus /vapoursynth,
# which the vapoursynth_plugin PortGroup moves to the plugin directory.
configure.args-append -Dpython_package=false

post-destroot {
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/readme.rst ${destroot}${prefix}/share/doc/${name}/
}

vapoursynth.test_namespace hqdn3d
