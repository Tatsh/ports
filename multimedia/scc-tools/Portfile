# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                scc-tools
version             3.5
categories          multimedia textproc
platforms           any
supported_archs     noarch
license             Restrictive
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Tools for the Scenarist Closed Caption (SCC) subtitle format.
long_description    McPoodle's Perl scripts to convert, inspect and repair Scenarist Closed \
                    Caption files.
homepage            https://www.theneitherworld.com/mcpoodle/SCC_TOOLS/DOCS/SCC_TOOLS.HTML
master_sites        https://www.theneitherworld.com/mcpoodle/SCC_TOOLS/
distfiles           SCC_TOOLS.ZIP
dist_subdir         ${name}/${version}
use_zip             yes

checksums           rmd160  29a03fbc949619dbe77d79079345ac4ba69509dc \
                    sha256  dbb7320d239d8c5cb7fa9889eed396e92f5d6588f910da5c13070da521008b9d \
                    size    4001761

depends_run-append  path:bin/perl:perl5

worksrcdir          SOURCE
use_configure       no
build {}

destroot {
    foreach f [glob -directory ${worksrcpath} *.pl] {
        set fd [open ${f} r]
        fconfigure ${fd} -translation auto
        set text [read ${fd}]
        close ${fd}
        set out ${destroot}${prefix}/bin/[file tail ${f}]
        set fd [open ${out} w]
        fconfigure ${fd} -translation lf
        puts -nonewline ${fd} "#!/usr/bin/env perl\n${text}"
        close ${fd}
        file attributes ${out} -permissions 0755
    }
}

livecheck.type      none
