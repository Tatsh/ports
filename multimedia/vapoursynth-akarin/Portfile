# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           boost 1.0
PortGroup           github 1.0
PortGroup           meson 1.0
PortGroup           vapoursynth_plugin 1.0

github.setup        Jaded-Encoding-Thaumaturgy akarin-vapoursynth-plugin 1.5.0 v
github.tarball_from archive
name                vapoursynth-akarin
platforms           darwin linux
license             LGPL-3
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Akarin's VapourSynth plugin: an LLVM-based Expr JIT, Select, PropExpr, Text \
                    and Tmpl.
long_description    ${description} This is the maintained Jaded Encoding Thaumaturgy fork that \
                    vs-jetpack requires. The NVIDIA DLISR and DLVFX filters are Windows-only and \
                    are not built.

checksums           rmd160  61d1ed25da4d2393d8aadb56528bfee1749d5216 \
                    sha256  83852c90feef47510b866b8244af035af00ea6b77118b95697eef362266fcb5b \
                    size    550835

# The expression JIT emits llvm.masked.gather for mirrored horizontal pixel access (x[1,0] with
# boundary=1), which crashes or fails to link in the JIT here. Use the element-wise loads that
# upstream already has for MemorySanitizer builds.
patchfiles          patch-gather-emulation.diff

set llvm_version    20
depends_lib-append  port:llvm-${llvm_version}

compiler.cxx_standard 2020
# Xcode 15's clang lacks parenthesised aggregate initialisation (emplace_back of
# VSFilterDependency). clang 16 has it, and its headers match the system libc++.
compiler.whitelist  macports-clang-16

# The system libc++ has no floating-point std::from_chars, so use Boost.Charconv.
boost.version       1.88
configure.env-append BOOST_ROOT=[boost::install_area]

# Link the shared libLLVM of the llvm port rather than its static archives, and point meson at
# that port's llvm-config.
set llvm_config     ${prefix}/libexec/llvm-${llvm_version}/bin/llvm-config
configure.args-append -Dstatic-llvm=false \
                    -Dboost-charconv=true \
                    --native-file ${workpath}/llvm.ini
# libLLVM.dylib has an @rpath install name.
configure.ldflags-append -Wl,-rpath,${prefix}/libexec/llvm-${llvm_version}/lib
pre-configure {
    set fd [open ${workpath}/llvm.ini w]
    puts ${fd} "\[binaries\]\nllvm-config = '${llvm_config}'"
    close ${fd}
}

# meson.build builds the plugin with install: false (the wheel build hook copies it).
destroot {
    xinstall -d ${destroot}${vapoursynth.plugindir}
    xinstall -m 0755 ${build_dir}/libakarin.dylib ${destroot}${vapoursynth.plugindir}/
}

vapoursynth.test_namespace akarin
