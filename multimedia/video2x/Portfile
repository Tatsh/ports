# patch-includes.diff: include fsutils.h where its functions are used (from Gentoo).
# patch-target-clones.diff: compile the x86-64-v3/v4 clones only where there is IFUNC to dispatch
# them, which Mach-O lacks (from Gentoo, extended to macOS).
# patch-macos.diff: find the executable's directory with _NSGetExecutablePath rather than
# /proc/self/exe, look for models in ${prefix}/share/video2x, and enumerate MoltenVK (a
# portability driver) in --list-devices.
# patch-ffmpeg-link.diff: link FFmpeg by full path (pkg-config's LINK_LIBRARIES); it is not in
# the default library search path here.
patchfiles          patch-ffmpeg-link.diff \
                    patch-includes.diff \
                    patch-target-clones.diff \
                    patch-macos.diff

post-extract {
    foreach {lib commit} [list realesrgan ${realesrgan_commit} rife ${rife_commit} \
            realcugan ${realcugan_commit}] {
        file delete ${worksrcpath}/third_party/lib${lib}_ncnn_vulkan
        move ${workpath}/lib${lib}-ncnn-vulkan-${commit} \
            ${worksrcpath}/third_party/lib${lib}_ncnn_vulkan
    }
}

post-patch {
    reinplace "s|@PREFIX@|${prefix}|" ${worksrcpath}/src/fsutils.cpp
    # The three libraries each define a generate-spirv target.
    # ncnn has dropped the pack8 shader option; the pack8 pipeline is never used on the GPU.
    reinplace "s|if (opt.use_shader_pack8)|if (false)|" \
        ${worksrcpath}/third_party/librife_ncnn_vulkan/src/warp.cpp
    reinplace "s|generate-spirv|generate-spirv-rife|g" \
        ${worksrcpath}/third_party/librife_ncnn_vulkan/src/CMakeLists.txt
    reinplace "s|generate-spirv|generate-spirv-realcugan|g" \
        ${worksrcpath}/third_party/librealcugan_ncnn_vulkan/src/CMakeLists.txt
    # FFmpeg 7, Boost and the build's own headers before ${prefix}/include, which has the headers
    # of the default (newer) ffmpeg port.
    set fd [open ${workpath}/include-first.cmake w]
    puts ${fd} "include_directories(BEFORE SYSTEM ${ffmpeg_prefix}/include)"
    close ${fd}
}

# libvideo2x uses FFmpeg 7 API that FFmpeg 8 removed.
set ffmpeg_prefix   ${prefix}/libexec/ffmpeg7
configure.pkg_config_path-prepend ${ffmpeg_prefix}/lib/pkgconfig
configure.cppflags-delete -I${prefix}/include

compiler.cxx_standard 2017

configure.args-append \
                    -DCMAKE_PROJECT_INCLUDE=${workpath}/include-first.cmake \
                    -DCMAKE_CXX_STANDARD=17 \
                    -Dfmt_DIR=${prefix}/lib/libfmt12/cmake/fmt \
                    -DVIDEO2X_USE_EXTERNAL_NCNN=ON \
                    -DVIDEO2X_USE_EXTERNAL_SPDLOG=ON \
                    -DVIDEO2X_USE_EXTERNAL_BOOST=ON \
                    -DUSE_SYSTEM_NCNN=ON

post-destroot {
    # The ncnn-Vulkan libraries install their headers (and generated shader headers) straight into
    # ${prefix}/include; keep them with the libvideo2x headers that include them.
    set inc ${destroot}${prefix}/include
    foreach f [glob -nocomplain -directory ${inc} -types f *.h] {
        move ${f} ${inc}/libvideo2x/
    }
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 {*}[glob ${worksrcpath}/README.md ${worksrcpath}/LICENSE \
        ${worksrcpath}/NOTICE ${worksrcpath}/CHANGELOG.md] ${destroot}${prefix}/share/doc/${name}/
}
