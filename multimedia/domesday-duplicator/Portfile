github.setup        simoninns DomesdayDuplicator-gui-app ac980a093dced39e4e8ad04fe7c8f0f324d13751
github.tarball_from archive
name                domesday-duplicator
version             2.4.20251210
revision            1
categories          multimedia science aqua
platforms           darwin
license             GPL-3
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Capture software for the Domesday Duplicator 40 MHz USB 3.0 RF sampler.
long_description    ${description} Used to capture LaserDisc and tape RF for the ld-decode and \
                    vhs-decode projects.
homepage            https://github.com/Domesday86/DomesdayDuplicator
dist_subdir         ${name}/${version}

checksums           rmd160  321d368a86b34433183634ac0256174353abc6d7 \
                    sha256  dabc8aec27331e6236d32a4b929d513af5c45b8d2d7451cc16b4f0c7223b22b1 \
                    size    559431

depends_build-append port:pkgconfig
depends_lib-append  port:libusb
qt6.depends_lib-append qtserialport

compiler.cxx_standard 2017

destroot {
    set app [lindex [glob -directory ${build.dir} -type d *.app */*.app */*/*.app] 0]
    set contents "${destroot}${applications_dir}/Domesday Duplicator.app/Contents"
    copy ${app} "${destroot}${applications_dir}/Domesday Duplicator.app"
    # The bundle gets no icon and an Info.plist with empty fields upstream. Make the icon from the
    # PNG sizes the source ships.
    set pngs ${worksrcpath}/tools/DomesdayDuplicator/Graphics/ApplicationIcon
    set iconset ${workpath}/DomesdayDuplicator.iconset
    file mkdir ${iconset}
    foreach {size name} {16 icon_16x16 32 icon_16x16@2x 32 icon_32x32 64 icon_32x32@2x \
            128 icon_128x128 256 icon_128x128@2x 256 icon_256x256} {
        file copy -force ${pngs}/DomesdayDuplicator_${size}x${size}.png ${iconset}/${name}.png
    }
    xinstall -d ${contents}/Resources
    system "/usr/bin/iconutil --convert icns --output [shellescape ${contents}/Resources/DomesdayDuplicator.icns] ${iconset}"
    set plist [shellescape ${contents}/Info.plist]
    foreach {key value} [list CFBundleName "Domesday Duplicator" \
            CFBundleIdentifier com.github.domesday86.DomesdayDuplicator \
            CFBundleIconFile DomesdayDuplicator CFBundleShortVersionString ${version} \
            CFBundleVersion ${version}] {
        system "/usr/libexec/PlistBuddy -c [shellescape "Set :${key} ${value}"] ${plist}"
    }
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}
