# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           vapoursynth_plugin 1.0

github.setup        nlzy vapoursynth-waifu2x-ncnn-vulkan 5 r
github.tarball_from archive
name                vapoursynth-waifu2x-ncnn-vulkan
revision            0
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         waifu2x upscaling and denoising filter for VapourSynth.
long_description    waifu2x 2x upscaling and denoising for VapourSynth, through ncnn on the GPU \
                    with Vulkan (MoltenVK on macOS). Upstream has deprecated it in favour of \
                    vs-mlrt.
supported_archs     x86_64 arm64

# The models are a separate release asset.
set models_distfile models.7z
master_sites-append ${github.homepage}/releases/download/r0.1/:models
distfiles-append    ${models_distfile}:models

checksums           vapoursynth-waifu2x-ncnn-vulkan-5.tar.gz \
                    rmd160  577754bd73332a4f8fddccb2ce81e7719c7729e5 \
                    sha256  cc7bf044b79c7ef7f65a2749f28df5865ed81d69aaa55bb1ebc1bd1a61bb9743 \
                    size    10501 \
                    models.7z \
                    rmd160  cb42492ca9d8fc16a591cb8d2857b07d611c5a7c \
                    sha256  e3b7b0b71ca606031821ac5d63b4ff25ab6874e8521521585de4a308b2f974c9 \
                    size    32544347

# The models are a 7-Zip archive.
extract.only        ${distname}${extract.suffix}
depends_extract-append bin:7za:p7zip
post-extract {
    system -W ${workpath} "7za x -y ${distpath}/${models_distfile}"
    # The archive stores the model directories as owner-only.
    system -W ${workpath} "chmod -R a+rX models-cunet models-upconv_7_anime_style_art_rgb \
        models-upconv_7_photo"
}

depends_build-append \
                    port:vulkan-headers
depends_lib-append  port:ncnn \
                    port:vulkan-loader

# patch-system-ncnn.diff: build against the system ncnn, not the deps/ncnn submodule.
# patch-model-path.diff: look for the models in @MODELDIR@, set below.
# patch-vapoursynth-api4.diff: port the plugin to the VapourSynth API4; VapourSynth R82
# no longer loads API3 plugins.
patchfiles          patch-system-ncnn.diff \
                    patch-vapoursynth-api4.diff \
                    patch-model-path.diff

post-patch {
    # Load the models from ${prefix}/share/${name} rather than from next to the plugin.
    reinplace "s|@MODELDIR@|${prefix}/share/${name}|" ${worksrcpath}/src/vsw2xnvk.cpp
}

configure.args-append \
                    -DVAPOURSYNTH_HEADER_DIR=${prefix}/include/vapoursynth

destroot {
    xinstall -d ${destroot}${vapoursynth.plugindir}
    xinstall ${build.dir}/libvsw2xnvk.dylib ${destroot}${vapoursynth.plugindir}/
    xinstall -d ${destroot}${prefix}/share/${name}
    foreach d {models-cunet models-upconv_7_anime_style_art_rgb models-upconv_7_photo} {
        copy ${workpath}/${d} ${destroot}${prefix}/share/${name}/
    }
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE \
        ${destroot}${prefix}/share/doc/${name}/
}

vapoursynth.test_namespace w2xnvk
