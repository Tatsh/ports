+# AviSynth's TemporalSoften takes a scene change threshold, focus2.TemporalSoften2 only honours the
+# _SceneChange* properties from scd.Detect (and requires them when scenechange is not 0).
+def TemporalSoftenForASTDR(input_clip, radius, chroma_threshold, scenechange):
+    if scenechange > 0:
+        input_clip = input_clip.scd.Detect(thresh=scenechange)
+    return input_clip.focus2.TemporalSoften2(radius=radius, luma_threshold=0, chroma_threshold=chroma_threshold, scenechange=1 if scenechange > 0 else 0, mode=2)
 
 
