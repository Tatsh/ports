PortSystem          1.0
PortGroup           github 1.0
PortGroup           vapoursynth_plugin 1.0

github.setup        dubhatervapoursynth vapoursynth-astdr 4 v
github.tarball_from archive
# The readme gives the licence as "???".
license             Restrictive
platforms           any
supported_archs     noarch
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         ASTDR derainbow functions for VapourSynth.
long_description    ASTDR and ASTDRmc, a port of the ASTDR DeRainbow function v1.78 for AviSynth.

checksums           rmd160  25d00644aad890f45b55247fbac1d33f5135687d \
                    sha256  3907e1d702a14b909ec6d323aef53b460b0bd03f5c76899e5b7112a3d19c9f8e \
                    size    4756

depends_run-append  port:vapoursynth-fft3dfilter \
                    port:vapoursynth-hqdn3d \
                    port:vapoursynth-mvtools \
                    port:vapoursynth-removegrain \
                    port:vapoursynth-scenechange \
                    port:vapoursynth-zsmooth

# FluxSmooth is obsolete and API 3 only; zsmooth's FluxSmoothST is its replacement. The
# TemporalSoften2 of vapoursynth-scenechange takes no scene change threshold but reads the
# properties that scd.Detect sets, so run that first.
patchfiles          patch-zsmooth-scd.diff

use_configure       no
build {}

destroot {
    xinstall -d ${destroot}${vapoursynth.site_packages}
    xinstall -m 0644 ${worksrcpath}/ASTDR.py ${destroot}${vapoursynth.site_packages}/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/readme.rst ${destroot}${prefix}/share/doc/${name}/
}

test {
    system -W ${workpath} \
        "env PYTHONPATH=${worksrcpath} ${vapoursynth.python_bin} -c 'import ASTDR'"
}

notes "
Without exmc=True ASTDR also uses the decross, warp (AWarpSharp2) and motionmask plugins and\
 the adjust module, and ASTDRmc uses ctmf; none of these are packaged yet.
"
