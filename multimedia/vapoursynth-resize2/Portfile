                    kernels and blurs use.

# resize2 links a copy of zimg at a pinned commit with upstream's patch (subprojects/zimg.wrap)
# that adds the blur and custom-kernel support, so the zimg port cannot be used. zimg's
# graphengine submodule is fetched too.
set zimg_commit     1ad1895d5ff0bbe69c61243f9996aede713d1b5f
set ge_commit       cb5b2ce13384ec2491f0c37256ea210034799f69
master_sites-append \
    https://github.com/sekrit-twc/zimg/archive/${zimg_commit}.tar.gz?dummy=:zimg \
    https://github.com/sekrit-twc/graphengine/archive/${ge_commit}.tar.gz?dummy=:graphengine
distfiles-append    zimg-${zimg_commit}.tar.gz:zimg \
                    graphengine-${ge_commit}.tar.gz:graphengine

