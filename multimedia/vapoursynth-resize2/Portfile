compiler.cxx_standard 2017

# Set up subprojects/zimg as meson would from the wrap: the zimg source with graphengine, the
# packagefiles overlay and upstream's 0001.patch (a git diff, hence -p1).
post-extract {
    set zimg ${worksrcpath}/subprojects/zimg
    move ${workpath}/zimg-${zimg_commit} ${zimg}
    delete ${zimg}/graphengine
    move ${workpath}/graphengine-${ge_commit} ${zimg}/graphengine
    foreach f [glob -directory ${worksrcpath}/subprojects/packagefiles/zimg *] {
        if {[file tail ${f}] ne "0001.patch"} {
            copy -force ${f} ${zimg}/
        }
    }
    system -W ${zimg} "patch -p1 < ${worksrcpath}/subprojects/packagefiles/zimg/0001.patch"
}

configure.args-append --wrap-mode=nodownload

# VapourSynth only loads plugins named *.dylib on macOS, while meson names modules *.so.
post-destroot {
    foreach f [glob -nocomplain -directory ${destroot}${vapoursynth.plugindir} *.so] {
        file rename ${f} [file rootname ${f}].dylib
    }
}

post-build {
    foreach f [glob -nocomplain -directory ${build_dir} *.so] {
        file copy -force ${f} [file rootname ${f}].dylib
    }
}

vapoursynth.test_namespace resize2
