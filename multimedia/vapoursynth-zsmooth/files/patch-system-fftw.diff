+// MacPorts: link the fftw-3-single port instead of building the zig fork of FFTW.
+fn linkFftw(m: *std.Build.Module) void {
+    m.addSystemIncludePath(.{ .cwd_relative = "@PREFIX@/include" });
+    m.addLibraryPath(.{ .cwd_relative = "@PREFIX@/lib" });
+    m.linkSystemLibrary("fftw3f", .{});
+    m.linkSystemLibrary("fftw3f_threads", .{});
+}
