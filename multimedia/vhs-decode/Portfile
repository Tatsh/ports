# The launcher's icons are installed in ${prefix}/share/vhs-decode/icons rather than in a top
# level assets directory in site-packages.
post-patch {
    reinplace "s|icon_dir = Path(__file__).resolve().parents\\\[1\\\] / \"assets\" / \"icons\"|icon_dir = Path(\"${prefix}/share/vhs-decode/icons\")|" \
        ${worksrcpath}/vhsdecode/decode_launcher.py
}

post-destroot {
    xinstall -d ${destroot}${prefix}/share/vhs-decode/icons
    foreach f [glob ${worksrcpath}/assets/icons/vhs-decode.*] {
        xinstall -m 0644 ${f} ${destroot}${prefix}/share/vhs-decode/icons/
    }
}

# The decoders are command line tools; decode-launcher is their Qt front end.
app.name            VHS-Decode Launcher
app.executable      ${python.prefix}/bin/decode-launcher
app.icon            assets/icons/vhs-decode.icns

build.env-append    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VHS_DECODE=${version}
destroot.env-append SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VHS_DECODE=${version}

