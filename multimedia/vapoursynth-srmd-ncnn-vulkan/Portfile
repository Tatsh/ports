# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           vapoursynth_plugin 1.0

# r3 with the VapourSynth API4 support of 20261031, which is not tagged yet.
github.setup        Kiyamou VapourSynth-SRMD-ncnn-Vulkan cf69b9721f281ea3c49b5816501cd03f8a7fccc6
version             3.20261031
github.tarball_from archive
name                vapoursynth-srmd-ncnn-vulkan
revision            0
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         SRMD super resolution filter for VapourSynth.
long_description    SRMD 2x to 4x upscaling and denoising for VapourSynth, through ncnn on the \
                    GPU with Vulkan (MoltenVK on macOS). It uses the models of the \
                    srmd-ncnn-vulkan port.
supported_archs     x86_64 arm64

checksums           rmd160  a2baded99ad27c814e5e2933533914fd9ea597b8 \
                    sha256  72b306678025479ce9217f502acda1600ced2bd1fe0578aaefd9e93f3747a099 \
                    size    13187

depends_build-append \
                    port:vulkan-headers
depends_lib-append  port:ncnn \
                    port:vulkan-loader
depends_lib-append  port:srmd-ncnn-vulkan

# patch-system-ncnn.diff: build against the system ncnn, not the deps/ncnn submodule.
# patch-model-path.diff: look for the models in @MODELDIR@, set below.
patchfiles          patch-system-ncnn.diff \
                    patch-model-path.diff

post-patch {
    # Use the models of the srmd-ncnn-vulkan port.
    reinplace "s|@MODELDIR@|${prefix}/share/srmd-ncnn-vulkan|" ${worksrcpath}/src/main.cpp
}

configure.args-append \
                    -DVAPOURSYNTH_INCLUDE_DIR=${prefix}/include/vapoursynth

destroot {
    xinstall -d ${destroot}${vapoursynth.plugindir}
    xinstall -m 0755 ${build.dir}/libsrmdnv.dylib ${destroot}${vapoursynth.plugindir}/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE \
        ${destroot}${prefix}/share/doc/${name}/
}

vapoursynth.test_namespace srmdnv
