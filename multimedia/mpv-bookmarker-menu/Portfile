# Keep the bookmarks in mpv's own user directory (~~home/) rather than a hardcoded ~/.config/mpv.
post-patch {
    reinplace {s|return os.getenv("HOME") .. "/.config/mpv/" .. filename|return mp.command_native({"expand-path", "~~home/" .. filename})|} \
        ${worksrcpath}/bookmarker-menu.lua
}
mpv_plugin.docs     README.md
