github.tarball_from archive
revision            0
categories          multimedia
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Open source 4K UHD, Blu-ray, HD DVD and DVD backup tool.
long_description    freemkv backs up optical discs to MKV files. This installs freemkv.app (its \
                    native macOS GUI) and the freemkv command line tool.
homepage            https://github.com/freemkv/freemkv

# The freemkv crates come from git ([patch.crates-io] in Cargo.toml); point the patch at the
# unpacked repositories instead (as tatsh-overlay does).
set git_crates [list \
    libfreemkv          c0c5fffbc0a2fff8c8f1d8e75279b73f855ab3f5 \
    freemkv-engine      2c2b426c058a03d2140576f891d655eeb5fce6b1 \
    freemkv-keysources  96cf993c36f6143345c9fe00821ac303238b8602 \
    freemkv-unlock      03933fc05ea6c97751b79f44eb19a274d3441c1f \
    freemkv-i18n        47568fa990a5699815654397bbe00a453bfb7d4b]
set i 0
foreach {crate rev} ${git_crates} {
    master_sites-append https://github.com/freemkv/${crate}/archive/${rev}.tar.gz?dummy=:g${i}
    distfiles-append    ${crate}-${rev}.tar.gz:g${i}
    incr i
}

