post-patch {
    foreach {crate rev} ${git_crates} {
        reinplace "s|^${crate} = \{ git = .*|${crate} = \{ path = \"${workpath}/${crate}-${rev}\" \}|" \
            ${worksrcpath}/Cargo.toml
    }
    reinplace {/^source = "git+https:\/\/github.com\/freemkv\//d} ${worksrcpath}/Cargo.lock
}

# The gui feature is the AppKit app on macOS; the same binary is the command line tool.
build.args-append   --bin freemkv --features gui

destroot {
    set bin ${worksrcpath}/target/[cargo.rust_platform]/release/freemkv
    set app ${destroot}${applications_dir}/freemkv.app
    xinstall -d ${app}/Contents/MacOS ${app}/Contents/Resources
    xinstall -m 0644 ${worksrcpath}/macos/Info.plist ${app}/Contents/
    xinstall -m 0755 ${bin} ${app}/Contents/MacOS/freemkv
    # The icon, as macos/bundle.sh makes it.
    set iconset ${workpath}/freemkv.iconset
    file mkdir ${iconset}
    foreach s {16 32 64 128 256 512} {
        system "sips -z ${s} ${s} [shellescape ${worksrcpath}/macos/freemkv.png] --out ${iconset}/icon_${s}x${s}.png"
        set d [expr {${s} * 2}]
        system "sips -z ${d} ${d} [shellescape ${worksrcpath}/macos/freemkv.png] --out ${iconset}/icon_${s}x${s}@2x.png"
    }
    system "iconutil -c icns ${iconset} -o [shellescape ${app}/Contents/Resources/freemkv.icns]"
    ln -s ${applications_dir}/freemkv.app/Contents/MacOS/freemkv ${destroot}${prefix}/bin/freemkv
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}

