PortSystem          1.0
PortGroup           github 1.0
PortGroup           cmake 1.1
PortGroup           qt6 1.0

github.setup        harrypm tbc-tools 3.3.1 v
github.tarball_from archive
revision            0
categories          multimedia
license             GPL-3
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Post-decoding tools for the TBC files of the decode projects.
long_description    tbc-tools processes the TBC files written by vhs-decode, ld-decode and \
                    cvbs-decode: tbc-analyse (a viewer and analyser), tbc-chroma-decoder, \
                    dropout correction, VBI processing, EFM (LaserDisc digital audio) \
                    decoding, disc mapping and stacking, and tbc-video-export.
supported_archs     x86_64 arm64

# Both are git submodules, so they are absent from the GitHub archive.
set ezpwd_rev       62a490c13f6e057fbf2dc6777fde234c7a19098e
set ccdec_rev       3dc59562c20ade687c524d9f4510a55a836ca475
master_sites-append \
    https://github.com/pjkundert/ezpwd-reed-solomon/archive/${ezpwd_rev}.tar.gz?dummy=:ezpwd \
    https://github.com/eshaz/cc_decoder/archive/${ccdec_rev}.tar.gz?dummy=:ccdec
distfiles-append    ezpwd-reed-solomon-${ezpwd_rev}.tar.gz:ezpwd \
                    cc_decoder-${ccdec_rev}.tar.gz:ccdec

checksums           tbc-tools-3.3.1.tar.gz \
