PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           vapoursynth_plugin 1.0

# r3 with the VapourSynth API4 support of 20261025, which is not tagged yet.
github.setup        Kiyamou VapourSynth-RealSR-ncnn-Vulkan 69134e71515b4d4df23bbe673e15d1b221e500d5
version             3.20261025
github.tarball_from archive
name                vapoursynth-realsr-ncnn-vulkan
revision            0
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         RealSR super resolution filter for VapourSynth.
long_description    RealSR (Real-World Super-Resolution) 4x upscaling for VapourSynth, through \
                    ncnn on the GPU with Vulkan (MoltenVK on macOS). It uses the models of the \
                    realsr-ncnn-vulkan port.
supported_archs     x86_64 arm64

checksums           rmd160  fea02c6bc268fecd1a6907a5496203f05d646563 \
                    sha256  d8958a20efacf556ec693120c66017f4fa0912de77f3e4041b4a60906c8818bb \
                    size    13016

depends_build-append \
                    port:vulkan-headers
depends_lib-append  port:ncnn \
                    port:vulkan-loader
depends_lib-append  port:realsr-ncnn-vulkan

# patch-system-ncnn.diff: build against the system ncnn, not the deps/ncnn submodule.
# patch-model-path.diff: look for the models in @MODELDIR@, set below.
patchfiles          patch-system-ncnn.diff \
                    patch-model-path.diff

post-patch {
    # Use the models of the realsr-ncnn-vulkan port.
    reinplace "s|@MODELDIR@|${prefix}/share/realsr-ncnn-vulkan|" ${worksrcpath}/src/main.cpp
}

configure.args-append \
                    -DVAPOURSYNTH_INCLUDE_DIR=${prefix}/include/vapoursynth

destroot {
    xinstall -d ${destroot}${vapoursynth.plugindir}
    xinstall -m 0755 ${build.dir}/librealsrnv.dylib ${destroot}${vapoursynth.plugindir}/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE \
        ${destroot}${prefix}/share/doc/${name}/
}

vapoursynth.test_namespace rsnv
