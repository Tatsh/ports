diff --git CMakeLists.txt CMakeLists.txt
index 20a5197..082e010 100644
--- CMakeLists.txt
+++ CMakeLists.txt
@@ -166,9 +166,30 @@ CPMAddPackage(
     FIND_PACKAGE_ARGUMENTS "COMPONENTS ${LITH_QCORO_DEPENDENCY_MODULES} REQUIRED"
 )
 
-qt_standard_project_setup(REQUIRES 6.10)
-qt_policy(SET QTP0004 NEW)
-qt_policy(SET QTP0005 NEW)
+if(Qt6_VERSION VERSION_GREATER_EQUAL 6.10)
+    qt_standard_project_setup(REQUIRES 6.10)
+else()
+    # Older Qt: the policies that REQUIRES 6.10 would set, where this Qt knows them. The QML
+    # modules live under /qt/qml in the resources (QTP0001).
+    qt_standard_project_setup()
+    foreach(policy QTP0001 QTP0003)
+        if(QT_KNOWN_POLICY_${policy})
+            qt_policy(SET ${policy} NEW)
+        endif()
+    endforeach()
+endif()
+# Qt 6.8 policies; the subdirectory QML files import their parent directory explicitly.
+foreach(policy QTP0004 QTP0005)
+    if(QT_KNOWN_POLICY_${policy})
+        qt_policy(SET ${policy} NEW)
+    endif()
+endforeach()
+# DISCARD_QML_CONTENTS is a Qt 6.8 option of qt_add_qml_module().
+if(Qt6_VERSION VERSION_GREATER_EQUAL 6.8)
+    set(LITH_QML_DISCARD_CONTENTS DISCARD_QML_CONTENTS)
+else()
+    set(LITH_QML_DISCARD_CONTENTS)
+endif()
 get_target_property(QT_MOC_EXECUTABLE Qt::moc IMPORTED_LOCATION)
 get_filename_component(QT_BINARY_PREFIX ${QT_MOC_EXECUTABLE} DIRECTORY)
 get_filename_component(QT_INSTALL_PREFIX ${QT_BINARY_PREFIX} DIRECTORY)
