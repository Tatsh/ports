# A minimal Django site around the app, with a SQLite database, served by Waitress.
post-destroot {
    set site ${destroot}${prefix}/share/${name}/site
    xinstall -d ${site} ${destroot}${prefix}/etc/${name}
    xinstall -m 0644 ${filespath}/site/minchoc_site.py ${filespath}/site/minchoc_urls.py \
        ${filespath}/site/wsgi.py ${site}/
    xinstall -m 0644 ${filespath}/local_settings.py.sample ${destroot}${prefix}/etc/${name}/
    xinstall -m 0755 ${filespath}/minchoc-manage ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/libexec/${name}
    xinstall -m 0755 ${filespath}/minchoc-service ${destroot}${prefix}/libexec/${name}/
    reinplace "s|@PREFIX@|${prefix}|g" ${site}/minchoc_site.py \
        ${destroot}${prefix}/etc/${name}/local_settings.py.sample ${destroot}${prefix}/bin/minchoc-manage \
        ${destroot}${prefix}/libexec/${name}/minchoc-service
    reinplace "s|@PYTHON@|${python.bin}|g" ${destroot}${prefix}/bin/minchoc-manage \
        ${destroot}${prefix}/libexec/${name}/minchoc-service
    xinstall -d -o _minchoc -g _minchoc -m 0750 ${destroot}${prefix}/var/db/${name}
}
destroot.keepdirs   ${destroot}${prefix}/var/db/${name}

add_users           _minchoc group=_minchoc realname=minchoc

post-activate {
    set conf ${prefix}/etc/${name}/local_settings.py
    if {![file exists ${conf}]} {
        set key [exec /usr/bin/openssl rand -hex 32]
        set in [open ${conf}.sample r]
        set text [read ${in}]
        close ${in}
        set out [open ${conf} w 0640]
        puts -nonewline ${out} [string map [list @SECRET_KEY@ ${key}] ${text}]
        close ${out}
        file attributes ${conf} -group _minchoc
    }
    system "su -m _minchoc -c '${prefix}/bin/minchoc-manage migrate --noinput'"
}

startupitem.create  yes
startupitem.user    _minchoc
startupitem.group   _minchoc
startupitem.executable \
                    ${prefix}/libexec/${name}/minchoc-service

notes "
Review ALLOWED_HOSTS in ${prefix}/etc/${name}/local_settings.py and create an account with:
    sudo -u _minchoc minchoc-manage createsuperuser
Then start the server on http://127.0.0.1:8000 with:
    sudo port load ${name}
"
