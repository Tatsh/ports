# configstore (run counts, update checks) keeps its files where xdg-basedir says: make that
# ~/Library/Application Support and ~/Library/Caches instead of ~/.config, ~/.local and ~/.cache.
post-extract {
    reinplace -E {s#path\.join\(homeDirectory, '\.local', '(share|state)'\)#path.join(homeDirectory, 'Library', 'Application Support')#; s#path\.join\(homeDirectory, '\.config'\)#path.join(homeDirectory, 'Library', 'Application Support')#; s#path\.join\(homeDirectory, '\.cache'\)#path.join(homeDirectory, 'Library', 'Caches')#} \
        ${worksrcpath}/node_modules/xdg-basedir/index.js
}
