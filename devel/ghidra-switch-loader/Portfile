# The LZ4 and Zstandard libraries the loader bundles (the versions upstream builds against).
set lz4_version     1.10.2
set zstd_version    1.5.7-1
master_sites-append https://repo1.maven.org/maven2/at/yawk/lz4/lz4-java/${lz4_version}/:lz4 \
                    https://repo1.maven.org/maven2/com/github/luben/zstd-jni/${zstd_version}/:zstd
distfiles-append    lz4-java-${lz4_version}.jar:lz4 \
                    zstd-jni-${zstd_version}.jar:zstd
extract.only        ${distname}${extract.suffix}

