github.setup        claration Impactor 2.7.3 v
github.tarball_from archive
name                impactor
revision            0
categories          devel
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Sideload iOS apps (sign and install IPA files) from a Mac.
long_description    Impactor is an open-source, feature-rich iOS sideloading application. This \
                    installs Impactor.app and the plumesign command line tool.
homepage            https://github.com/claration/Impactor

# Crates from git (not on crates.io), as pinned by Cargo.lock: idevice by rev and android-loader
# (with sysv64 inside it) by branch. Cargo's directory source wants each crate as its own
# top-level directory, so they are added by hand in post-extract.
set idevice_rev     5171e34e3a236842af1160a84d955d037ddca3af
set aloader_rev     dfa86501afca7caa23d5ce15322ac7260d857485
master_sites-append https://github.com/jkcoxson/idevice/archive/${idevice_rev}.tar.gz?dummy=:idevice \
                    https://github.com/Dadoum/android-loader/archive/${aloader_rev}.tar.gz?dummy=:aloader
distfiles-append    idevice-${idevice_rev}.tar.gz:idevice \
                    android-loader-${aloader_rev}.tar.gz:aloader

checksums           ${distname}${extract.suffix} \
                    rmd160  c6a0e51d6a13e64a79ce18d6b203d765db6ac861 \
                    sha256  f8d401c5ed19c8e3117fbf0e4137d6d9d734b545a6a20527e00d096a7eff02c9 \
                    size    4101272 \
                    idevice-${idevice_rev}.tar.gz \
                    rmd160  14a522cd1ce26962f1b2dbcf61af4eedc9e9802e \
                    sha256  95508f7bc137fedc28623d01aa4d034ecd26c133e5c7982b79d9df375b8d62ef \
                    size    463373 \
                    android-loader-${aloader_rev}.tar.gz \
                    rmd160  994f323afdcc245ce5b185f48d4e2ff88ef3643d \
                    sha256  57d56c5159a31cd3bb71ac2cfe84305014b2ba57751cc6327ecaa5e74c56d532 \
                    size    6958

post-extract {
    set reg ${cargo.home}/macports
    foreach {crate src} [list idevice ${workpath}/idevice-${idevice_rev}/idevice \
                             android-loader ${workpath}/android-loader-${aloader_rev} \
                             sysv64 ${workpath}/android-loader-${aloader_rev}/sysv64] {
        copy ${src} ${reg}/${crate}-git
        set fd [open ${reg}/${crate}-git/.cargo-checksum.json w]
        puts ${fd} {{"files":{},"package":null}}
        close ${fd}
    }
    set fd [open ${cargo.home}/config.toml a]
    puts ${fd} "\[source.idevice-git\]"
    puts ${fd} "git = \"https://github.com/jkcoxson/idevice\""
    puts ${fd} "rev = \"${idevice_rev}\""
    puts ${fd} "replace-with = \"macports\""
    puts ${fd} "\[source.android-loader-git\]"
    puts ${fd} "git = \"https://github.com/Dadoum/android-loader\""
    puts ${fd} "branch = \"bigger_pages\""
    puts ${fd} "replace-with = \"macports\""
    close ${fd}
}

build.args-append   --workspace --bins

destroot {
    set target ${worksrcpath}/target/[cargo.rust_platform]/release
    set app ${destroot}${applications_dir}/Impactor.app
    copy ${worksrcpath}/package/macos/Impactor.app ${app}
    delete ${app}/Contents/MacOS/.keep
    xinstall -m 0755 ${target}/plumeimpactor ${app}/Contents/MacOS/Impactor
    foreach key {CFBundleShortVersionString CFBundleVersion} {
        system "/usr/libexec/PlistBuddy -c [shellescape "Set :${key} ${version}"]\
            [shellescape ${app}/Contents/Info.plist]"
    }
    xinstall -m 0755 ${target}/plumesign ${destroot}${prefix}/bin/
    ln -s ${applications_dir}/Impactor.app/Contents/MacOS/Impactor ${destroot}${prefix}/bin/impactor
}

