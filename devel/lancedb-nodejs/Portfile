PortSystem          1.0
PortGroup           cargo 1.0
PortGroup           github 1.0

github.setup        lancedb lancedb 0.30.0 v
github.tarball_from archive
name                lancedb-nodejs
revision            0
categories          devel databases
license             Apache-2
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Native Node.js addon of LanceDB, the serverless vector database.
long_description    {*}${description} npm publishes no build of @lancedb/lancedb for Intel Macs, \
                    so this builds the napi-rs module from the Rust sources and installs it as the \
                    @lancedb/lancedb-darwin-<arch> package that the JavaScript loader of \
                    @lancedb/lancedb looks for. Packages using @lancedb/lancedb link it into their \
                    node_modules.
homepage            https://lancedb.com
supported_archs     x86_64 arm64

checksums           lancedb-0.30.0.tar.gz \
                    rmd160  f1a684aa5cf84ad79bcef684868fd93cb4eb1dfa \
                    sha256  fc5e54c4f8438577a439a2bf0f7b3cbae576cb0a33f7dc31d9297022415e1f82 \
                    size    8753209

# lance's build scripts compile protobuf definitions with protoc.
depends_build-append \
                    port:protobuf3-cpp \
                    port:pkgconfig
# Use the MacPorts Oniguruma (tokenizers) and Zstandard instead of the bundled sources.
depends_lib-append  port:oniguruma6 \
                    port:zstd

# The lockfile still lists the workspace crates as 0.30.0-beta.1; --offline lets cargo bump them.
cargo.offline_cmd   --offline
build.args          -p lancedb-nodejs
build.env-append    PROTOC=${prefix}/bin/protoc \
                    RUSTONIG_SYSTEM_LIBONIG=1 \
                    ZSTD_SYS_USE_PKG_CONFIG=1

set npm_arch        [expr {${configure.build_arch} eq "arm64" ? "arm64" : "x64"}]
set pkg_dir         ${prefix}/lib/node_modules/@lancedb/lancedb-darwin-${npm_arch}

destroot {
    set dest ${destroot}${pkg_dir}
    xinstall -d ${dest}
    xinstall -m 0755 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/liblancedb_nodejs.dylib \
        ${dest}/lancedb.darwin-${npm_arch}.node
    system "install_name_tool -id ${pkg_dir}/lancedb.darwin-${npm_arch}.node \
        ${dest}/lancedb.darwin-${npm_arch}.node"
    # The package.json of the npm platform packages (lancedb.darwin-arm64.node on npm).
    set fd [open ${dest}/package.json w]
    puts ${fd} "\{
  \"name\": \"@lancedb/lancedb-darwin-${npm_arch}\",
  \"version\": \"${version}\",
  \"os\": \[\"darwin\"\],
  \"cpu\": \[\"${npm_arch}\"\],
  \"main\": \"lancedb.darwin-${npm_arch}.node\",
  \"files\": \[\"lancedb.darwin-${npm_arch}.node\"\],
  \"license\": \"Apache-2.0\",
  \"engines\": \{\"node\": \">= 18\"\}
\}"
    close ${fd}
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE \
        ${destroot}${prefix}/share/doc/${name}/
}

