PortSystem          1.0
PortGroup           python 1.0

name                sbclaude
version             0.3.0
categories          devel python
license             MIT
supported_archs     noarch
platforms           {darwin any}
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Run Claude Code in a throwaway Docker container.
long_description    ${description} The host copy of claude is bind-mounted into a Linux \
                    container and run there with no sandbox and no permission prompts.
homepage            https://github.com/Tatsh/sbclaude

checksums           rmd160  3665f1a402f3d76b2ffad8851cd8bd44fa2610ca \
                    sha256  cc33adc6af6eb62413d1b58ef22a03c60e9bfad80f6198d970bf8d77765a9a4f \
                    size    112615

python.default_version  313
python.pep517_backend   hatch

depends_run-append \
    port:docker \
    port:py${python.version}-bascom \
    port:py${python.version}-click \
    port:py${python.version}-docker \
    port:py${python.version}-platformdirs \
    port:py${python.version}-tomlkit \
    port:py${python.version}-typing_extensions

post-destroot {
    xinstall -m 0644 ${worksrcpath}/man/${name}.1 ${destroot}${prefix}/share/man/man1/
}

notes "
sbclaude is written for Linux hosts. It runs the host's claude inside a Linux container, so on\
 macOS set SBCLAUDE_ALLOW_UNSUPPORTED_PLATFORM=1 and pass --claude-binary with a Linux (ELF)\
 build of claude for the container's architecture. The Linux device flags (--usb, --gpu,\
 --wayland and --x11) do nothing on macOS. A Docker daemon is needed, for example from\
 Colima (port install colima).
"

livecheck.type      pypi
