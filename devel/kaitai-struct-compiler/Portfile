# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           java 1.0

name                kaitai-struct-compiler
version             0.11
categories          devel java
license             GPL-3+ Apache-2 MIT
platforms           any
supported_archs     noarch
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Compiler that generates binary format parsers from Kaitai Struct definitions.
long_description    ${description} This installs the upstream prebuilt JVM release, as ksc and \
                    kaitai-struct-compiler.
homepage            https://kaitai.io
master_sites        https://github.com/kaitai-io/kaitai_struct_compiler/releases/download/${version}/
distname            ${name}-${version}
use_zip             yes

checksums           rmd160  bf3ad811c225aeec2652cb2344b31656e95f3dbd \
                    sha256  ff89389d9dc9e770d78a24af328763cb1f8e7b31ce7766c9edf10669a060f2a2 \
                    size    8629571

java.version        1.8+
java.fallback       openjdk21

use_configure       no
build {}

destroot {
    set dest ${destroot}${prefix}/share/java/${name}
    xinstall -d ${dest}
    copy ${worksrcpath}/lib ${dest}/
    if {[file isdirectory ${worksrcpath}/formats]} {
        copy ${worksrcpath}/formats ${dest}/
    }
    set fd [open ${destroot}${prefix}/bin/${name} w]
    puts ${fd} "#!/bin/sh\nexec java -cp '${prefix}/share/java/${name}/lib/*' io.kaitai.struct.JavaMain \"\$@\""
    close ${fd}
    file attributes ${destroot}${prefix}/bin/${name} -permissions 0755
    ln -s ${name} ${destroot}${prefix}/bin/ksc
}

livecheck.type      regex
livecheck.url       https://github.com/kaitai-io/kaitai_struct_compiler/releases
livecheck.regex     {releases/tag/([0-9.]+)"}
