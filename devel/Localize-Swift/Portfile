# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           xcode 1.0

github.setup        marmelroy Localize-Swift 3.2.0
# Release asset returns 403; use source tarball from tag
github.tarball_from tarball

license             MIT
maintainers         {gmail.com:audvare @Tatsh}
description         Swift friendly localization and i18n with in-app language \
                    switching
long_description    ${description}
platforms           macosx

checksums           rmd160  a820e4f29904888d1574a4d6a9bc29fec00f102a \
                    sha256  cb9521a49222e255e9e47ee458c6b6a752181d7decc20dc3ddba9fbdf7f9abbc \
                    size    28076

destroot.pre_args -derivedDataPath ${worksrcpath}/.dd
xcode.configuration Release
xcode.scheme "[string map {- _} ${name}] OSX"
xcode.destroot.type framework
xcode.build.settings    SDKROOT=macosx
xcode.destroot.settings \
    SDKROOT=macosx \
    CODE_SIGN_IDENTITY=- \
    CODE_SIGN_STYLE=Manual \
    ENABLE_HARDENED_RUNTIME=NO \
    SKIP_INSTALL=NO

# Compile and install in one step, for now. See https://trac.macports.org/ticket/57137
build {}

# Upstream's XCTest suite. CODE_SIGNING_ALLOWED=NO keeps xcodebuild from evaluating
# provisioning, which looks up developer accounts in a keychain and crashes when none is
# usable (as root, or over SSH).
test.run            yes
test {
    system -W ${worksrcpath} "/usr/bin/xcodebuild test -project Localize_Swift.xcodeproj -scheme Localize_SwiftTests \
        -destination platform=macOS -derivedDataPath ${workpath}/test-dd \
        MACOSX_DEPLOYMENT_TARGET=${macosx_deployment_target} CODE_SIGN_IDENTITY=- \
        CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER= \
        ENABLE_HARDENED_RUNTIME=NO CODE_SIGNING_ALLOWED=NO"
}
