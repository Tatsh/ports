# go.vendors cannot express GitLab subgroups, so client-go is fetched and placed by hand.
set gitlab_client_version v1.46.0
master_sites-append https://gitlab.com/gitlab-org/api/client-go/-/archive/${gitlab_client_version}/:gitlabclient
distfiles-append    client-go-${gitlab_client_version}.tar.gz:gitlabclient
checksums-append    client-go-${gitlab_client_version}.tar.gz \
                        rmd160  873bed9bd062859540c23fd7fb99f207756322d4 \
                        sha256  5f9e3720c4cd552c040e9fabea7f62dded505f5ae5962986029d324938ff520a \
                        size    781709

post-extract {
    file mkdir ${workpath}/gopath/src/gitlab.com/gitlab-org/api
    file rename ${workpath}/client-go-${gitlab_client_version} \
        ${workpath}/gopath/src/gitlab.com/gitlab-org/api/client-go
}

add_users           _gickup group=_gickup realname=Gickup

destroot {
    xinstall -m 0755 ${worksrcpath}/${name} ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/etc/${name} ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/conf.example.yml ${destroot}${prefix}/etc/${name}/conf.yml.sample
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}

# With a cron entry in its configuration, gickup keeps running and backs up on that schedule.
startupitem.create  yes
startupitem.user    _gickup
startupitem.group   _gickup
startupitem.executable \
                    ${prefix}/bin/${name} ${prefix}/etc/${name}/conf.yml

notes "
Copy ${prefix}/etc/${name}/conf.yml.sample to ${prefix}/etc/${name}/conf.yml, set a cron schedule \
and destinations in it, then start the backup service with:
    sudo port load ${name}
"

test.run            yes
test.target         ./...
