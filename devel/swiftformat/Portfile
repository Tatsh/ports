# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        nicklockwood SwiftFormat 0.64.7
github.tarball_from tarball

name                swiftformat
categories          devel
license             MIT
maintainers         {gmail.com:audvare @Tatsh}

description         Formatter for Swift (CLI only).
long_description    ${description}
homepage            https://github.com/nicklockwood/SwiftFormat

checksums           rmd160  6ad33e51c61d435b1a41a6ccc3f7ba3c5dde22dc \
                    sha256  5cc0321695069dc0da994eab9bae6990019b26929b59cf729fa38e17eda72c2e \
                    size    1948385

use_configure       no

# Newer releases ship an Xcode 16 (objectVersion 70) project that older Xcode cannot read; the
# Swift package has no external dependencies, so build with SwiftPM instead.
build.cmd           /usr/bin/xcrun swift build
build.target
build.args          -c release --disable-sandbox --product ${name}
build.env-append    HOME=${workpath}/home

pre-build {
    file mkdir ${workpath}/home
}

destroot {
    xinstall -m 0755 ${worksrcpath}/.build/release/${name} ${destroot}${prefix}/bin/${name}
}

if {${os.major} < 19} {
    pre-fetch {
        ui_error "${name} @${version} requires OS X 10.15 or later."
        return -code error "incompatible OS X version"
    }
}
