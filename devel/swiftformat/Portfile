# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        nicklockwood SwiftFormat 0.64.7
github.tarball_from tarball

name                swiftformat
categories          devel
license             MIT
maintainers         {gmail.com:audvare @Tatsh}

description         Formatter for Swift (CLI only).
long_description    ${description}
homepage            https://github.com/nicklockwood/SwiftFormat

checksums           rmd160  6ad33e51c61d435b1a41a6ccc3f7ba3c5dde22dc \
                    sha256  5cc0321695069dc0da994eab9bae6990019b26929b59cf729fa38e17eda72c2e \
                    size    1948385

use_configure       no
# XCTest (for the test phase) ships with Xcode, not the Command Line Tools.
use_xcode           yes

# Newer releases ship an Xcode 16 (objectVersion 70) project that older Xcode cannot read; the
# Swift package has no external dependencies, so build with SwiftPM instead.
build.cmd           /usr/bin/xcrun swift build
build.target
build.args          -c release --disable-sandbox --product ${name}
build.env-append    HOME=${workpath}/home

pre-build {
    file mkdir ${workpath}/home
}

destroot {
    xinstall -m 0755 ${worksrcpath}/.build/release/${name} ${destroot}${prefix}/bin/${name}
}

if {${os.major} < 19} {
    pre-fetch {
        ui_error "${name} @${version} requires OS X 10.15 or later."
        return -code error "incompatible OS X version"
    }
}

# Upstream's XCTest suite, via SwiftPM.
test.run            yes
# The git helper tests need a repository, and the CLI tests need a writable cache directory
# (Foundation's home ignores HOME but honours CFFIXED_USER_HOME).
test {
    xinstall -d ${workpath}/home
    set genv "env HOME=${workpath}/home GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=MacPorts GIT_AUTHOR_EMAIL=macports@localhost GIT_COMMITTER_NAME=MacPorts GIT_COMMITTER_EMAIL=macports@localhost"
    system -W ${worksrcpath} "${genv} /usr/bin/git init -q ."
    system -W ${worksrcpath} "${genv} /usr/bin/git config user.name MacPorts"
    system -W ${worksrcpath} "${genv} /usr/bin/git config user.email macports@localhost"
    system -W ${worksrcpath} "${genv} /usr/bin/git add -A"
    system -W ${worksrcpath} "${genv} /usr/bin/git commit -q -m import"
    system -W ${worksrcpath} "${genv} CFFIXED_USER_HOME=${workpath}/home /usr/bin/xcrun swift test --disable-sandbox"
}
