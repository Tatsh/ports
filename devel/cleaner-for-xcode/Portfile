# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           xcode 1.0

if {${os.major} < 20} {
    github.setup        waylybaye XcodeCleaner-SwiftUI cc8c942
    version             3.1.1
    livecheck.type      none
} else {
    github.setup        waylybaye XcodeCleaner-SwiftUI 74e0308
    version             26.7.0
    revision            0
    # Upstream uses an Xcode 16 synchronized-folder project; convert it to a classic
    # project with explicit file references so Xcode 15 can build it.
    patchfiles          patch-xcode15-project.diff
}

name                cleaner-for-xcode
categories          devel aqua
license             Restricted
maintainers         {gmail.com:audvare @Tatsh}

description         This app helps you to make your Xcode faster by removing \
                    unwanted and deprecated files.
long_description    ${description}

if {${os.major} >= 20} {
    checksums           rmd160  84cc300d46bfdad00eaef4538d75ba3126e2e9f4 \
                        sha256  d2bdc68f1f71943e3ef5999c08c29adcb03388071f05a39ef4e586917fda4017 \
                        size    3284952
} else {
    checksums           rmd160  bb90fbe23852eb579d60ec89e9a4858a0e8e62d3 \
                        sha256  9b78e03e67a177aea561b7b47dd45a39932345659f007e2bb908d3e45d95d416 \
                        size    1465192
}

xcode.target        "Cleaner for Xcode"
xcode.configuration Release
xcode.build.settings    SDKROOT=macosx
# actool cannot write GeneratedAssetSymbols.* during destroot ("Operation not
# permitted"); the app does not use generated asset symbols.
xcode.destroot.settings \
    SDKROOT=macosx \
    CODE_SIGN_IDENTITY=- \
    CODE_SIGN_STYLE=Manual \
    ASSETCATALOG_COMPILER_GENERATE_ASSET_SYMBOLS=NO

if {${os.major} < 19} {
    pre-fetch {
        ui_error "${name} @${version} requires macOS 10.15 or later."
        return -code error "incompatible OS X version"
    }
}

# Compile and install in one step, for now. See https://trac.macports.org/ticket/57137
build {}
