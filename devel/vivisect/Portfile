# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           python 1.0

name                vivisect
version             1.3.2
revision            1
platforms           darwin linux freebsd
license             Apache-2
categories          devel python
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Pure python disassembler, debugger, emulator, and static analysis framework.
long_description    ${description}
homepage            https://vivisect.readthedocs.io/en/latest/
master_sites        pypi:[string index ${python.rootname} 0]/${python.rootname}

distname            vivisect-${version}

checksums           rmd160  5faa675f75da247e5d266a3cc959d932f37ab38f \
                    sha256  510af2678686544af9bd12c49664f044db608b787a08fcf3ab99fe139f2dba8f \
                    size    4330377

# A --host option for vivserver, so that the service can listen on 127.0.0.1 only.
patchfiles          patch-server-host.diff

python.default_version  313
python.pep517_backend   setuptools

depends_run-append \
    port:py${python.version}-asn1 \
    port:py${python.version}-asn1-modules \
    port:py${python.version}-cxxfilt \
    port:py${python.version}-msgpack \
    port:py${python.version}-pycparser

# vivserver shares a directory of .viv workspaces with remote vivisect clients. As a service it
# runs as its own user on 127.0.0.1 (it has no authentication).
set data_dir        ${prefix}/var/db/vivserver

add_users           _vivserver group=_vivserver realname=Vivisect\ server home=${data_dir}

post-destroot {
    xinstall -d -m 0750 -o _vivserver -g _vivserver ${destroot}${data_dir}
}
destroot.keepdirs-append ${destroot}${data_dir}

startupitem.create  yes
startupitem.name    vivserver
startupitem.user    _vivserver
startupitem.group   _vivserver
startupitem.logfile ${prefix}/var/log/vivserver.log
startupitem.executable \
                    ${prefix}/bin/vivserver --host 127.0.0.1 --port 16500 ${data_dir}

notes "
To share workspaces with vivserver, put the .viv files in ${data_dir} and load its service:
  sudo port load ${name}
It listens on 127.0.0.1:16500 only; it has no authentication.
"
