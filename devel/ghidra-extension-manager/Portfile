github.setup        antoniovazquezblanco GhidraExtensionManager 0.3.4 v
github.tarball_from archive
name                ghidra-extension-manager
license             Apache-2
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Ghidra extension to discover, install and update other Ghidra extensions.
long_description    ${description}

checksums           rmd160  9b92bddc54ce1bb070a4c8c3bde364a2fc2c7d4f \
                    sha256  928c0508cf6a2939e2840af1695b65fcb1bc156ce6f6cc8d5fe6cc74d8cec6a4 \
                    size    3965181

ghidra_extension.name GhidraExtensionManager

patchfiles          patch-0.3.2-catalog-in-user-settings.diff \
                    patch-0.3.2-no-self-update.diff
patch.pre_args-replace -p0 -p1

post-patch {
    set fd [open ${worksrcpath}/src/main/java/extensionmanager/ExtensionManagerVersion.java w]
    puts ${fd} "package extensionmanager;\n\npublic class ExtensionManagerVersion \{\n    public static final String GIT_VERSION = \"v${version}\";\n\}"
    close ${fd}
    file delete -force ${worksrcpath}/doc ${worksrcpath}/README.md
}

notes "
Extensions installed from the extension manager go into Ghidra's per-user directory\
(~/Library/ghidra), not into this installation, and are not known to MacPorts.
"
