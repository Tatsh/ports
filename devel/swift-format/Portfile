# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

# swift-format is released per Swift train and each release sets a minimum swift-tools-version, so
# the newest usable release depends on the Swift that ships with the newest Xcode for this macOS:
#
#   macOS 13 (Xcode 15.2, Swift 5.9) -> 602.0.0, the last release with swift-tools-version 5.9
#   macOS 14 and later (Xcode 16+, Swift 6.0+) -> 604.0.0, which needs swift-tools-version 6.0
#
# Only the macOS 13 combination is tested; the dependency versions for each branch are the newest
# ones SwiftPM resolves for that toolchain.
if {${os.major} >= 23} {
    set swift_format_version    604.0.0
    set swift_syntax_version    604.0.0
    set swift_markdown_version  0.9.0
    set swift_cmark_version     0.9.0
    set argument_parser_version 1.8.2
} else {
    set swift_format_version    602.0.0
    set swift_syntax_version    602.0.0
    set swift_markdown_version  0.7.1
    set swift_cmark_version     0.9.0
    set argument_parser_version 1.7.2
}

github.setup        swiftlang swift-format ${swift_format_version}
github.tarball_from archive
categories          devel
license             Apache-2
platforms           macosx
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Formatter and linter for Swift source code.
long_description    ${description} This is the formatter maintained by the Swift project itself, \
                    which follows the Swift API Design Guidelines. It is unrelated to the \
                    swiftformat port.

# SwiftPM cannot resolve dependencies without network access, so each one is a distfile and the
# build uses the package's own SWIFTCI_USE_LOCAL_DEPS mode, which expects them checked out as
# siblings of the source directory.
master_sites-append https://github.com/swiftlang/swift-syntax/archive/${swift_syntax_version}:syntax \
                    https://github.com/swiftlang/swift-markdown/archive/${swift_markdown_version}:markdown \
                    https://github.com/swiftlang/swift-cmark/archive/${swift_cmark_version}:cmark \
                    https://github.com/apple/swift-argument-parser/archive/${argument_parser_version}:argparse

set swift_syntax_distfile    swift-syntax-${swift_syntax_version}.tar.gz
set swift_markdown_distfile  swift-markdown-${swift_markdown_version}.tar.gz
set swift_cmark_distfile     swift-cmark-${swift_cmark_version}.tar.gz
set argument_parser_distfile swift-argument-parser-${argument_parser_version}.tar.gz

distfiles-append    ${swift_syntax_distfile}:syntax \
                    ${swift_markdown_distfile}:markdown \
                    ${swift_cmark_distfile}:cmark \
                    ${argument_parser_distfile}:argparse

if {${os.major} >= 23} {
    checksums       ${distname}${extract.suffix} \
                    rmd160  bd475c5882dc301128a310bf2764a577a542b057 \
