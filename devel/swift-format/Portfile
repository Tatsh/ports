# Package.swift looks for ../swift-syntax, ../swift-markdown and ../swift-argument-parser, and
# swift-markdown looks for ../cmark.
post-extract {
    move ${workpath}/swift-syntax-${swift_syntax_version} ${workpath}/swift-syntax
    move ${workpath}/swift-markdown-${swift_markdown_version} ${workpath}/swift-markdown
    move ${workpath}/swift-cmark-${swift_cmark_version} ${workpath}/cmark
    move ${workpath}/swift-argument-parser-${argument_parser_version} ${workpath}/swift-argument-parser
}

use_configure       no
# The Swift toolchain ships with Xcode, not with the Command Line Tools.
use_xcode           yes

# MacPorts headers conflict with the SDK headers that the SwiftPM build system uses.
compiler.cpath

build.cmd           /usr/bin/xcrun swift build
build.target
build.args          -c release --disable-sandbox --product ${name}
# SwiftPM writes caches under HOME, and SWIFTCI_USE_LOCAL_DEPS makes Package.swift use the
# dependencies extracted next to the source instead of fetching them.
build.env-append    HOME=${workpath}/home \
                    SWIFTCI_USE_LOCAL_DEPS=1

pre-build {
    file mkdir ${workpath}/home
}

destroot {
    xinstall -m 0755 ${worksrcpath}/.build/release/${name} ${destroot}${prefix}/bin/${name}
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/LICENSE.txt ${destroot}${prefix}/share/doc/${name}/
    xinstall -m 0644 {*}[glob ${worksrcpath}/Documentation/*.md] \
        ${destroot}${prefix}/share/doc/${name}/
}

if {${os.major} < 22} {
    pre-fetch {
        ui_error "${name} requires macOS 13 or later."
        return -code error "incompatible macOS version"
    }
}
