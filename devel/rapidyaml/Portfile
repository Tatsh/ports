github.setup        biojppm rapidyaml 0.12.1 v
# The release archive carries the c4core submodule; the tag archive does not.
github.tarball_from releases
distname            ${name}-${version}-src
use_xz              no
extract.suffix      .tgz
revision            0
categories          devel textproc
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Fast YAML parser and emitter library for C++.
long_description    Rapid YAML (ryml) is a C++ library to parse and emit YAML, and do it fast. It \
                    parses in place and keeps the tree in a flat arena.
homepage            https://github.com/biojppm/rapidyaml

checksums           rmd160  e93d3149121a88fe0e69a0911c3aaf7170957ace \
