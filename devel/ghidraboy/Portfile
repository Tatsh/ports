# Upstream generates extension.properties from its Gradle build.
post-extract {
    set fd [open ${worksrcpath}/extension.properties w]
    puts ${fd} "name=GhidraBoy\ndescription=Support for Sharp SM83 / Game Boy\nauthor=Gekkio\ncreatedOn=2025-08-30\nversion=0"
    close ${fd}
}
