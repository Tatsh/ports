# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           nodejs 1.0

name                vscode-vsce
version             4.1.1
revision            0

license             MIT BSD Apache-2 ISC
description         VS Code extension manager for extension developers.
long_description    {*}${description}
homepage            https://github.com/microsoft/vscode-vsce

# The tarball was resolved on Linux, so it has npm's Linux builds of the keyring (used to store
# publisher tokens) and vsce-sign; use the macOS builds of the same versions instead.
supported_archs     x86_64 arm64
set npm_arch        [expr {${configure.build_arch} eq "arm64" ? "arm64" : "x64"}]
set platform_pkgs   [list @napi-rs/keyring 1.3.0 @vscode/vsce-sign 2.0.8]
set i 0
foreach {pkg ver} ${platform_pkgs} {
    set dir         [file tail ${pkg}]-darwin-${npm_arch}
    master_sites-append https://registry.npmjs.org/${pkg}-darwin-${npm_arch}/-/:p${i}
    distfiles-append    ${dir}-${ver}.tgz:p${i}
    incr i
}
extract.only        ${distname}${extract.suffix}

checksums           ${distname}${extract.suffix} \
                    rmd160  89dc9c6783ce854d7a9c3c0fa7879aae8905a95f \
                    sha256  5a4c274cab7d9c7d35f4b119ce2f3dc35f43e3f194e614c109cc5762db34adec \
                    size    9848916
if {${npm_arch} eq "arm64"} {
    checksums-append \
                    keyring-darwin-arm64-1.3.0.tgz \
                    rmd160  4028da5be7367d8165a7b133a7d54812974c6491 \
                    sha256  b57f9a3136ab0e74d570370facf26fd0aafaceab41336853edffccb250b0a959 \
                    size    240228 \
                    vsce-sign-darwin-arm64-2.0.8.tgz \
                    rmd160  a7455dbdb41c920090f36fb80fcbd987ccfb27c7 \
                    sha256  ae075ca7aad20a2a13b77951a4f48051602a040cfac7142f7f3e6cae4f572ccb \
                    size    6330717
} else {
    checksums-append \
                    keyring-darwin-x64-1.3.0.tgz \
                    rmd160  6537537607b8f9dc72947f4914d7c834ca48dd65 \
                    sha256  962dc87ae7e6dfa5c496ee0c61ff0949a22d2c46b23805e0908a04ed4185ea53 \
                    size    254571 \
                    vsce-sign-darwin-x64-2.0.8.tgz \
                    rmd160  d103568c7fde3a1851dd8e1fb7f81257759535c2 \
                    sha256  a2a0f94de1a4e5a89296a9e6ae845815df0321ae35aa0db97326ccd1d16ec4a9 \
                    size    6765228
}

post-extract {
    set nm ${worksrcpath}/node_modules
    foreach {pkg ver} ${platform_pkgs} {
        set scope       [file dirname ${pkg}]
        set dir         [file tail ${pkg}]-darwin-${npm_arch}
        delete {*}[glob -nocomplain -type d ${nm}/${scope}/[file tail ${pkg}]-linux-*]
        file mkdir ${nm}/${scope}/${dir}
        system -W ${nm}/${scope}/${dir} \
            "/usr/bin/tar -xzf [shellescape ${distpath}/${dir}-${ver}.tgz] --strip-components 1"
    }
}

nodejs.bins         {vsce node_modules/@vscode/vsce/vsce}
