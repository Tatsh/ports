ghidra_extension.name GhidraRetroMachines

# The extension ships SnakeYAML in lib/, as upstream's own build does. Build it from its source jar.
pre-build {
    set jenv [ghidra_extension::java_env]
    set jbin [option java.home]/bin
    set src ${workpath}/snakeyaml-src
    file mkdir ${src} ${workpath}/snakeyaml-classes ${worksrcpath}/lib
    system -W ${src} "/usr/bin/unzip -q ${distpath}/snakeyaml-${snakeyaml_ver}-sources.jar"
    fs-traverse f [list ${src}] {
        if {[file extension ${f}] eq ".java"} {
            lappend sources ${f}
        }
    }
    set fd [open ${workpath}/snakeyaml-sources.txt w]
    puts ${fd} [join ${sources} \n]
    close ${fd}
    system "${jenv} ${jbin}/javac --release 17 -encoding UTF-8 -proc:none -nowarn\
        -d ${workpath}/snakeyaml-classes @${workpath}/snakeyaml-sources.txt"
    system "${jenv} ${jbin}/jar --create --file ${worksrcpath}/lib/snakeyaml-${snakeyaml_ver}.jar\
        -C ${workpath}/snakeyaml-classes ."
}

# Upstream's Gradle build compiles the charset maps and the machine and game descriptors in
# machines/ with the build-only tools/gdtbuilder.
post-build {
    set jenv [ghidra_extension::java_env]
    set jbin [option java.home]/bin
    set release [ghidra_extension::property application.java.compiler]
    set tools ${workpath}/gdtbuilder
    file mkdir ${tools} ${worksrcpath}/data/games ${worksrcpath}/data/machines
    set cp [ghidra_extension::classpath]
    system -W ${worksrcpath} "${jenv} ${jbin}/javac --release ${release} -d ${tools} -encoding UTF-8\
        -proc:none -nowarn -classpath '${cp}' [join [glob ${worksrcpath}/tools/gdtbuilder/src/main/java/gdtbuilder/*.java]]"
    set run "${jenv} ${jbin}/java -Djava.awt.headless=true -cp '${tools}:${cp}'"
    set gen machines/generated
    system -W ${worksrcpath} "${run} gdtbuilder.PetsciiCompiler ${gen}/petscii.yaml data/petscii.map"
    system -W ${worksrcpath} "${run} gdtbuilder.ScreencodeCompiler ${gen}/petscii.yaml\
        ${gen}/screencode.yaml data/screencode.map"
    foreach yaml [glob ${worksrcpath}/machines/*.yaml] {
        set n [file rootname [file tail ${yaml}]]
        system -W ${worksrcpath} "${run} gdtbuilder.GdtBuilder machines/${n}.yaml data/machines/${n}.gdt"
        system -W ${worksrcpath} "${run} gdtbuilder.MapCompiler machines/${n}.yaml data/machines/${n}.map"
    }
    foreach yaml [glob ${worksrcpath}/machines/games/*.yaml] {
        set n [file rootname [file tail ${yaml}]]
        system -W ${worksrcpath} "${run} gdtbuilder.GameCompiler machines/games/${n}.yaml data/games/${n}.gmap"
    }

    # RetroCharsetProvider loads the charset maps from the classpath.
    set res ${workpath}/charset-resources
    file mkdir ${res}/retromachines/charset
    file copy -force ${worksrcpath}/data/petscii.map ${worksrcpath}/data/screencode.map ${res}/retromachines/charset/
    system -W ${worksrcpath} "${jenv} ${jbin}/jar --update --file lib/[option ghidra_extension.name].jar\
        -C ${res} retromachines"

    # The descriptor fingerprint upstream ships beside them.
    system -W ${worksrcpath}/machines "/usr/bin/find . -type f | /usr/bin/sed 's|^\\./||' |\
        LC_ALL=C /usr/bin/sort | /usr/bin/xargs /usr/bin/shasum -a 256 |\
        LC_ALL=C /usr/bin/sort > ../data/descriptor-sources.sha256"

    # Only what upstream's own distribution ships; the rest is repository and build material.
    foreach f [glob -directory ${worksrcpath} *] {
        if {[file tail ${f}] ni {data extension.properties ghidra_scripts lib LICENSE Module.manifest NOTICE README.md}} {
            file delete -force ${f}
        }
    }
}
