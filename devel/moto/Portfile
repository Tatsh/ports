    port:py${python.version}-flask \
    port:py${python.version}-flask-cors

# The test suite takes hours and needs Docker for the Lambda, Batch and ECS backends.

add_users           _moto group=_moto realname=Moto

# Run the standalone server, which mocks the AWS APIs over HTTP for any client.
startupitem.create  yes
startupitem.user    _moto
startupitem.group   _moto
startupitem.executable \
                    ${prefix}/bin/moto_server -H 127.0.0.1 -p 5050

notes "
Start the mock AWS server on http://127.0.0.1:5050 with:
    sudo port load ${name}
"
