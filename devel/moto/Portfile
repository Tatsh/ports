categories          devel python
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         A library that allows you to easily mock out tests based on AWS infrastructure.
long_description    ${description}
homepage            https://github.com/getmoto/moto
master_sites        pypi:[string index ${python.rootname} 0]/${python.rootname}

distname            moto-${version}

checksums           rmd160  e98ed246d7721f7e38dd20ce4b6b92bbe460bcf2 \
                    sha256  391857257d5dac144334013c2c10e599def5f0562f553e979160140bd7bd9cf6 \
                    size    9249364

python.default_version  313
python.pep517_backend   setuptools

depends_run-append \
    port:py${python.version}-boto3 \
    port:py${python.version}-botocore \
    port:py${python.version}-cryptography \
    port:py${python.version}-requests \
    port:py${python.version}-xmltodict \
