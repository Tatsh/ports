# Look for the default rules and signatures in the installed data directory rather than next to the
# package.
post-patch {
    reinplace "s|return Path(__file__).resolve().parent.parent|return Path('${prefix}/share/${name}')|" \
        ${worksrcpath}/capa/main.py
}

post-destroot {
    set data ${destroot}${prefix}/share/${name}
    xinstall -d ${data}/rules ${data}/sigs
    system "/bin/cp -R ${workpath}/capa-rules-${version}/. ${data}/rules/"
    foreach f [glob ${worksrcpath}/sigs/*.sig] {
        xinstall -m 0644 ${f} ${data}/sigs/
    }
}

notes "
MacPorts has protobuf 4, so capa's protobuf output format (which needs protobuf 5) is unavailable.
"
