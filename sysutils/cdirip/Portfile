PortSystem          1.0

name                cdirip
version             0.6.2
categories          sysutils
platforms           darwin linux freebsd
license             Restrictive
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Convert DiscJuggler CDI images to ISO, BIN/CUE and WAV tracks.
long_description    ${description} Written by DeXT.
homepage            https://web.archive.org/web/20091027063725/http://es.geocities.com/dextstuff/cdirip/down_cdi.html
master_sites        https://web.archive.org/web/20091027063725/http://es.geocities.com/dextstuff/cdirip/
distfiles           cdirip062-src.zip
use_zip             yes
extract.mkdir       yes

checksums           rmd160  6575a3fdd3c9ccedbc07cb5b8dd12920924562f9 \
                    sha256  dd2e7be9ef971c942e32d880f1e64882f54eac9d13f0e8818e49dd5a76dd0d56 \
                    size    13909

# Missing POSIX headers and declarations.
patchfiles          patch-posix.diff

use_configure       no

build {
    system -W ${worksrcpath} "${configure.cc} [get_canonical_archflags cc] ${configure.cflags} ${configure.ldflags} -o cdirip cdirip.c buffer.c cdi.c common.c audio.c -lm"
}

destroot {
    xinstall -m 0755 ${worksrcpath}/cdirip ${destroot}${prefix}/bin/
}

livecheck.type      none
