# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        adoxa regdump r1
github.tarball_from archive
version             20190209
categories          sysutils
platforms           darwin linux freebsd
license             Restrictive/Distributable
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Dump Windows registry hives as text, one line per value.
long_description    ${description}
distname            r1
dist_subdir         ${name}/${version}

checksums           rmd160  6ce1c4923bdf8f29afd81d54c6e5eaa3fde79401 \
                    sha256  a3dba7a6a30b9256f538159b8f86f1b21f515a0ce1da495abd4558c3ee5992a1 \
                    size    5774

use_configure       no

build {
    system -W ${worksrcpath} "${configure.cc} [get_canonical_archflags cc] ${configure.cflags} ${configure.ldflags} -o regdump regdump.c"
}

destroot {
    xinstall -m 0755 ${worksrcpath}/regdump ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}

livecheck.type      none
