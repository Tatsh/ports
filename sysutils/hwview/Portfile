PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

github.setup        Tatsh hwview 0.0.3 v
github.tarball_from archive

platforms           darwin freebsd
license             GPL-2
maintainers         {gmail.com:audvare @Tatsh}
description         Hardware information utility, inspired by Redmond.
long_description    {Cross-platform hardware viewer: devices by type/connection/driver, resources, export/import; optional CLI-only build.}
categories          sysutils
supported_archs     x86_64 arm64

checksums           rmd160  f98774051ed2de75a147308886e196aa10926d80 \
                    sha256  f9035bcb8ac25c594a62857aa1cc4779b57873139268b795cb393c9ad151dc3f \
                    size    5849027

depends_lib         port:qt67-qtbase

# C++23 and <expected> require Clang 16+ with libc++ 16+
depends_build-append port:clang-16
configure.compiler  macports-clang-16
compiler.cxx_standard       2023
cmake.set_cxx_standard      yes
cmake.build_type            Release

# MacPorts: use FHS-style layout and find Qt6 via libexec
# Install app bundle to Applications/MacPorts (not under prefix)
configure.env-append \
    CMAKE_PREFIX_PATH=${prefix}/libexec/qt6
configure.args-append \
    -DNON_PORTABLE_MACOS_BUNDLE=ON \
    -DBUNDLE_INSTALL_PREFIX=/Applications/MacPorts
