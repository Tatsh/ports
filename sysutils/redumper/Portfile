# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

github.setup        superg redumper 773 b
github.tarball_from archive
categories          sysutils
platforms           darwin
license             GPL-3
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Low level CD and DVD dumper utility.
long_description    ${description}

checksums           rmd160  8d56f80f732a45f9855f923ae5c7525cccb1995d \
                    sha256  6f096cbc5fd9fd3f227b1f0536e5ebdf88c1dddada40605ca887f6b69fac2bf1 \
                    size    261715

depends_build-append port:ninja

# The sources are C++20 modules, which need a recent clang with clang-scan-deps and the Ninja
# generator.
cmake.generator     Ninja
compiler.cxx_standard 2020
compiler.blacklist-append {clang < 1700} {macports-clang-1[0-9]} {macports-clang-2[01]}
compiler.whitelist  macports-clang-22

# std::format and friends need a newer libc++ than the macOS 13 SDK's, and macOS 13.3 or later.
if {${os.platform} eq "darwin" && ${os.major} == 22} {
    configure.sdk_version 14
    macosx_deployment_target 13.3
}
configure.cxxflags-append -fexperimental-library

# The tests fetch googletest; leave them out of the build.
post-patch {
    reinplace -E {/^enable_testing/d; s/^add_subdirectory\(.tests.\)$//} ${worksrcpath}/CMakeLists.txt
}

# Upstream's clang-tidy targets read the test directory's build targets. The bundled LLVM libc++
# that the macOS install rules copy in is not used here.
configure.args-append \
                    -DCLANG_TIDY=OFF \
                    -DREDUMPER_VERSION_BUILD=${version} \
                    -DCMAKE_CXX_COMPILER_CLANG_SCAN_DEPS=${prefix}/bin/clang-scan-deps-mp-22

destroot {
    xinstall -m 0755 ${build.dir}/redumper ${destroot}${prefix}/bin/
}

livecheck.type      regex
livecheck.url       https://github.com/superg/redumper/tags
livecheck.regex     {tags/b([0-9]+)"}
