post-patch {
    reinplace "s|^libfreemkv = \{ git = \[^,\]*, tag = \[^,\]*,|libfreemkv = \{ path = \"${workpath}/libfreemkv-${libfreemkv_rev}\",|" \
        ${worksrcpath}/crates/freemkv-flash/Cargo.toml
    reinplace {/^source = "git+https:\/\/github.com\/freemkv\//d} ${worksrcpath}/Cargo.lock
}

build.args-append   --package=freemkv-flash --package=freemkv-fw \
                    --package=freemkv-flash-gui --package=freemkv-fw-gui

# GUI binary, the command line tool bundled with it, and the app name.
set apps [list freemkv-flash-gui freemkv-flash {freemkv Flash} \
               freemkv-fw-gui freemkv-fw {freemkv Modify}]

destroot {
    set out ${worksrcpath}/target/[cargo.rust_platform]/release
    foreach bin {freemkv-crossflash freemkv-flash freemkv-fw} {
        xinstall -m 0755 ${out}/${bin} ${destroot}${prefix}/bin/
    }
    # As macos/bundle.sh assembles them.
    foreach {gui cli appname} ${apps} {
        set app ${destroot}${applications_dir}/${appname}.app
        xinstall -d ${app}/Contents/MacOS ${app}/Contents/Resources
        xinstall -m 0644 ${worksrcpath}/macos/${gui}.plist ${app}/Contents/Info.plist
        xinstall -m 0644 ${worksrcpath}/crates/${gui}/assets/freemkv.icns ${app}/Contents/Resources/
        # The GUI crates take the workspace version.
        foreach key {CFBundleVersion CFBundleShortVersionString} {
            system "/usr/libexec/PlistBuddy -c [shellescape "Set :${key} ${version}"]\
                [shellescape ${app}/Contents/Info.plist]"
        }
        xinstall -m 0755 ${out}/${gui} ${out}/${cli} ${app}/Contents/MacOS/
    }
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/crates/freemkv-flash/README.md \
        ${destroot}${prefix}/share/doc/${name}/
}

