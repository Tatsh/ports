PortSystem          1.0
PortGroup           cargo 1.0
PortGroup           github 1.0

github.setup        mgree ffs 0.1.2 v
github.tarball_from archive
revision            0
categories          sysutils
license             GPL-3
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Mount semi-structured data (such as JSON) as a filesystem.
long_description    ffs (the file filesystem) mounts a JSON, YAML or TOML file as a directory \
                    tree, so it can be read and edited with ordinary shell tools, and writes the \
                    changes back on unmount. It uses macFUSE.
homepage            https://mgree.github.io/ffs/

checksums           ffs-0.1.2.tar.gz \
                    rmd160  15519faf4149eb872d845912af7038a620cd207e \
                    sha256  f78ad4c1997e6d144e46ddd6858ae01bc569e1943e49d32c22830d7e713473db \
                    size    2007558

depends_build-append \
                    port:pkgconfig
depends_lib-append  port:macfuse

destroot {
    xinstall -m 0755 ${worksrcpath}/target/[cargo.rust_platform]/release/${name} \
        ${destroot}${prefix}/bin/
    xinstall -m 0644 ${worksrcpath}/man/${name}.1 ${destroot}${prefix}/share/man/man1/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}

notes "
Mounting needs macFUSE's file system extension, which macOS has to allow first: see\
 https://github.com/macfuse/macfuse/wiki/Getting-Started
"

