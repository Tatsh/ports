# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           python 1.0

github.setup        hephaest0s usbkill d3df79e

version             1.0-rc.4
platforms           darwin linux freebsd
license             GPL-3
supported_archs     noarch
categories          sysutils python
revision            3

python.versions         37 38 39 310 311 312 313 314
python.default_version  313

maintainers         {gmail.com:audvare @Tatsh}

description         An anti-forensic kill-switch.
long_description    An anti-forensic kill-switch that waits for a change on your USB ports and \
                    then immediately shuts down your computer.

checksums           rmd160  7f59644199dc4e977e37c6e10a945eb7ecd7486b \
                    sha256  0b0bfff3151b3b6b152f257a492fab7f582e48e2ee44f6993ce76fa602430365 \
                    size    4463884

patchfiles          patch-${name}-paths.diff

# The settings file is installed below, as a sample; an absolute data_files path ends up inside
# site-packages when built as a wheel.
post-patch {
    reinplace {/data_files=/d} ${worksrcpath}/setup.py
}

post-destroot {
    xinstall -m 0644 ${worksrcpath}/install/usbkill.ini ${destroot}${prefix}/etc/usbkill.ini.sample
    xinstall -d ${destroot}${prefix}/var/log/usbkill
}
destroot.keepdirs-append ${destroot}${prefix}/var/log/usbkill

post-activate {
    if {![file exists ${prefix}/etc/usbkill.ini]} {
        file copy ${prefix}/etc/usbkill.ini.sample ${prefix}/etc/usbkill.ini
    }
}

# usbkill must run as root to shut the Mac down. The service is not started until it is loaded.
startupitem.create  yes
startupitem.logfile ${prefix}/var/log/usbkill/launchd.log
startupitem.executable \
                    ${prefix}/bin/usbkill

notes "
Edit ${prefix}/etc/usbkill.ini (whitelist and kill commands) first, and test with\
 sudo usbkill --no-shut-down. Then start the service with:
  sudo port load ${name}
Any change to the USB devices then shuts the Mac down immediately.
"

if {$subport ne $name} {
    livecheck.type none
}
