# The project is GNU C23. MacPorts can request at most C17, and older Xcode clang lacks -std=c2x.
compiler.c_standard 2017
compiler.blacklist-append {clang < 1200}

# Newer compilers may add warnings that the project treats as errors.
configure.args-append \
                    --compile-no-warning-as-error
