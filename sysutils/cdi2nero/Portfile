PortSystem          1.0

name                cdi2nero
version             0.9.9
categories          sysutils
platforms           darwin linux freebsd
license             Restrictive
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Convert DiscJuggler CDI images to Nero NRG images.
long_description    ${description} Written by DeXT.
homepage            https://web.archive.org/web/20091027063725/http://es.geocities.com/dextstuff/cdirip/down_cdi.html
master_sites        https://web.archive.org/web/20091027063725/http://es.geocities.com/dextstuff/cdirip/
distfiles           cdi2nero099-src.zip
use_zip             yes
extract.mkdir       yes

checksums           rmd160  b0088737aba005eedc872b7b7c79f9905a7998d8 \
                    sha256  7b6588cbf26566f727ae52bad04b25a0eb098e73192fe0028362aa4d46560d6c \
                    size    10043

# Missing POSIX headers and declarations.
patchfiles          patch-posix.diff
patch.pre_args-replace -p0 -p1

use_configure       no

build {
    system -W ${worksrcpath} "${configure.cc} [get_canonical_archflags cc] ${configure.cflags} ${configure.ldflags} -o cdi2nero cdi2nero.c buffer.c cdi.c common.c "
}

destroot {
    xinstall -m 0755 ${worksrcpath}/cdi2nero ${destroot}${prefix}/bin/
}

livecheck.type      none
