# test_live_providers.py queries the real weather and tide services. A scratch HOME keeps the
# location cached by one test from changing the unit defaults of later ones.
test.run            yes
test.env-append     HOME=${workpath}/test-home
test.args-append    -p no:cacheprovider --ignore=tests/test_live_providers.py
pre-test {
    file mkdir ${workpath}/test-home
}
