add_users           _changedetection group=_changedetection realname=changedetection.io

post-destroot {
    xinstall -d -o _changedetection -g _changedetection -m 0750 \
        ${destroot}${prefix}/var/db/${name}
}
destroot.keepdirs   ${destroot}${prefix}/var/db/${name}

startupitem.create  yes
startupitem.user    _changedetection
startupitem.group   _changedetection
startupitem.executable \
                    ${prefix}/bin/changedetection.io -d ${prefix}/var/db/${name} -h 127.0.0.1 -p 5000

notes "
Start the web interface on http://127.0.0.1:5000 with:
    sudo port load ${name}
"
