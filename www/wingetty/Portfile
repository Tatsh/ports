PortSystem          1.0
PortGroup           github 1.0

github.setup        thilojaeggi WinGetty 1.0.0 v
github.tarball_from archive
name                wingetty
revision            1
categories          www sysutils
platforms           darwin
license             AGPL-3
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Self-hosted WinGet package source.
long_description    WinGetty is a self-hosted package repository for the Windows Package \
                    Manager (WinGet), with a web interface to upload and manage packages and \
                    users. This port runs it with Waitress as a launchd service.
homepage            https://github.com/thilojaeggi/WinGetty
dist_subdir         ${name}/${version}

# The stylesheet is built with Tailwind CSS at build time, using the standalone CLI and the one
# plugin the configuration uses.
set tailwind_version  3.4.17
set scrollbar_version 3.0.5
if {${build_arch} eq "arm64"} {
    set tailwind_bin tailwindcss-macos-arm64
} else {
    set tailwind_bin tailwindcss-macos-x64
}
master_sites-append https://github.com/tailwindlabs/tailwindcss/releases/download/v${tailwind_version}/:tailwind \
                    https://registry.npmjs.org/tailwind-scrollbar/-/:scrollbar
distfiles-append    ${tailwind_bin}:tailwind \
                    tailwind-scrollbar-${scrollbar_version}.tgz:scrollbar
extract.only        ${distname}${extract.suffix}

checksums           WinGetty-1.0.0.tar.gz \
                    rmd160  1ffe8557a1e9b6442b64976a039de899f0aafad5 \
                    sha256  1772ff47b12ac20e4cdb438f46124971829080b7726126b8f0866012f1841657 \
                    size    896395 \
                    tailwindcss-macos-x64 \
                    rmd160  9dbb38b0d681c8c4345e49114dbd7203ced4d127 \
                    sha256  6cbdad74be776c087ffa5e9a057512c54898f9fe8828d3362212dfe32fc933a3 \
                    size    53962480 \
                    tailwindcss-macos-arm64 \
                    rmd160  4b811dff443905c610e090b4487261deffcfb206 \
