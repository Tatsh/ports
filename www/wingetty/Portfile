                    size    6179

set python_branch   3.13
set python_version  [string map {. {}} ${python_branch}]
set python_bin      ${prefix}/bin/python${python_branch}

depends_lib-append  port:python${python_version}
depends_run-append  port:py${python_version}-boto3 \
                    port:dynaconf \
                    port:py${python_version}-flask \
                    port:py${python_version}-flask-bcrypt \
                    port:py${python_version}-flask-htmx \
                    port:py${python_version}-flask-login \
                    port:py${python_version}-flask-migrate \
                    port:py${python_version}-flask-sqlalchemy \
                    port:py${python_version}-flask-wtf \
                    port:py${python_version}-requests \
                    port:py${python_version}-setuptools \
                    port:py${python_version}-sqlalchemy \
                    port:py${python_version}-waitress \
                    port:py${python_version}-werkzeug \
                    port:py${python_version}-wtforms

post-extract {
    set nm ${worksrcpath}/node_modules/tailwind-scrollbar
    xinstall -d ${nm}
    system -W ${nm} "tar -xzf ${distpath}/tailwind-scrollbar-${scrollbar_version}.tgz --strip-components=1"
    xinstall -m 0755 ${distpath}/${tailwind_bin} ${workpath}/tailwindcss
    # The plugin reaches into Tailwind's private modules, which the standalone CLI cannot resolve.
    xinstall -m 0644 ${filespath}/tailwind-internals.js ${nm}/src/
    reinplace {s|require('tailwindcss/lib/util/flattenColorPalette')|require('./tailwind-internals').flattenColorPalette|; s|require('tailwindcss/lib/util/toColorValue')|require('./tailwind-internals').toColorValue|} \
        ${nm}/src/utilities.js
    reinplace {s|require('tailwindcss/lib/featureFlags')|require('./tailwind-internals')|} ${nm}/src/variants.js
}

# distutils was removed in Python 3.12. LooseVersion is used only to sort version strings.
post-patch {
    reinplace {s|^from distutils.version import LooseVersion|from setuptools._distutils.version import LooseVersion|} \
        ${worksrcpath}/app/__init__.py
    # Flask copies every upper-case attribute it finds, and newer Dynaconf has internal ones that
    # cannot be read that way.
    reinplace {s|app.config.from_object(settings)|app.config.update(settings.as_dict())|} \
        ${worksrcpath}/app/__init__.py
}

use_configure       no

build {
    system -W ${worksrcpath} "${workpath}/tailwindcss build -i src/input.css -o app/static/css/style.css --minify"
}

destroot {
    set share ${destroot}${prefix}/share/${name}
    xinstall -d ${share}
    copy ${worksrcpath}/app ${worksrcpath}/migrations ${share}/
    xinstall -m 0644 ${worksrcpath}/config.py ${worksrcpath}/settings.toml ${share}/
    # Uploaded installers are stored in app/packages.
    ln -s ${prefix}/var/db/${name}/packages ${share}/app/packages
    xinstall -d ${destroot}${prefix}/etc/${name} ${destroot}${prefix}/libexec/${name}
    xinstall -m 0644 ${filespath}/wingetty.conf.sample ${destroot}${prefix}/etc/${name}/
    xinstall -m 0755 ${filespath}/wingetty-service ${filespath}/wingetty-flask \
        ${destroot}${prefix}/libexec/${name}/
    reinplace "s|@PREFIX@|${prefix}|g" ${destroot}${prefix}/etc/${name}/wingetty.conf.sample \
        ${destroot}${prefix}/libexec/${name}/wingetty-service \
        ${destroot}${prefix}/libexec/${name}/wingetty-flask
    reinplace "s|@PYTHON@|${python_bin}|g" ${destroot}${prefix}/libexec/${name}/wingetty-service \
        ${destroot}${prefix}/libexec/${name}/wingetty-flask
    xinstall -d -m 0755 ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE.md ${destroot}${prefix}/share/doc/${name}/
}

add_users           _wingetty group=_wingetty realname=WinGetty

# The data directory is owned by the service user, so it is made at activation rather than in the
# destroot: deactivation cannot delete a registered directory owned by another user ("not
# owner"), and the data in it should outlive the port anyway.
post-activate {
    foreach d [list ${prefix}/var/db/${name} ${prefix}/var/db/${name}/packages] {
        if {![file isdirectory ${d}]} {
            xinstall -d -m 0750 -o _wingetty -g _wingetty ${d}
        }
    }
    set conf ${prefix}/etc/${name}/wingetty.conf
    if {![file exists ${conf}]} {
        set key [exec /usr/bin/openssl rand -hex 32]
        set in [open ${conf}.sample r]
        set text [read ${in}]
        close ${in}
        set out [open ${conf} w 0640]
        puts -nonewline ${out} [string map [list @SECRET_KEY@ ${key}] ${text}]
        close ${out}
        file attributes ${conf} -group _wingetty
    }
    system "su -m _wingetty -c '${prefix}/libexec/${name}/wingetty-flask db upgrade'"
}

startupitem.create  yes
startupitem.user    _wingetty
startupitem.group   _wingetty
startupitem.executable \
                    ${prefix}/libexec/${name}/wingetty-service

notes "
Settings are read from ${prefix}/etc/${name}/wingetty.conf. The server listens on\
http://127.0.0.1:8080 by default. Start it with:
    sudo port load ${name}
Then open the web interface and register the first user, who becomes the administrator.
"

livecheck.type      none
