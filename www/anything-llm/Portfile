# canvas and sharp are native addons, built against the MacPorts libraries (sharp uses the global
# libvips when pkg-config finds it, so it downloads nothing).
nodejs.native       yes

depends_build-append \
                    port:pkgconfig
depends_lib-append  path:lib/pkgconfig/cairo.pc:cairo \
                    path:lib/pkgconfig/pango.pc:pango \
                    path:lib/pkgconfig/librsvg-2.0.pc:librsvg \
                    path:lib/pkgconfig/libpng.pc:libpng \
                    path:lib/libjpeg.dylib:libjpeg-turbo \
                    path:lib/libgif.dylib:giflib \
                    port:freetype \
                    port:libpixman \
                    port:vips \
                    port:onnxruntime \
                    port:lancedb-nodejs
depends_run-append  port:ripgrep

# Keep the SQLite database and the settings the server writes (.env) in STORAGE_DIR instead of
# the installed tree, and let SERVER_HOST choose the listening address (for the service).
patchfiles          patch-prisma-database-url.diff \
                    patch-dump-env-to-storage-dir.diff \
                    patch-listen-host.diff

set nm              ${worksrcpath}/node_modules
set engines         ${nm}/@prisma/engines
set prisma_env      [list HOME=${workpath}/home CHECKPOINT_DISABLE=1 PRISMA_HIDE_UPDATE_MESSAGE=1 \
                         PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 \
                         PRISMA_QUERY_ENGINE_LIBRARY=${engines}/libquery_engine-[join \
                             [list ${prisma_platform} dylib node] .] \
                         PRISMA_SCHEMA_ENGINE_BINARY=${engines}/schema-engine-${prisma_platform}]

post-extract {
    system -W ${workpath} "/usr/bin/tar -xzf [shellescape ${distpath}/${name}-${version}.tar.gz] \
        ${name}-${version}/server ${name}-${version}/LICENSE ${name}-${version}/README.md"

    # The Prisma engines, where @prisma/engines and the prisma CLI look for them.
    system "/usr/bin/gzip -dc [shellescape ${distpath}/libquery_engine.dylib.node.gz] \
        > ${engines}/libquery_engine-${prisma_platform}.dylib.node"
    system "/usr/bin/gzip -dc [shellescape ${distpath}/schema-engine.gz] \
        > ${engines}/schema-engine-${prisma_platform}"
    file attributes ${engines}/schema-engine-${prisma_platform} -permissions 0755

    # The macOS build of mdpdf (Rust, napi-rs) from npm replaces the Linux ones.
    set mdpdf ${nm}/@mintplex-labs/mdpdf-darwin-${npm_arch}
    file mkdir ${mdpdf}
    set tgz ${distpath}/mdpdf-darwin-${npm_arch}-${mdpdf_version}.tgz
    system -W ${mdpdf} "/usr/bin/tar -xzf [shellescape ${tgz}] --strip-components 1"

    # Prebuilt binaries for other platforms. bare-fs and bare-os are for the Bare runtime only.
    # LanceDB comes from lancedb-nodejs, linked in post-destroot.
    delete {*}[glob -nocomplain -type d ${nm}/@lancedb/lancedb-linux-* \
                   ${nm}/@mintplex-labs/mdpdf-linux-*] \
           {*}[glob -nocomplain -type d ${nm}/bare-*/prebuilds \
                   ${nm}/*/node_modules/bare-*/prebuilds]
    set ort ${nm}/onnxruntime-node/bin/napi-v3
    foreach dir [glob -type d ${ort}/*] {
        if {[file tail ${dir}] ne "darwin"} {
            delete ${dir}
        }
    }
    foreach dir [glob -type d ${ort}/darwin/*] {
        if {[file tail ${dir}] ne ${npm_arch}} {
            delete ${dir}
        }
    }
    # Use the onnxruntime of MacPorts (newer, but it still serves the API version of 1.14) instead
    # of the bundled libonnxruntime.1.14.0.dylib.
    delete {*}[glob ${ort}/darwin/${npm_arch}/libonnxruntime.*.dylib]
    system "install_name_tool -change @rpath/libonnxruntime.1.14.0.dylib \
        ${prefix}/lib/libonnxruntime.1.dylib ${ort}/darwin/${npm_arch}/onnxruntime_binding.node"
    system "/usr/bin/codesign -f -s - ${ort}/darwin/${npm_arch}/onnxruntime_binding.node"
}

post-build {
    # node-gyp does not stop the build when an addon fails.
    foreach addon [list canvas/build/Release/canvas sharp/build/Release/sharp-darwin-${npm_arch}] {
        if {![file exists ${nm}/${addon}.node]} {
            return -code error "[lindex [split ${addon} /] 0]: the native addon was not built"
        }
    }
    # Generate the Prisma client (node_modules/.prisma/client) offline.
    file mkdir ${workpath}/home
    system -W ${worksrcpath} "env [join [lmap e ${prisma_env} {shellescape ${e}}]] \
        ${prefix}/bin/node node_modules/prisma/build/index.js generate \
        --schema=prisma/schema.prisma"
}

set data_dir        ${prefix}/var/db/${name}
set log_file        ${prefix}/var/log/${name}.log

post-destroot {
    set dest ${destroot}[option nodejs.dir]
    # Build leftovers.
    foreach dir {canvas sharp} {
        set build ${dest}/node_modules/${dir}/build
        delete ${build}/Release/obj.target ${build}/Release/.deps ${build}/Makefile \
            ${build}/config.gypi ${build}/gyp-mac-tool {*}[glob -nocomplain ${build}/*.mk]
    }
    delete ${dest}/node_modules/.prisma/client/libquery_engine-${prisma_platform}.dylib.node
    ln -s ../../@prisma/engines/libquery_engine-${prisma_platform}.dylib.node \
        ${dest}/node_modules/.prisma/client/libquery_engine-${prisma_platform}.dylib.node

    ln -s ${prefix}/lib/node_modules/@lancedb/lancedb-darwin-${npm_arch} \
        ${dest}/node_modules/@lancedb/lancedb-darwin-${npm_arch}
    file mkdir ${dest}/node_modules/@vscode/ripgrep/bin
    ln -s ${prefix}/bin/rg ${dest}/node_modules/@vscode/ripgrep/bin/rg

    xinstall -m 0755 ${filespath}/${name}.in ${destroot}${prefix}/bin/${name}
    reinplace -q "s|@APPDIR@|[option nodejs.dir]|g; s|@NODE@|${prefix}/bin/node|g; \
        s|@PRISMA_PLATFORM@|${prisma_platform}|g" ${destroot}${prefix}/bin/${name}

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/../README.md ${worksrcpath}/../LICENSE \
        ${worksrcpath}/.env.example ${destroot}${prefix}/share/doc/${name}/

    xinstall -d -m 0750 -o _anythingllm -g _anythingllm ${destroot}${data_dir}
}
destroot.keepdirs   ${destroot}${data_dir}

# A launchd service under its own user, listening on 127.0.0.1 only.
add_users           _anythingllm group=_anythingllm realname=AnythingLLM home=${data_dir}

startupitem.create  yes
startupitem.user    _anythingllm
startupitem.group   _anythingllm
startupitem.logfile ${log_file}
startupitem.executable \
                    /usr/bin/env HOME=${data_dir} STORAGE_DIR=${data_dir} \
                    SERVER_HOST=127.0.0.1 SERVER_PORT=3001 ${prefix}/bin/${name}

notes "
Run anything-llm to start the server for your own user, with its data in\
 ~/Library/Application Support/AnythingLLM (set STORAGE_DIR to change it). Or load the service,\
 which runs as the _anythingllm user, keeps its data in ${data_dir} and listens on\
 http://127.0.0.1:3001:
  sudo port load ${name}
The server's settings are kept in the .env file of the storage folder (see\
 ${prefix}/share/doc/${name}/.env.example). Telemetry is off unless DISABLE_TELEMETRY=false is set.\
 The web interface and the document collector are not included.
"
