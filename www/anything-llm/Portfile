# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           nodejs 1.0

name                anything-llm
version             1.20.0
revision            0
categories          www
license             MIT 0BSD Apache-2 BSD ISC PSF Unlicense public-domain WTFPL-2
description         Server of AnythingLLM, an application to chat with your documents using LLMs.
long_description    AnythingLLM turns documents and other content into context that a large \
                    language model (local or hosted) can use while chatting, with workspaces, \
                    agents, multiple users and an embedded LanceDB vector store. This installs \
                    the server (its API on port 3001) as tatsh-overlay packages it, without the \
                    web interface and the document collector.
homepage            https://anythingllm.com

# The node_modules tarball (a Linux yarn production install) holds only server/node_modules; the
# server itself comes from the upstream tag.
worksrcdir          ${name}-${version}/server

set npm_arch        [expr {${configure.build_arch} eq "arm64" ? "arm64" : "x64"}]
set prisma_platform [expr {${npm_arch} eq "arm64" ? "darwin-arm64" : "darwin"}]
# The engines of Prisma 5.3.1 (@prisma/engines-version), as Prisma publishes them for macOS.
set prisma_hash     61e140623197a131c2a6189271ffee05a7aa9a59
set mdpdf_version   0.1.10

set prisma_site     https://binaries.prisma.sh/all_commits/${prisma_hash}/${prisma_platform}/
master_sites-append https://github.com/Mintplex-Labs/${name}/archive/v${version}/:upstream \
                    ${prisma_site}:prisma \
                    https://registry.npmjs.org/@mintplex-labs/mdpdf-darwin-${npm_arch}/-/:mdpdf
distfiles-append    ${name}-${version}.tar.gz:upstream \
                    libquery_engine.dylib.node.gz:prisma \
                    schema-engine.gz:prisma \
                    mdpdf-darwin-${npm_arch}-${mdpdf_version}.tgz:mdpdf

checksums           anything-llm-1.20.0-node_modules.tar.xz \
