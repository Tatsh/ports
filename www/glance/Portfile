build.args          -ldflags=-X=github.com/glanceapp/glance/internal/glance.buildVersion=v${version}

add_users           _glance group=_glance realname=Glance\ Dashboard

destroot {
    xinstall -m 0755 ${worksrcpath}/${name} ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/etc/${name} ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/docs/glance.yml ${destroot}${prefix}/etc/${name}/glance.yml.sample
    xinstall -m 0644 {*}[glob ${worksrcpath}/docs/*.md] ${worksrcpath}/README.md \
        ${destroot}${prefix}/share/doc/${name}/
}

post-activate {
    if {![file exists ${prefix}/etc/${name}/glance.yml]} {
        copy ${prefix}/etc/${name}/glance.yml.sample ${prefix}/etc/${name}/glance.yml
    }
}

startupitem.create  yes
startupitem.user    _glance
startupitem.group   _glance
startupitem.executable \
                    ${prefix}/bin/${name} --config ${prefix}/etc/${name}/glance.yml

notes "
Edit ${prefix}/etc/${name}/glance.yml, then start the dashboard (port 8080 by default) with:
    sudo port load ${name}
"

test.run            yes
test.target         ./...
