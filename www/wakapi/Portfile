# glebarez/go-sqlite is a fork that keeps modernc.org/sqlite's import comments, which GOPATH builds
# enforce.
post-extract {
    foreach f [glob ${workpath}/gopath/src/github.com/glebarez/go-sqlite/*.go] {
        reinplace -q {s|^package sqlite // import "modernc.org/sqlite"|package sqlite|} ${f}
    }
}

add_users           _wakapi group=_wakapi realname=Wakapi

destroot {
    xinstall -m 0755 ${worksrcpath}/${name} ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/etc/${name} ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/config.default.yml ${destroot}${prefix}/etc/${name}/config.yml.sample
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
    xinstall -d -o _wakapi -g _wakapi -m 0750 ${destroot}${prefix}/var/db/${name}
}
destroot.keepdirs   ${destroot}${prefix}/var/db/${name}

post-activate {
    if {![file exists ${prefix}/etc/${name}/config.yml]} {
        copy ${prefix}/etc/${name}/config.yml.sample ${prefix}/etc/${name}/config.yml
    }
}

# Wakapi resolves relative paths (such as its SQLite database) against its working directory.
startupitem.create  yes
startupitem.user    _wakapi
startupitem.group   _wakapi
startupitem.executable \
                    /bin/sh -c "cd ${prefix}/var/db/${name} && exec ${prefix}/bin/${name} -config ${prefix}/etc/${name}/config.yml"

notes "
Edit ${prefix}/etc/${name}/config.yml, then start Wakapi (port 3000 by default) with:
    sudo port load ${name}
"

# scripts/ is a separate module of helper programs. Wakapi's configuration rejects variables set
# both directly and as *_FILE, which is how MacPorts passes CC_PRINT_OPTIONS.
test.run            yes
test {
    system -W ${worksrcpath} "env -u CC_PRINT_OPTIONS -u CC_PRINT_OPTIONS_FILE [join ${test.env}] \
        CGO_ENABLED=0 ${go.bin} test \$(env [join ${test.env}] ${go.bin} list ./... | grep -v /scripts)"
}
