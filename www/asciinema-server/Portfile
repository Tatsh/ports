depends_build-append \
                    port:cargo \
                    port:esbuild \
                    port:rust
depends_lib-append  port:elixir \
                    port:erlang

patchfiles          patch-security-updates.diff \
                    patch-system-tooling.diff
patch.pre_args-replace -p0 -p1

post-extract {
    foreach f [list hex-${hex_version}-mix-home ${name}-${version}-deps ${name}-${version}-node_modules] {
        system -W ${workpath} "tar -xJf ${distpath}/${f}.tar.xz"
    }
    # The two vendored trees unpack at the top of the work directory. mix and the asset build
    # expect them inside the source tree.
    delete ${worksrcpath}/deps ${worksrcpath}/assets/node_modules
    move ${workpath}/deps ${worksrcpath}/deps
    move ${workpath}/node_modules ${worksrcpath}/assets/node_modules
    xinstall -m 0755 ${distpath}/${tailwind_bin} ${workpath}/tailwindcss
}

use_configure       no

# Neither mix nor Hex may reach the network or write outside the work directory. Cargo finds the
# vendored crates through the configuration cargo_fetch writes to the build home.
build.env-append    MIX_ENV=prod \
                    HEX_OFFLINE=1 \
                    HEX_HOME=${workpath}/hex \
                    MIX_HOME=${workpath}/mix-home \
                    ESBUILD_PATH=${prefix}/bin/esbuild \
                    TAILWIND_PATH=${workpath}/tailwindcss \
                    CARGO_NET_OFFLINE=true \
                    LANG=en_US.UTF-8 \
                    LC_ALL=en_US.UTF-8

build {
    set mix_env {}
    foreach e ${build.env} {
        lappend mix_env [shellescape ${e}]
    }
    foreach step {{deps.compile --no-deps-check} {compile --no-deps-check} assets.deploy
            {release --no-deps-check}} {
        system -W ${worksrcpath} "env [join ${mix_env}] ${prefix}/bin/mix ${step}"
    }
}

destroot {
    set dest ${destroot}${prefix}/libexec/${name}
    xinstall -d ${dest}
    copy {*}[glob ${worksrcpath}/_build/prod/rel/asciinema/*] ${dest}/
    delete ${dest}/bin/asciinema.bat
    xinstall -d ${destroot}${prefix}/etc/${name}
    xinstall -m 0644 ${filespath}/server.env.sample ${destroot}${prefix}/etc/${name}/
    xinstall -m 0755 ${filespath}/asciinema-server-service ${dest}/
    reinplace "s|@PREFIX@|${prefix}|g" ${dest}/asciinema-server-service
    xinstall -d -o _asciinema -g _asciinema -m 0750 ${destroot}${prefix}/var/db/${name} \
        ${destroot}${prefix}/var/db/${name}/tmp
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE ${destroot}${prefix}/share/doc/${name}/
}
destroot.keepdirs   ${destroot}${prefix}/var/db/${name}/tmp

add_users           _asciinema group=_asciinema realname=asciinema\ server

post-activate {
    set conf ${prefix}/etc/${name}/server.env
    if {![file exists ${conf}]} {
        set key [exec /usr/bin/openssl rand -base64 48]
        set in [open ${conf}.sample r]
        set text [read ${in}]
        close ${in}
        set out [open ${conf} w 0640]
        puts -nonewline ${out} [string map [list @SECRET_KEY_BASE@ ${key}] ${text}]
        close ${out}
        file attributes ${conf} -group _asciinema
    }
}

startupitem.create  yes
startupitem.user    _asciinema
startupitem.group   _asciinema
startupitem.executable \
                    ${prefix}/libexec/${name}/asciinema-server-service

notes "
Before starting the service:

  1. Create the PostgreSQL database and role, for example:
       createuser asciinema
       createdb -O asciinema asciinema
  2. Set DATABASE_URL and URL_HOST in ${prefix}/etc/${name}/server.env (a SECRET_KEY_BASE was\
 generated for you).
  3. Start the server with:
       sudo port load ${name}

The service runs the database migrations before it starts the server.

Two of the locked dependencies carry published advisories that cannot be resolved by updating\
 them: cowlib 2.20.0 (header and cookie injection in the HTTP layer, no fixed release exists) and\
 earmark 1.4.49 (stored XSS, mitigated here because rendered Markdown is sanitised). Consider\
 whether to expose this server directly to the internet.
"

livecheck.type      none
