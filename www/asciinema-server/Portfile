description         Platform for hosting and sharing terminal session recordings.
long_description    The server behind asciinema.org, for hosting and sharing terminal session \
                    recordings. It needs PostgreSQL. This port runs it as a launchd service.
homepage            https://docs.asciinema.org/manual/server/
dist_subdir         ${name}/${version}

# Mix and npm resolve over the network, so the dependency trees are fetched ahead of time and
# shipped whole (the same distfiles tatsh-overlay uses). Hex is a Mix archive that mix installs by
# downloading it, and mix cannot read a lock file full of :hex entries without it. The stylesheet
# is built with the standalone Tailwind CSS CLI.
set hex_version     2.5.1
set tailwind_version 3.4.3
if {${build_arch} eq "arm64"} {
    set tailwind_bin tailwindcss-macos-arm64
} else {
    set tailwind_bin tailwindcss-macos-x64
}
master_sites-append https://github.com/Tatsh/tatsh-overlay/releases/download/__distfiles__/:overlay \
                    https://github.com/tailwindlabs/tailwindcss/releases/download/v${tailwind_version}/:tailwind
distfiles-append    hex-${hex_version}-mix-home.tar.xz:overlay \
                    ${name}-${version}-deps.tar.xz:overlay \
                    ${name}-${version}-node_modules.tar.xz:overlay \
                    ${tailwind_bin}:tailwind

