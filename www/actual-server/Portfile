# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           nodejs 1.0

name                actual-server
version             26.11.0
revision            1
categories          www finance
license             MIT Apache-2 BSD ISC
description         Sync server and web client for Actual, a local-first personal finance app.
long_description    {*}${description} The launchd service listens on 127.0.0.1:5006 and keeps \
                    its data in ${prefix}/var/db/actual.
homepage            https://actualbudget.org

checksums           actual-server-26.11.0-node_modules.tar.xz \
                    rmd160  b50af7ab08b51f8ce2382ab050c2f129612e89fe \
                    sha256  b5884d815302d89dfbe7f0f97ec5a72ebbcc12c3dff084373b341ac509dc1f8c \
                    size    21695612 \
                    node-v22.23.4-headers.tar.gz \
                    rmd160  ccca04ffa26af32e30709dd3ce057de52ea225af \
                    sha256  dc4028dc105e27e5295119dd9da076fca71d5216113e097813f0fb30f59241a5 \
                    size    9936937

# argon2, bcrypt and better-sqlite3 are native addons.
nodejs.native       yes
nodejs.bins         {actual-server node_modules/@actual-app/sync-server/build/bin/actual-server.js}

post-extract {
    set nm ${worksrcpath}/node_modules
    # From tatsh-overlay: argon2 builds with -Werror; better-sqlite3 skips compiling when it ships a
    # prebuild for the host (here only arm64) and adds -flto on top of the compiler flags.
    reinplace {s/, "-Werror"//} ${nm}/argon2/binding.gyp
    delete ${nm}/better-sqlite3/prebuilds
    reinplace -E {s/, '-flto'//g; s/'-flto', //g; s/\['-flto'\]/[]/g} ${nm}/better-sqlite3/binding.gyp
}

post-build {
    # node-gyp does not stop the build when an addon fails.
    foreach addon {argon2/build/Release/argon2 bcrypt/build/Release/bcrypt_lib \
                   better-sqlite3/build/Release/better_sqlite3} {
        if {![file exists ${worksrcpath}/node_modules/${addon}.node]} {
            return -code error "[lindex [split ${addon} /] 0]: the native addon was not built"
        }
    }
}

set data_dir        ${prefix}/var/db/actual
set log_file        ${prefix}/var/log/${name}.log

# The data directory is owned by the service user, so it is made at activation rather than in the
# destroot: deactivation cannot delete a registered directory owned by another user ("not
# owner"), and the data in it should outlive the port anyway.
post-activate {
    if {![file isdirectory ${data_dir}]} {
        xinstall -d -m 0750 -o _actual -g _actual ${data_dir}
    }
}

add_users           _actual group=_actual realname=Actual

startupitem.create  yes
startupitem.user    _actual
startupitem.group   _actual
startupitem.logfile ${log_file}
startupitem.executable \
                    /usr/bin/env ACTUAL_HOSTNAME=127.0.0.1 ACTUAL_PORT=5006 \
                    ACTUAL_DATA_DIR=${data_dir} ${prefix}/bin/${name}

notes "
The service listens on http://127.0.0.1:5006 and keeps its data in ${data_dir}. Start it with:
  sudo port load ${name}
"
