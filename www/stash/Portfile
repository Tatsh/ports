depends_build-append \
                    port:go \
                    path:bin/node:nodejs22 \
                    path:bin/npm:npm11
depends_run-append  path:bin/ffmpeg:ffmpeg

# From tatsh-overlay: drop the Makefile's interface steps (the interface is built below), let
# MacPorts set the flags, skip go mod tidy in gqlgen, and bump the modules that break on Go 1.27.
patchfiles          patch-makefile-remove-ui-steps.diff \
                    patch-makefile-do-not-fight-the-package-manager.diff \
                    patch-gqlgen-skip-go-mod-tidy.diff \
                    patch-go-bump-modules-for-go-1.27.diff
patch.pre_args-replace -p0 -p1

post-extract {
    set nm ${worksrcpath}/ui/v${ui_pv}/node_modules
    foreach {pkg ver} ${platform_pkgs} {
        set dir ${nm}/${pkg}
        set linux [string map [list darwin-${npm_arch} linux-*] [file tail ${pkg}]]
        delete {*}[glob -nocomplain -type d [file dirname ${dir}]/${linux}]
        file mkdir ${dir}
        system -W ${dir} "/usr/bin/tar -xzf [shellescape ${distpath}/[file tail ${pkg}]-${ver}.tgz] --strip-components 1"
    }
}

use_configure       no

set go_env          [list GOFLAGS=-mod=vendor GOTOOLCHAIN=local GOPROXY=off \
                         GOCACHE=${workpath}/go-cache GOPATH=${workpath}/go \
                         CC=${configure.cc} CGO_CFLAGS=[shellescape ${configure.cflags}] \
                         CGO_LDFLAGS=[shellescape ${configure.ldflags}]]

build {
    set ui ${worksrcpath}/ui/v${ui_pv}
    set npm_env [list HOME=${workpath}/home npm_config_cache=${workpath}/npm-cache npm_config_offline=true \
                     VITE_APP_STASH_VERSION=${version} "VITE_APP_DATE=[clock format [clock seconds] -format {%Y-%m-%d %H:%M:%S}]"]
    file mkdir ${workpath}/home
    system -W ${ui} "env [join [lmap e ${npm_env} {shellescape ${e}}]] ${prefix}/bin/npm run gqlgen"
    system -W ${ui} "env [join [lmap e ${npm_env} {shellescape ${e}}]] ${prefix}/bin/npm run build"
    # The version cannot come from git describe in a release tarball. The two binaries are built
    # with different flags, so in separate runs, as upstream notes.
    foreach target {release phasher} {
        system -W ${worksrcpath} "env [join ${go_env}] ${build.cmd} STASH_VERSION=v${version} ${target}"
    }
}

destroot {
    xinstall -m 0755 ${worksrcpath}/stash ${worksrcpath}/phasher ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE ${destroot}${prefix}/share/doc/${name}/
}

test.run            yes
test {
    system -W ${worksrcpath} "env [join ${go_env}] ${prefix}/bin/go test ./..."
}

notes "
Run stash to start the server, then open http://localhost:9999 to set it up. Its configuration\
 and database are kept in ~/.stash.
"
