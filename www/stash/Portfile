PortSystem          1.0
PortGroup           github 1.0

github.setup        stashapp stash 0.32.0 v
github.tarball_from archive
revision            0
categories          www multimedia
license             AGPL-3 MIT BSD Apache-2 ISC MPL-2 CC-BY-4 public-domain
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Organiser for your videos and images, with a web interface.
long_description    Stash is a self-hosted web application written in Go that organises and serves \
                    your collection of videos and images, with tagging, scraping of metadata and \
                    generated previews. The React interface is built into the stash binary.
homepage            https://stashapp.cc
supported_archs     x86_64 arm64

set ui_pv           2.5
set npm_arch        [expr {${configure.build_arch} eq "arm64" ? "arm64" : "x64"}]

# The Go modules and the interface's node_modules, as tatsh-overlay publishes them, so nothing is
# downloaded while building. node_modules was resolved on Linux, so its native packages are
# replaced with the macOS builds of the same versions from npm.
set overlay         https://github.com/Tatsh/tatsh-overlay/releases/download/__distfiles__/
master_sites-append ${overlay}:overlay
distfiles-append    ${name}-${version}-vendor.tar.xz:overlay \
                    ${name}-${version}-node_modules.tar.xz:overlay
set platform_pkgs   [list @esbuild/darwin-${npm_arch} 0.27.7 \
                          @rollup/rollup-darwin-${npm_arch} 4.62.2 \
                          lightningcss-darwin-${npm_arch} 1.32.0 \
                          @parcel/watcher-darwin-${npm_arch} 2.5.6]
set i 0
foreach {pkg ver} ${platform_pkgs} {
    master_sites-append https://registry.npmjs.org/${pkg}/-/:p${i}
    distfiles-append    [file tail ${pkg}]-${ver}.tgz:p${i}
    incr i
}
extract.only        ${distname}${extract.suffix} \
                    ${name}-${version}-vendor.tar.xz \
                    ${name}-${version}-node_modules.tar.xz

