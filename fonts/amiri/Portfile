PortSystem          1.0
PortGroup           github 1.0

github.setup        aliftype amiri 1.003
github.tarball_from releases
categories          fonts
license             OFL-1.1
platforms           any
supported_archs     noarch
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         High quality Arabic Naskh-style font.
long_description    Amiri is a classical Arabic typeface in Naskh style for typesetting books \
                    and other running text.
homepage            https://aliftype.com/amiri/

distname            Amiri-${version}
use_zip             yes

checksums           rmd160  2b943a3eec173c9abda3b16f2e7e097c71da19e7 \
                    sha256  81af0aff7d2086d8af24cea7202f7546130997982534691373485cd96744d05e \
                    size    1033533

use_configure       no
destroot.violate_mtree yes

build {}

destroot {
    xinstall -d -m 0755 ${destroot}/Library/Fonts
    foreach f [glob -directory ${worksrcpath} *.ttf] {
        xinstall -m 0644 ${f} ${destroot}/Library/Fonts/
    }
}
