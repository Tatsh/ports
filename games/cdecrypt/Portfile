description         Decrypt Wii U NUS content.
long_description    ${description}

checksums           rmd160  6bb615b898ca8ab8c0fe4febd8387f2c98f35d76 \
                    sha256  08ec85d81adcafb2e55fde18e5c095603a35b72b7ef781723de5ceb20d7ffbaf \
                    size    42811

use_configure       no

post-patch {
    reinplace -E {s/^LDFLAGS=-s$/LDFLAGS=/} ${worksrcpath}/Makefile
}

build.args          CC="${configure.cc} [get_canonical_archflags cc]"

destroot {
    xinstall -m 0755 ${worksrcpath}/cdecrypt ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}
