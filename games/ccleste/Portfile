# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           app 1.0
PortGroup           github 1.0

github.setup        lemon32767 ccleste 1.4.0 v
github.tarball_from archive
revision            1
categories          games
platforms           darwin linux freebsd
license             Restrictive
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Portable C port of Celeste Classic, originally a PICO-8 game.
long_description    ${description}

checksums           rmd160  66dff478c73845c3e3a2cb0b8d1e819a21b6f884 \
                    sha256  32dfd797f3c863201e0c19aa97974c56a8ed589a34c0522503f25f6e1399edd6 \
                    size    1537733

depends_build-append port:pkgconfig
depends_lib-append  port:libsdl2 \
                    port:libsdl2_mixer

# Read the game data and controller mappings from the installed location.
patchfiles          patch-data-dir.diff
patch.pre_args-replace -p0 -p1

use_configure       no

build {
    set sdl [exec ${prefix}/bin/pkg-config --cflags --libs sdl2 SDL2_mixer]
    system -W ${worksrcpath} "${configure.cc} [get_canonical_archflags cc] ${configure.cflags} \
        -Wall -DCCLESTE_DATA_DIR='\"${prefix}/share/${name}\"' ${configure.ldflags} \
        -o ccleste sdl12main.c celeste.c ${sdl} -lm"
}

# The gamepad mapping file is written next to the working directory unless CCLESTE_INPUT_CFG_PATH
# says otherwise, so a wrapper points it at the configuration directory.
destroot {
    xinstall -d ${destroot}${prefix}/libexec/${name} ${destroot}${prefix}/share/${name}
    xinstall -m 0755 ${worksrcpath}/ccleste ${destroot}${prefix}/libexec/${name}/
    foreach f [concat [glob ${worksrcpath}/data/*] ${worksrcpath}/gamecontrollerdb.txt] {
        xinstall -m 0644 ${f} ${destroot}${prefix}/share/${name}/
    }
    xinstall -m 0755 ${filespath}/ccleste.sh ${destroot}${prefix}/bin/ccleste
    reinplace "s|@PREFIX@|${prefix}|g" ${destroot}${prefix}/bin/ccleste
}

# A Finder-launchable app bundle for the game, which runs the installed program.
app.name            Celeste Classic
app.executable      ccleste
app.icon            icon.png
