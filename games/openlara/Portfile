PortSystem          1.0
PortGroup           app 1.0
PortGroup           github 1.0

github.setup        libretro OpenLara e4ce52edec5a9a6ad22b69d08c687bf070e68876
github.tarball_from archive
name                openlara
version             20260624
revision            1
categories          games
platforms           darwin linux freebsd
license             BSD
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Classic Tomb Raider open source engine.
long_description    ${description} Run it from a directory holding the Tomb Raider game data.
homepage            https://github.com/XProger/OpenLara
dist_subdir         ${name}/${version}

checksums           rmd160  a4b3ec773c9c02e11c269b3133aa49fdb3eab814 \
                    sha256  2b39531cfa844b00f904f31b4eb98adb15937049be486a2ebd32964b52b22f9b \
                    size    11819351

depends_lib-append  port:libsdl2

compiler.cxx_standard 2011
use_configure       no

# Upstream's desktop Linux build uses X11 and PulseAudio; its SDL2 platform with desktop OpenGL
# runs on macOS. This mirrors the SDL2/OpenGL line of src/platform/sdl2/build.sh.
build {
    set sdl [string map {"\n" " "} [exec ${prefix}/bin/sdl2-config --cflags --libs]]
    system -W ${worksrcpath}/src/platform/sdl2 "${configure.cxx} [get_canonical_archflags cxx] \
        ${configure.cxxflags} ${configure.cppflags} ${configure.ldflags} -std=c++11 -fno-exceptions \
        -fno-rtti -DNDEBUG -D__SDL2__ -D_SDL2_OPENGL main.cpp ../../libs/stb_vorbis/stb_vorbis.c \
        ../../libs/minimp3/minimp3.cpp ../../libs/tinf/tinflate.c -I../../ -o OpenLara ${sdl} \
        -framework OpenGL"
}

destroot {
    xinstall -m 0755 ${worksrcpath}/src/platform/sdl2/OpenLara ${destroot}${prefix}/bin/openlara
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}

livecheck.type      none

# A Finder-launchable app bundle for the game, which runs the installed program.
app.name            OpenLara
app.executable      openlara
app.icon            src/platform/osx/Assets.xcassets/AppIcon.appiconset/icon128x128.png
