# Report the release version, fetch title metadata from a working URL, and drop the Electron GUI
# for the console mode, with settings in the XDG directories.
patchfiles          patch-fix-version.diff \
                    patch-fix-versions-url.diff \
                    patch-no-gui-xdg.diff
patch.pre_args-replace -p0 -p1
# The GUI removal leaves gui.go empty rather than deleting it.
post-patch {
    delete ${worksrcpath}/gui.go
}

destroot {
    xinstall -m 0755 ${worksrcpath}/${name} ${destroot}${prefix}/bin/
}

test.run            yes
test.target         ./...
