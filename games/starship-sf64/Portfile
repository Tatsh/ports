                    https://raw.githubusercontent.com/mdqinc/SDL_GameControllerDB/${gcdb_rev}/:gcdb
distfiles-append    stb_image.h:stb gamecontrollerdb.txt:gcdb
extract.only        {*}[lmap f ${distfiles} {set f [lindex [split ${f} :] 0]; if {${f} in {stb_image.h gamecontrollerdb.txt}} continue; set f}]
dist_subdir         ${name}/${version}

