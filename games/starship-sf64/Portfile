foreach {key repo ref dir} ${deps} {
    master_sites-append https://github.com/${repo}/archive/${ref}.tar.gz?dummy=:${key}
    distfiles-append    ${dir}.tar.gz:${key}
}
# Single files: libultraship downloads stb_image.h at configure time, and wants the SDL controller
# database beside the executable.
set stb_rev         0bc88af4de5fb022db643c2d8e549a0927749354
set gcdb_rev        5a12daa568d19344f9b6e9286ef5929833b25c7c
