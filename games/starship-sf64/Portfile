post-extract {
    file delete -force ${worksrcpath}/libultraship ${worksrcpath}/tools/Torch
    move ${workpath}/libultraship-${lus_rev} ${worksrcpath}/libultraship
    move ${workpath}/Torch-${torch_rev} ${worksrcpath}/tools/Torch
}

# From tatsh-overlay: build Torch once as a host tool, use its CLI, and show dialogs through
# portable-file-dialogs (osascript on macOS).
patchfiles          patch-torch-single-build.diff \
                    patch-use-torch-cli.diff \
                    patch-dialogs-via-pfd.diff
patch.pre_args-replace -p0 -p1

post-patch {
    # libultraship downloads stb_image.h; copy the distfile instead.
    reinplace -E "s|file\\(DOWNLOAD \"https://github.com/nothings/stb/raw/\[^\"\]*\" |file(MAKE_DIRECTORY \"\${STB_DIR}\")\\nfile(COPY_FILE \"${distpath}/stb_image.h\" |" \
        ${worksrcpath}/libultraship/cmake/dependencies/common.cmake
    # FETCHCONTENT_SOURCE_DIR_* skips the patch step, so apply upstream's dependency patches.
    system -W ${workpath}/imgui-1.91.9b-docking \
        "patch -p1 < ${worksrcpath}/libultraship/cmake/dependencies/patches/imgui-fixes-and-config.patch"
    system -W ${workpath}/StormLib-9.25 \
        "patch -p1 < ${worksrcpath}/libultraship/cmake/dependencies/patches/stormlib-optimizations.patch"
}

compiler.cxx_standard 2020

# macOS's OpenGL, not Mesa's libGL from ${prefix}/lib, which needs X11 (the cmake portgroup makes
# FindOpenGL look at frameworks last).
configure.args-append \
                    -DOPENGL_gl_LIBRARY=${configure.sdkroot}/System/Library/Frameworks/OpenGL.framework \
                    -DOPENGL_opengl_LIBRARY=${configure.sdkroot}/System/Library/Frameworks/OpenGL.framework \
                    -DOPENGL_INCLUDE_DIR=${configure.sdkroot}/System/Library/Frameworks/OpenGL.framework \
                    -DBUILD_SHARED_LIBS=OFF \
                    -DBUILD_STORMLIB=OFF \
                    -DCMAKE_OSX_DEPLOYMENT_TARGET=${macosx_deployment_target} \
                    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
                    -DPython3_EXECUTABLE=${prefix}/bin/python3.13 \
                    -Dfmt_DIR=${prefix}/lib/libfmt12/cmake/fmt
foreach {key repo ref dir} ${deps} {
    set fc [dict get {dr_libs DR_LIBS imgui IMGUI prism PRISM threadpool THREADPOOL \
                      stormlib STORMLIB libgfxd LIBGFXD tinyxml2 TINYXML2 yaml-cpp YAML-CPP \
                      metalcpp METALCPP lus {} torch {}} ${key}]
    if {${fc} ne ""} {
        configure.args-append -DFETCHCONTENT_SOURCE_DIR_${fc}=${workpath}/${dir}
    }
}

# starship.o2r (the port's own assets) comes from a target that is not part of all.
post-build {
    system -W ${build.dir} "${build.cmd} GeneratePortO2R"
}

set libexec         ${prefix}/libexec/${name}

destroot {
    # libultraship finds the port's assets beside the executable and keeps its writable state in
    # SHIP_HOME (and the working directory); the wrapper sets both, as in tatsh-overlay.
    xinstall -d ${destroot}${libexec}/assets
    xinstall -m 0755 ${build.dir}/Starship ${destroot}${libexec}/
    xinstall -m 0644 ${build.dir}/starship.o2r ${worksrcpath}/config.yml ${destroot}${libexec}/
    xinstall -m 0644 ${distpath}/gamecontrollerdb.txt ${destroot}${libexec}/
    copy ${worksrcpath}/assets/yaml ${destroot}${libexec}/assets/
    set fd [open ${destroot}${prefix}/bin/Starship w]
    puts ${fd} "#!/bin/sh
SHIP_HOME=\"\${HOME}/Library/Application Support/Starship\"
export SHIP_HOME
mkdir -p \"\${SHIP_HOME}\" || exit 1
cd \"\${SHIP_HOME}\" || exit 1
# The asset extractor reads these from the working directory.
for f in config.yml assets; do
    \[ -e \"\${SHIP_HOME}/\${f}\" \] || ln -s \"${libexec}/\${f}\" \"\${SHIP_HOME}/\${f}\" || exit 1
done
exec \"${libexec}/Starship\" \"\$@\""
    close ${fd}
    file attributes ${destroot}${prefix}/bin/Starship -permissions 0755
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}

app.name            Starship
app.executable      Starship
app.icon            logo.png

notes "
Starship needs a US 1.0 or 1.1 Star Fox 64 ROM. Start it once and it asks for the ROM, then\
 writes sf64.o2r and its other files to ~/Library/Application Support/Starship.
"
