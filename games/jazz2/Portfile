# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           app 1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

github.setup        deathkiller jazz2-native 3.9.0
github.tarball_from archive
revision            1
name                jazz2
categories          games
platforms           darwin linux freebsd
license             GPL-3+
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Open-source reimplementation of Jazz Jackrabbit 2.
long_description    ${description} The data files from a copy of Jazz Jackrabbit 2 are \
                    required.
homepage            https://deat.tk/jazz2/

checksums           rmd160  c278cc70e3f765c99754411819378e9e6bfcd3b2 \
                    sha256  297d5e378bd52482c3a1e6538fea63c72120f6825a974c29389ff7650d76c996 \
                    size    20577046

depends_build-append port:pkgconfig
depends_lib-append  port:libopenmpt \
                    port:libpng \
                    port:libsdl2 \
                    port:libvorbis \
                    port:openal-soft \
                    port:webp \
                    port:zlib

# Link Apple's OpenGL framework rather than Mesa's libGL (a GLX implementation for X11).
configure.pre_args-replace -DCMAKE_FIND_FRAMEWORK=LAST -DCMAKE_FIND_FRAMEWORK=FIRST

compiler.cxx_standard 2017

# The Objective-C runtime calls (for moving files to the Trash) are linked through the prebuilt
# frameworks setup otherwise.
configure.ldflags-append -lobjc -framework Foundation
# AudioReaderMpt.h includes libopenmpt.h directly.
configure.cppflags-append -I${prefix}/include/libopenmpt

# On macOS upstream only supports its prebuilt frameworks bundle; use the MacPorts libraries
# through the regular find modules instead.
post-patch {
    reinplace {s/^\(\t*\)elseif(APPLE)$/\1elseif(FALSE)/} ${worksrcpath}/cmake/ncine_imported_targets.cmake
    reinplace {s/^\(\t*\)if(APPLE AND NOT IOS)$/\1if(FALSE)/} ${worksrcpath}/cmake/ncine_imported_targets.cmake
}

# Every dependency is either packaged or vendored; without this the build fetches sources over the
# network. A release archive has no git metadata.
configure.args-append \
                    -DNCINE_DOWNLOAD_DEPENDENCIES=OFF \
                    -DNCINE_VERSION_FROM_GIT=OFF \
                    -DNCINE_COPY_DEPENDENCIES=OFF \
                    -DNCINE_STRIP_BINARIES=OFF \
                    -DNCINE_LINUX_PACKAGE=${name} \
                    -DNCINE_OVERRIDE_CONTENT_PATH=${prefix}/share/${name}/Content/ \
                    -DNCINE_PREFERRED_BACKEND=SDL2 \
                    -DNCINE_WITH_ANGELSCRIPT=OFF \
                    -DNCINE_WITH_OPENMPT=ON \
                    -DNCINE_WITH_WEBP=ON

notes "
This is only the engine and its own assets. Run the game once and it will ask where the data\
files of Jazz Jackrabbit 2 are.
"

# On macOS the install rules assume upstream's app bundle with its prebuilt frameworks.
destroot {
    xinstall -m 0755 ${build.dir}/jazz2 ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/${name} ${destroot}${prefix}/share/doc/${name}
    copy ${worksrcpath}/Content ${destroot}${prefix}/share/${name}/
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}

# A Finder-launchable app bundle for the game, which runs the installed program.
app.name            Jazz² Resurrection
app.identifier      tk.deat.jazz2
app.executable      jazz2
app.icon            Sources/Icons/1024px.png
