PortSystem          1.0
PortGroup           github 1.0

github.setup        Wiimm wiimms-szs-tools 246fdb38d7c2fb3054b8f8528e11dc8f17691750
github.tarball_from archive
version             2.42a
revision            1
categories          games sysutils
platforms           darwin linux freebsd
license             GPL-2
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Command line tools to manipulate SZS, U8, BMG, KMP and other files of Nintendo titles.
long_description    Wiimms SZS Tools: wszst, wbmgt, wctct, wimgt, wkclt, wkmpt, wlect, wmdlt, \
                    wpatt and wstrt, mostly for Mario Kart Wii.
homepage            https://szs.wiimm.de/

checksums           rmd160  4ee12a03d34501d1f338e2ec84cf36a86df6c68c \
                    sha256  d3ed4e664e67b62c14dcc5bf1aaabe7da1dee892492f6e1b456d6145a2343d58 \
                    size    3125683

depends_lib-append  path:lib/libssl.dylib:openssl \
                    port:ncurses \
                    port:zlib

worksrcdir          ${distname}/project
use_configure       no

post-patch {
    # Look for the configuration in ~/Library/Application Support/szs instead of ~/.config/szs.
    reinplace {s|xdg = PathCatPP(buf,sizeof(buf),home,".config");|xdg = PathCatPP(buf,sizeof(buf),home,"Library/Application Support");|} \
        ${worksrcpath}/dclib/dclib-basics.c
    reinplace -E {s/@\$\(CC\)/$(CC)/g; s/-O3\b//g; s/^CC[[:space:]]+=(.*)/CC ?=\1/} \
        ${worksrcpath}/Makefile
}

build.target        tools
build.args          CC="${configure.cc} [get_canonical_archflags cc]" \
                    XFLAGS="${configure.cflags} ${configure.cppflags}" \
                    LDFLAGS="${configure.ldflags}" \
                    INSTALL_PATH=${prefix}

destroot {
    foreach t {wszst wbmgt wctct wimgt wkclt wkmpt wlect wmdlt wpatt wstrt} {
        xinstall -m 0755 ${worksrcpath}/${t} ${destroot}${prefix}/bin/
    }
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/../README.md ${destroot}${prefix}/share/doc/${name}/
}

livecheck.type      none
