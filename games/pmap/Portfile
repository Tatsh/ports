# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        ps2homebrew PMAP 1.3 v
github.tarball_from archive
name                pmap
categories          games sysutils
platforms           darwin linux freebsd
license             Restrictive
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         PlayStation 2 Mechacon Adjustment Program, for CD/DVD subsystem maintenance.
long_description    ${description} Installed as pmap-ps2.

checksums           rmd160  7508afafec71d00eeaedc71e07626894bdde588c \
                    sha256  3700c85aaca71bd0cef88791fd412aa727dda9a87c2e5acb57adce5f4bedc3ee \
                    size    78854

use_configure       no

# Upstream never passes LDFLAGS when linking.
post-patch {
    reinplace {s|$(CC) -o $(ELF)|$(CC) $(LDFLAGS) -o $(ELF)|} ${worksrcpath}/PMAP-unix/Makefile
}

build.dir           ${worksrcpath}/PMAP-unix
build.target
build.args          CC="${configure.cc} [get_canonical_archflags cc]" \
                    CFLAGS="${configure.cflags}" \
                    LDFLAGS="${configure.ldflags}"

destroot {
    xinstall -m 0755 ${build.dir}/pmap ${destroot}${prefix}/bin/pmap-ps2
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} README.txt Changelog.txt ${destroot}${prefix}/share/doc/${name}/
}
