PortSystem          1.0
PortGroup           app 1.0
PortGroup           cmake 1.1

name                revc
version             20210902
revision            2
set commit          a16fcd8d6a79e433c1c6e73d540f1bbe27e14164
set librw_commit    5501c4fdc7425ff926be59369a13593bb6c81b54
categories          games
platforms           darwin linux freebsd
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Grand Theft Auto: Vice City, decompiled and rebuilt.
long_description    ${description} The game files from a copy of Grand Theft Auto: Vice City are required.
homepage            https://web.archive.org/web/20210905122315/https://github.com/GTAmodding/re3

master_sites        https://web.archive.org/web/20210905122315/https://github.com/GTAmodding/re3/archive/:main \
                    https://github.com/aap/librw/archive/:librw
distfiles           ${commit}.zip:main \
                    ${librw_commit}.tar.gz:librw
dist_subdir         ${name}/${version}
extract.only        ${commit}.zip
use_zip             yes
worksrcdir          re3-${commit}

checksums           a16fcd8d6a79e433c1c6e73d540f1bbe27e14164.zip \
                    rmd160  397e3a69767284783c3c5892c94757824abd0d9c \
                    sha256  3d8136898521df78040509046f635b558ce67cd078e05e4754101006c0201b50 \
                    size    9430468 \
                    5501c4fdc7425ff926be59369a13593bb6c81b54.tar.gz \
                    rmd160  1f68886e20de0cbd063e50fdee28bf40af72f0a6 \
                    sha256  6d7fd1ffc8051d0ab670d4a07a6ae21abfbe2f7edbb2a6845c7b2b83977b40e2 \
                    size    2111111

depends_build-append bin:unzip:unzip
depends_lib-append  port:glew \
                    port:glfw \
                    port:libopus \
                    port:libsndfile \
                    port:mpg123 \
                    port:openal-soft \
                    port:opusfile

post-extract {
    system -W ${worksrcpath}/vendor "tar -xzf ${distpath}/${librw_commit}.tar.gz"
    file delete -force ${worksrcpath}/vendor/librw
    file rename ${worksrcpath}/vendor/librw-${librw_commit} ${worksrcpath}/vendor/librw
}

post-patch {
    foreach d {libsndfile mpg123 openal-soft} {
        file delete -force ${worksrcpath}/vendor/${d}
    }
}

# Link Apple's OpenGL framework rather than Mesa's libGL (a GLX implementation for X11).
configure.pre_args-replace -DCMAKE_FIND_FRAMEWORK=LAST -DCMAKE_FIND_FRAMEWORK=FIRST

compiler.cxx_standard 2011

configure.args-append \
                    -DLIBRW_PLATFORM=GL3 \
                    -DBUILD_SHARED_LIBS=OFF \
                    -DLIBRW_TOOLS=OFF \
                    -DREVC_WITH_LIBSNDFILE=ON \
                    -DREVC_WITH_OPUS=ON \
                    -DREVC_AUDIO=OAL \
                    -DREVC_VENDORED_LIBRW=ON \
                    -DREVC_INSTALL=ON \
                    -DCMAKE_INSTALL_PREFIX=${prefix}/share/${name}

post-destroot {
    ln -s ../share/${name}/reVC ${destroot}${prefix}/bin/revc
}

notes "
Copy the files of your Grand Theft Auto: Vice City installation into the directory you run revc from. The re3-installer port can extract them from the discs.
"

livecheck.type      none

# A Finder-launchable app bundle for the game, which runs the installed program.
app.name            reVC
app.executable      ${prefix}/share/${name}/reVC
