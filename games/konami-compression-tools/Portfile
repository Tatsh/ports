# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        vladikcomper konami-compression-tools 1.5.1 v
github.tarball_from archive
categories          games archivers
platforms           darwin linux freebsd
license             MIT
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Compress and decompress Konami Compression variant 1 (LZKN1) data.
long_description    ${description} Includes the lzkn command line tool and Motorola 68000 \
                    decompressor sources.

checksums           rmd160  ef4d7ac1a5b4e884f3cc6acc99975022b0732602 \
                    sha256  258da0211758fb712bd33c1eab311c60aa4b9326302d2ceb8c24431835ab47e5 \
                    size    11723

use_configure       no

# Upstream never passes LDFLAGS when linking.
post-patch {
    reinplace {s|$(CC) $(CFLAGS) $^ -o bin/|$(CC) $(CFLAGS) $(LDFLAGS) $^ -o bin/|} \
        ${worksrcpath}/Makefile
}

build.target        lzkn
build.args          CC="${configure.cc} [get_canonical_archflags cc]" \
                    CFLAGS="${configure.cflags} -std=c99 -Iinclude" \
                    LDFLAGS="${configure.ldflags}"

destroot {
    xinstall -m 0755 ${worksrcpath}/bin/lzkn ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}/m68k
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
    eval xinstall -m 0644 [glob ${worksrcpath}/m68k/*] ${destroot}${prefix}/share/doc/${name}/m68k/
}

test.run            yes
test.target         test
test.args           {*}${build.args}
