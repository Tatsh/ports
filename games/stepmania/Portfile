# Build against current FFmpeg.
patchfiles          patch-ffmpeg-6.diff \
                    patch-ffmpeg-7.diff \
                    patch-ffmpeg-8.diff \
                    patch-macos-system-ffmpeg.diff
patch.pre_args-replace -p0 -p1

# Link Apple's OpenGL framework rather than Mesa's libGL (a GLX implementation for X11).
configure.pre_args-replace -DCMAKE_FIND_FRAMEWORK=LAST -DCMAKE_FIND_FRAMEWORK=FIRST

configure.args-append \
                    -DWITH_FFMPEG=yes \
                    -DWITH_SYSTEM_FFMPEG=yes \
                    -DWITH_FULL_RELEASE=yes \
                    -DWITH_PORTABLE_TOMCRYPT=no \
                    -DWITH_SYSTEM_GLEW=yes \
                    -DWITH_SYSTEM_TOMCRYPT=yes \
                    -DWITH_SYSTEM_TOMMATH=yes \
                    -DWITH_SYSTEM_MAD=yes \
                    -DWITH_SYSTEM_ZLIB=yes \
                    -DWITH_SYSTEM_JSONCPP=no \
                    -DWITH_SYSTEM_PNG=no \
                    -DWITH_SYSTEM_JPEG=yes \
                    -DWITH_SYSTEM_PCRE=yes \
                    -DWITH_SYSTEM_OGG=yes \
                    -DWITH_CRASH_HANDLER=no

# The macOS build makes StepMania.app in the source tree and has no install rules. StepMania reads
# its game data from the directory that contains the app bundle.
destroot {
    set dest "${destroot}${applications_dir}/StepMania 5.1"
    xinstall -d ${dest}
    copy ${worksrcpath}/StepMania.app ${dest}
    foreach d {Announcers BGAnimations BackgroundEffects BackgroundTransitions Characters \
            Courses Data NoteSkins Scripts Songs Themes} {
        copy ${worksrcpath}/${d} ${dest}
    }
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    copy {*}[glob ${worksrcpath}/Docs/*] ${destroot}${prefix}/share/doc/${name}
}
