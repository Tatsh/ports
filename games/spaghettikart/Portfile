post-extract {
    file delete -force ${worksrcpath}/libultraship ${worksrcpath}/torch
    file rename ${workpath}/libultraship-f40cfd33b8bc6237d635d4ed82838a7e3f785386 ${worksrcpath}/libultraship
    file rename ${workpath}/Torch-2d474ddb8da8b213fbdbb49d0273ce31fa955f35 ${worksrcpath}/torch
}

# Build Torch as part of this build and run it as a command, and use portable file dialogs.
patchfiles          patch-torch-single-build.diff \
                    patch-use-torch-cli.diff \
                    patch-dialogs-via-pfd.diff

# The build downloads stb_image.h and semver.hpp with file(DOWNLOAD); copy the distfiles instead.
# FETCHCONTENT_SOURCE_DIR_* skips the patch step, so apply upstream's ImGui patch here.
post-patch {
    foreach {file url local var} [list \
            ${worksrcpath}/libultraship/cmake/dependencies/common.cmake \
            https://github.com/nothings/stb/raw/ stb_image.h STB_DIR \
            ${worksrcpath}/CMakeLists.txt \
            https://raw.githubusercontent.com/Neargye/semver/ semver.hpp SEMVER_DIR] {
        set fd [open ${file} r]
        set text [read ${fd}]
        close ${fd}
        set pattern "file\\(DOWNLOAD \"[string map [list . {\.}] ${url}]\[^\"\]*\" "
        set replacement "file(MAKE_DIRECTORY \"\$\{${var}\}\")\nfile(COPY_FILE \"${distpath}/${local}\" "
        if {[regsub ${pattern} ${text} ${replacement} text] != 1} {
            return -code error "could not redirect the ${local} download in ${file}"
        }
        set fd [open ${file} w]
        puts -nonewline ${fd} ${text}
        close ${fd}
    }
    system -W ${workpath}/imgui-1.91.9b-docking "patch -p1 < ${worksrcpath}/libultraship/cmake/dependencies/patches/imgui-fixes-and-config.patch"
}

# Link Apple's OpenGL framework rather than Mesa's libGL (a GLX implementation for X11).
configure.pre_args-replace -DCMAKE_FIND_FRAMEWORK=LAST -DCMAKE_FIND_FRAMEWORK=FIRST

compiler.cxx_standard 2020
# Brace initializers narrow out-of-range constants into s16, which GCC only warns about.
configure.cxxflags-append -Wno-c++11-narrowing

configure.args-append \
                    -DBUILD_SHARED_LIBS=OFF \
                    -Dfmt_DIR=${prefix}/lib/libfmt12/cmake/fmt \
                    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
                    -DFETCHCONTENT_SOURCE_DIR_DR_LIBS=${workpath}/dr_libs-da35f9d6c7374a95353fd1df1d394d44ab66cf01 \
                    -DFETCHCONTENT_SOURCE_DIR_METALCPP=${workpath}/single-header-metal-cpp-macOS13_iOS16 \
                    -DFETCHCONTENT_SOURCE_DIR_IMGUI=${workpath}/imgui-1.91.9b-docking \
                    -DFETCHCONTENT_SOURCE_DIR_LIBGFXD=${workpath}/libgfxd-96fd3b849f38b3a7c7b7f3ff03c5921d328e6cdf \
                    -DFETCHCONTENT_SOURCE_DIR_PRISM=${workpath}/prism-processor-bbcbc7e3f890a5806b579361e7aa0336acd547e7 \
                    -DFETCHCONTENT_SOURCE_DIR_THREADPOOL=${workpath}/thread-pool-4.1.0 \
                    -DFETCHCONTENT_SOURCE_DIR_TINYXML2=${workpath}/tinyxml2-10.0.0 \
