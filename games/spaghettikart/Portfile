# spaghetti.o2r holds the port's own assets; it is built by a target that is not part of all.
post-build {
    system -W ${build.dir} "${build.cmd} GenerateO2R"
}

# libultraship looks for its assets and the controller database beside the executable and writes
# everything else relative to the working directory, so a wrapper picks the writable directory.
destroot {
    set dest ${destroot}${prefix}/libexec/${name}
    xinstall -d ${dest}
    foreach f [glob -nocomplain -directory ${build.dir} Spaghettify Spaghettify.app] {
        copy ${f} ${dest}/
    }
    xinstall -m 0644 ${build.dir}/spaghetti.o2r ${distpath}/gamecontrollerdb.txt ${worksrcpath}/config.yml ${dest}/
    copy ${worksrcpath}/meta ${worksrcpath}/yamls ${dest}/
    xinstall -m 0755 ${filespath}/spaghettikart.sh ${destroot}${prefix}/bin/spaghettikart
    reinplace "s|@PREFIX@|${prefix}|g" ${destroot}${prefix}/bin/spaghettikart
}

notes "
Run spaghettikart once and it will ask for a US Mario Kart 64 ROM, then write the extracted assets\
 and saves to ~/Library/Application Support/spaghettikart.
"

livecheck.type      none

# A Finder-launchable app bundle, which runs the installed program.
app.name            SpaghettiKart
app.executable      spaghettikart
app.icon            icon.png
