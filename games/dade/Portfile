PortSystem          1.0
PortGroup           github 1.0
PortGroup           python 1.0

github.setup        Tatsh dade 0.3.0 v
github.tarball_from archive
revision            0
platforms           darwin linux freebsd
license             MIT
supported_archs     noarch
categories          games python
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Extract and convert assets from a collection of PC and console video games.
long_description    ${description}
homepage            https://tatsh.github.io/dade/

checksums           rmd160  c0ab66b20ee3e9585e91c8802d81f3649858a0a4 \
                    sha256  f5a1c3c305d77d8e230f30fb85873093d58cb9cfd4790ac9a9c508ada6d25a57 \
                    size    3128503

# The PyPI sdist lacks the password cracker's OpenCL kernel (kernel.cl): ".gitignore" ignores
# *.cl, so hatch leaves it out of both the sdist and the wheel. Build from the tag instead, with
# that pattern removed.
post-patch {
    reinplace {/^\*\.cl$/d} ${worksrcpath}/.gitignore
}

python.default_version  313
python.pep517_backend   hatch

depends_run-append \
    port:py${python.version}-anyio \
    port:py${python.version}-bascom \
    port:py${python.version}-click \
    port:py${python.version}-cryptography \
    port:py${python.version}-jinja2 \
    port:py${python.version}-mido \
    port:py${python.version}-numpy \
    port:py${python.version}-pylzham \
    port:py${python.version}-Pillow \
    port:py${python.version}-rich \
    port:py${python.version}-texture2ddecoder \
    port:py${python.version}-typing_extensions \
    port:py${python.version}-zstd

post-destroot {
    xinstall -m 0444 ${worksrcpath}/man/dade.1 ${destroot}${prefix}/share/man/man1
}

test.run            yes
# Rich wraps output at the terminal width, which splits the long build paths tests look for.
test.env-append     COLUMNS=1000
# MacPorts clears addopts, which carries --import-mode=importlib for the relative test imports.
# The device listing and auto-backend tests need CuPy (CUDA).
test.args-append    -p no:cacheprovider --import-mode=importlib \
                    -k {'not test_crack_main_list_devices and not test_crack_auto_backend_falls_back_to_cpu'}
depends_test-append \
    port:py${python.version}-mock \
    port:py${python.version}-pytest-asyncio \
    port:py${python.version}-pytest-mock
