compiler.cxx_standard 2017
use_configure       no

post-extract {
    foreach dep {libfmt liblz4 libmbedtls libpietendo libtoolchain} {
        file delete -force ${worksrcpath}/deps/${dep}
        file rename ${workpath}/${dep}-[set ${dep}_commit] ${worksrcpath}/deps/${dep}
    }
}

# Show the compiler commands, which upstream hides.
post-patch {
    fs-traverse f [list ${worksrcpath}] {
        if {[file tail ${f}] eq "makefile"} {
            reinplace -q -E {s/@\$\((CXX|CC)\)/$(\1)/g} ${f}
        }
    }
}

build.env-append    CC=${configure.cc} CXX=${configure.cxx}
build.target        program
pre-build {
    system -W ${worksrcpath} "env CC=${configure.cc} CXX=${configure.cxx} ${build.cmd} deps"
}

destroot {
    xinstall -m 0755 ${worksrcpath}/bin/nstool ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
}
