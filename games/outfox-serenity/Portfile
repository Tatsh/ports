# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                outfox-serenity
version             3.0.3
set tag             [join [lrange [split ${version} .] 0 1] .]s[lindex [split ${version} .] 2]
categories          games
license             Restrictive/Distributable
platforms           any
supported_archs     noarch
maintainers         {gmail.com:audvare @Tatsh} openmaintainer
description         Community song pack for Project OutFox (all volumes, including 1.5).
long_description    OutFox Serenity is the community-made song pack for Project OutFox. This \
                    installs every volume into the Songs folder of the outfox port.
homepage            https://github.com/TeamRizu/OutFox-Serenity
master_sites        ${homepage}/releases/download/v${tag}/
distfiles           OutFox.Serenity.All.In.One.v${tag}.TP.zip
use_zip             yes
extract.mkdir       yes

checksums           rmd160  e0ae70e25d535c811851ba5d7b1c2b4650975b97 \
                    sha256  36739c719df001ca6eeef505cd30fb0e49ee12ad656c65b6f921d9df576312a4 \
                    size    614231344

depends_run-append  port:outfox

use_configure       no
build {}

destroot {
    set songs ${destroot}${applications_dir}/OutFox/Songs
    xinstall -d ${songs}
    foreach d [glob -directory ${worksrcpath} OutFox*] {
        copy ${d} ${songs}/
    }
}

livecheck.type      regex
livecheck.url       https://api.github.com/repos/TeamRizu/OutFox-Serenity/releases
livecheck.regex     {"tag_name": *"v([0-9]+\.[0-9]+s[0-9]+)"}
livecheck.version   ${tag}
