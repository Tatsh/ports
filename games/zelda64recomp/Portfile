set i 0
foreach {path repo rev} ${submodules} {
    incr i
    master_sites-append https://github.com/${repo}/archive/${rev}.tar.gz?dummy=:s${i}
    distfiles-append    [file tail ${repo}]-${rev}.tar.gz:s${i}
}

# The recompiler translates the game's code from the ROM.
fetch_restrict.files {mm.us.rev1.z64 sha1 d6133ace5afaa0882cf214cf88daba39e266c078}
fetch_restrict.instructions {
    Zelda 64: Recompiled translates the game's code while it builds, so it needs your own
    unmodified ROM of The Legend of Zelda: Majora's Mask for the N64, NTSC-U (US) version, in
    big-endian .z64 format. Copy it into the directory below as mm.us.rev1.z64.
}

set python_branch   3.13
set python_ver      [string map {. {}} ${python_branch}]

depends_build-append \
                    port:clang-18 \
                    port:directx-shader-compiler \
                    port:pkgconfig \
                    port:py${python_ver}-libyaz0 \
                    port:py${python_ver}-macholib \
                    port:python${python_ver} \
                    port:vulkan-headers \
                    port:vulkan-memory-allocator
depends_lib-append  port:freetype \
                    port:libsdl2 \
                    port:vulkan-loader \
                    port:zstd
depends_run-append  port:MoltenVK

post-extract {
    foreach {path repo rev} ${submodules} {
        file delete -force ${worksrcpath}/${path}
        file rename ${workpath}/[file tail ${repo}]-${rev} ${worksrcpath}/${path}
    }
    # fixbaserom.py insists on this name.
    file copy [fetch_restrict::path mm.us.rev1.z64] ${worksrcpath}/baserom.mm.us.rev1.z64
}

# Build against MacPorts DXC, Vulkan headers and zstd instead of the bundled copies, do not copy
# MacPorts libraries into the bundle, keep RT64's files in ~/Library/Application Support/rt64
# instead of ~/.config/.rt64 or ~/.rt64, and include <sstream> where it is used.
patchfiles          patch-macports.diff

post-patch {
    # Load the MacPorts Vulkan loader, which finds the MacPorts MoltenVK.
    reinplace -E "s@\"(/usr/local/lib/)?libvulkan\\.dylib\"@\"${prefix}/lib/libvulkan.1.dylib\"@" \
        ${worksrcpath}/lib/rt64/src/contrib/volk/volk.c
    reinplace "s|\"libMoltenVK.dylib\"|\"${prefix}/lib/libMoltenVK.dylib\"|" \
        ${worksrcpath}/lib/rt64/src/contrib/volk/volk.c
    # The bundle's version.
    reinplace "s|\"1.0\"|\"${version}\"|" \
        ${worksrcpath}/.github/macos/apple_bundle.cmake
    # The linker wrapper that keeps the executable's code writable for mods needs macholib.
    reinplace "1s|.*|#!${prefix}/bin/python${python_branch}|" ${worksrcpath}/.github/macos/ld64
}

# The recompiler has to run before CMake: CMakeLists.txt globs its output into RecompiledFuncs.
pre-configure {
    set rbuild ${workpath}/n64recomp-build
    system -W ${worksrcpath} "${prefix}/bin/cmake -G Ninja -S lib/N64ModernRuntime/N64Recomp\
        -B ${rbuild} -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=${configure.cc}\
        -DCMAKE_CXX_COMPILER=${configure.cxx} -DCMAKE_MAKE_PROGRAM=${prefix}/bin/ninja"
    system -W ${worksrcpath} "${prefix}/bin/ninja -C ${rbuild} N64Recomp RSPRecomp"
    # The build runs ./N64Recomp itself again for the patches.
    file copy ${rbuild}/N64Recomp ${rbuild}/RSPRecomp ${worksrcpath}/

    # Decompress the ROM with the decompilation's tool.
    system -W ${worksrcpath} \
        "${prefix}/bin/python${python_branch} lib/mm-decomp/tools/fixbaserom.py"
    file rename ${worksrcpath}/baserom_uncompressed.z64 \
        ${worksrcpath}/mm.us.rev1.rom_uncompressed.z64
    file delete ${worksrcpath}/baserom.mm.us.rev1.z64

    system -W ${worksrcpath} "./N64Recomp us.rev1.toml"
    system -W ${worksrcpath} "./RSPRecomp aspMain.us.rev1.toml"
    system -W ${worksrcpath} "./RSPRecomp njpgdspMain.us.rev1.toml"
}

# RT64 compiles its Metal shaders with xcrun metal, which comes with Xcode, not the Command Line
# Tools.
use_xcode           yes

cmake.generator     Ninja
cmake.build_type    Release
configure.args-append \
                    -Wno-dev \
                    -DDXC_EXECUTABLE=${prefix}/bin/dxc \
                    -DPATCHES_C_COMPILER=${prefix}/bin/clang-mp-18 \
                    -DPATCHES_LD=${prefix}/bin/ld.lld-mp-18

build.target        Zelda64Recompiled

set app             Zelda64Recompiled.app

destroot {
    copy ${build.dir}/${app} ${destroot}${applications_dir}/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/COPYING \
        ${destroot}${prefix}/share/doc/${name}/
}

notes "
Open ${applications_dir}/${app} and select your Majora's Mask ROM (the same NTSC-U ROM) when it\
 asks. Settings, saves and mods are kept in ~/Library/Application Support/Zelda64Recompiled.
"

livecheck.type      none
