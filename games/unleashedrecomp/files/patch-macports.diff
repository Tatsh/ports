-        std::for_each(std::execution::par_unseq, shaders.begin(), shaders.end(), [&](auto& hashShaderPair)
+        // libc++ only has the parallel algorithms with -fexperimental-library from LLVM 17, so on
+        // older ones the shaders are shared out between threads by hand.
+        auto recompileShader = [&](auto& hashShaderPair)
             {
                 auto& shader = hashShaderPair.second;
 
@@ -144,7 +146,31 @@ int main(int argc, char** argv)
                 size_t currentProgress = ++progress;
                 if ((currentProgress % 10) == 0 || (currentProgress == shaders.size() - 1))
                     fmt::println("Recompiling shaders... {}%", currentProgress / float(shaders.size()) * 100.0f);
-            });
+            };
+
+#if defined(__cpp_lib_execution) && __cpp_lib_execution >= 201603L
+        std::for_each(std::execution::par_unseq, shaders.begin(), shaders.end(), recompileShader);
+#else
+        {
+            std::vector<decltype(&*shaders.begin())> pending;
+            pending.reserve(shaders.size());
+            for (auto& hashShaderPair : shaders)
+                pending.push_back(&hashShaderPair);
+
+            std::atomic<size_t> next = 0;
+            std::vector<std::thread> workers(std::max(1u, std::thread::hardware_concurrency()));
+            for (auto& worker : workers)
+            {
+                worker = std::thread([&]()
+                    {
+                        for (size_t i; (i = next++) < pending.size();)
+                            recompileShader(*pending[i]);
+                    });
+            }
+            for (auto& worker : workers)
+                worker.join();
+        }
+#endif
 
         fmt::println("Creating shader cache...");
 
