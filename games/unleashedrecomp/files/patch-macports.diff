diff --git thirdparty/CMakeLists.txt thirdparty/CMakeLists.txt
index d5c0858..6876fdd 100644
--- thirdparty/CMakeLists.txt
+++ thirdparty/CMakeLists.txt
@@ -1,5 +1,37 @@
 cmake_policy(SET CMP0077 NEW)
 
+# Libraries from the system instead of vcpkg and the bundled submodules. Defining their targets
+# here also keeps XenonRecomp and XenosRecomp from building their own copies.
+set(CMAKE_FIND_PACKAGE_TARGETS_GLOBAL ON)
+find_package(PkgConfig REQUIRED)
+
+find_package(fmt REQUIRED)
+find_package(nfd REQUIRED)
+find_package(SDL2 REQUIRED)
+find_package(SDL2_mixer REQUIRED)
+
+pkg_check_modules(XXHASH REQUIRED IMPORTED_TARGET GLOBAL libxxhash)
+add_library(xxHash::xxhash ALIAS PkgConfig::XXHASH)
+pkg_check_modules(ZSTD REQUIRED IMPORTED_TARGET GLOBAL libzstd)
+add_library(libzstd INTERFACE)
+target_link_libraries(libzstd INTERFACE PkgConfig::ZSTD)
+add_library(libzstd_static ALIAS libzstd)
+
+if(NOT TARGET SDL2_mixer)
+    add_library(SDL2_mixer INTERFACE)
+    target_link_libraries(SDL2_mixer INTERFACE SDL2_mixer::SDL2_mixer)
+endif()
+
+find_program(DIRECTX_DXC_TOOL dxc REQUIRED)
+find_library(DIRECTX_DXCOMPILER_LIBRARY dxcompiler REQUIRED)
+find_path(DIRECTX_DXC_INCLUDE_DIR dxcapi.h PATH_SUFFIXES dxc REQUIRED)
+add_library(Microsoft::DirectXShaderCompiler UNKNOWN IMPORTED GLOBAL)
+set_target_properties(Microsoft::DirectXShaderCompiler PROPERTIES
+    IMPORTED_LOCATION "${DIRECTX_DXCOMPILER_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${DIRECTX_DXC_INCLUDE_DIR}")
+
+set(MSDF_ATLAS_USE_VCPKG OFF)
+set(MSDFGEN_USE_VCPKG OFF)
 set(MSDF_ATLAS_BUILD_STANDALONE OFF)
 set(MSDF_ATLAS_USE_SKIA OFF)
 set(MSDF_ATLAS_NO_ARTERY_FONT ON)
@@ -24,12 +56,13 @@ if (WIN32)
 endif()
 
 add_subdirectory("${UNLEASHED_RECOMP_THIRDPARTY_ROOT}/msdf-atlas-gen")
-add_subdirectory("${UNLEASHED_RECOMP_THIRDPARTY_ROOT}/nativefiledialog-extended")
 add_subdirectory("${UNLEASHED_RECOMP_THIRDPARTY_ROOT}/o1heap")
-add_subdirectory("${UNLEASHED_RECOMP_THIRDPARTY_ROOT}/SDL")
-add_subdirectory("${UNLEASHED_RECOMP_THIRDPARTY_ROOT}/SDL_mixer")
 add_subdirectory("${UNLEASHED_RECOMP_THIRDPARTY_ROOT}/plume")
+# plume's own copies of the Vulkan headers and VulkanMemoryAllocator are not bundled.
+find_package(VulkanHeaders REQUIRED)
+find_package(VulkanMemoryAllocator REQUIRED)
+target_link_libraries(plume PUBLIC Vulkan::Headers GPUOpen::VulkanMemoryAllocator)
+# The bundled static SDL brought these in; the system one is a shared library.
+target_link_libraries(plume PUBLIC "-framework AppKit" "-framework CoreFoundation"
+    "-framework Foundation" "-framework IOKit" "-framework Metal" "-framework QuartzCore")
 
-if (APPLE)
-    add_subdirectory("${UNLEASHED_RECOMP_THIRDPARTY_ROOT}/MoltenVK")
-endif()
