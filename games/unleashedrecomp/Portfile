set i 0
foreach {path repo rev} ${submodules} {
    incr i
    master_sites-append https://github.com/${repo}/archive/${rev}.tar.gz?dummy=:s${i}
    distfiles-append    [file tail ${repo}]-${rev}.tar.gz:s${i}
}

# The game files the recompilers translate.
fetch_restrict.files \
    {unleashedrecomp-default.xex sha256 1172fbbce7e145b3dc850c1403f57739febd2fb886dfc16f6da291c49a2cd6e1} \
    {unleashedrecomp-default.xexp sha256 b12bb7d08e77b75f0758f7b053224b71de9903592671214fe4dd222097911a16} \
    {unleashedrecomp-shader.ar sha256 e5eff2b0efabd6c4aff6c563329232810271526e4fd0abf2de2f7730db8b63e5}
fetch_restrict.instructions {
    Unleashed Recompiled translates the game's own code and shaders while it builds, so it needs
    three files from your copy of Sonic Unleashed for Xbox 360: the US retail disc and title
    update 2 (released only in Europe, but it applies to the US game too). Copy them into the
    directory below as:

      unleashedrecomp-default.xex    default.xex from the root of the US disc image
      unleashedrecomp-shader.ar      shader.ar from the root of the US disc image
      unleashedrecomp-default.xexp   default.xexp from the title update, a file named TU_19KA20I*
                                     (an STFS package) in /Content/Cache/ on an Xbox 360

    extract-xiso -x extracts the disc image. Upstream documents dumping the files in
    docs/DUMPING-en.md.
}

depends_build-append \
                    port:directx-shader-compiler \
                    port:magic_enum \
                    port:nlohmann-json \
                    port:pkgconfig \
                    port:stb \
                    port:vulkan-headers \
                    port:vulkan-memory-allocator
depends_lib-append  path:lib/libcurl.dylib:curl \
                    port:freetype \
                    port:libfmt11 \
                    port:libsdl2 \
                    port:libsdl2_mixer \
                    port:nativefiledialog-extended \
                    port:vulkan-loader \
                    port:xxhash \
                    port:zstd
depends_run-append  port:MoltenVK

post-extract {
    foreach {path repo rev} ${submodules} {
        file delete -force ${worksrcpath}/${path}
        file rename ${workpath}/[file tail ${repo}]-${rev} ${worksrcpath}/${path}
    }
    foreach f {default.xex default.xexp shader.ar} {
        file copy [fetch_restrict::path unleashedrecomp-${f}] ${worksrcpath}/UnleashedRecompLib/private/${f}
    }
}

# Build against MacPorts libraries instead of vcpkg and the bundled SDL, SDL_mixer, MoltenVK and
# friends, and recompile the shaders on older libc++, which has no parallel algorithms.
patchfiles          patch-macports.diff
patch.pre_args-replace -p0 -p1

post-patch {
    # Load the MacPorts Vulkan loader, which finds the MacPorts MoltenVK.
    reinplace "s|\"/usr/local/lib/libvulkan.dylib\"|\"${prefix}/lib/libvulkan.1.dylib\"|" \
        ${worksrcpath}/thirdparty/plume/contrib/volk/volk.c
}

# Parenthesised aggregate initialisation needs Clang 16. Its libc++ headers match the system
# library, and files/libcxx-polyfill.h supplies the C++20 pieces they lack.
compiler.whitelist  macports-clang-16
configure.cxxflags-append -D_LIBCPP_DISABLE_AVAILABILITY
configure.objcxxflags-append -D_LIBCPP_DISABLE_AVAILABILITY

cmake.generator     Ninja
configure.args-append \
                    -Wno-dev \
                    -Dfmt_DIR=${prefix}/lib/libfmt11/cmake/fmt \
                    -DUNLEASHED_RECOMP_SYSTEM_INCLUDE_DIR=${prefix}/include \
                    -DUNLEASHED_RECOMP_PRECOMPILED_PREFIX=${filespath}/libcxx-polyfill.h \
                    -DDIRECTX_DXC_TOOL=${prefix}/bin/dxc \
                    -DDIRECTX_DXCOMPILER_LIBRARY=${prefix}/libexec/directx-shader-compiler/lib/libdxcompiler.dylib \
                    -DDIRECTX_DXC_INCLUDE_DIR=${prefix}/libexec/directx-shader-compiler/include/dxc

build.target        UnleashedRecomp

set app             {Unleashed Recompiled.app}

destroot {
    copy "${build.dir}/UnleashedRecomp/${app}" ${destroot}${applications_dir}/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/COPYING ${destroot}${prefix}/share/doc/${name}/
}

notes "
Open ${applications_dir}/${app} and point its installer at your copy of Sonic Unleashed\
 (the disc image or its files, and the title update). The game is installed to\
 ~/Library/Application Support/UnleashedRecomp, with the settings.
"

livecheck.type      none
