depends_build-append path:bin/python3:python313
depends_lib-append  port:iniparser \
                    port:libwebsockets \
                    port:SDL3

post-extract {
    file delete -force ${worksrcpath}/3rdparty/libsmacker ${worksrcpath}/3rdparty/miniaudio
    file rename ${workpath}/libsmacker-${libsmacker_commit} ${worksrcpath}/3rdparty/libsmacker
    file rename ${workpath}/miniaudio-${miniaudio_commit} ${worksrcpath}/3rdparty/miniaudio
}

# Build libweaver from the SIEdit sources instead of fetching it.
patchfiles          patch-vendor-libweaver.diff
post-patch {
    reinplace "s|@LIBWEAVER_SOURCE_DIR@|${workpath}/SIEdit-${siedit_commit}|" \
        ${worksrcpath}/3rdparty/CMakeLists.txt
}

# Link Apple's OpenGL framework rather than Mesa's libGL (a GLX implementation for X11).
configure.pre_args-replace -DCMAKE_FIND_FRAMEWORK=LAST -DCMAKE_FIND_FRAMEWORK=FIRST

compiler.cxx_standard 2017

# Resolve SDL3, iniparser and libwebsockets from MacPorts instead of fetching them.
configure.args-append \
                    -DDOWNLOAD_DEPENDENCIES=OFF \
                    -DISLE_BUILD_ASSETS=OFF

# The install rules run BundleUtilities, which cannot resolve the shared game library. Install the
# library once and point both apps at it.
destroot {
    set libdir ${prefix}/libexec/${name}
    xinstall -d ${destroot}${libdir}
    xinstall -m 0755 ${build.dir}/liblego1.dylib ${destroot}${libdir}/
    system "install_name_tool -id ${libdir}/liblego1.dylib ${destroot}${libdir}/liblego1.dylib"
    foreach app {isle isle-config} {
        copy ${build.dir}/${app}.app ${destroot}${applications_dir}/
        system "install_name_tool -change @rpath/liblego1.dylib ${libdir}/liblego1.dylib \
            ${destroot}${applications_dir}/${app}.app/Contents/MacOS/${app}"
        # Upstream ships AppIcon.icns but leaves CFBundleIconFile empty, so Finder shows no icon.
        set plist ${destroot}${applications_dir}/${app}.app/Contents/Info.plist
        if {[file exists ${destroot}${applications_dir}/${app}.app/Contents/Resources/AppIcon.icns]} {
            system "/usr/libexec/PlistBuddy -c 'Set :CFBundleIconFile AppIcon' [shellescape ${plist}]"
        }
    }
}

notes "
LEGO Island needs the data files from an original LEGO Island install. Run isle-config to point it
at them.
"
